{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botnexus.dev/schemas/ui-evidence-1.0.json",
  "title": "BotNexus portal UI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "scenario", "viewport", "screenshot", "assertions", "accessibility", "timestamps", "cleanup"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/gitObject" }, "tree": { "$ref": "#/$defs/sourceTree" } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["name", "promptKey"], "properties": { "name": { "type": "string" }, "promptKey": { "const": "SLOW_STREAM" } } },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 320 } } },
    "screenshot": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "pattern": "^[A-Za-z0-9._-]+\\.png$" }, "sha256": { "pattern": "^[0-9a-f]{64}$" } } },
    "assertions": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "target", "passed", "detail"], "properties": { "kind": { "type": "string" }, "target": { "type": "string" }, "passed": { "const": true }, "detail": { "type": "string" } } } },
    "accessibility": { "type": "object", "additionalProperties": false, "required": ["activeRunControls"], "properties": { "activeRunControls": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "required": ["chat-steer-btn", "chat-redirect-btn", "chat-followup-btn", "chat-abort-btn"] } } },
    "timestamps": { "type": "object", "additionalProperties": false, "required": ["startedUtc", "capturedUtc", "completedUtc"], "properties": { "startedUtc": { "$ref": "#/$defs/timestamp" }, "capturedUtc": { "$ref": "#/$defs/timestamp" }, "completedUtc": { "$ref": "#/$defs/timestamp" } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["gatewayStopped", "browserClosed", "temporaryDataRemoved", "containerRemoved"], "properties": { "gatewayStopped": { "const": true }, "browserClosed": { "const": true }, "temporaryDataRemoved": { "const": true }, "containerRemoved": { "const": true } } }
  },
  "$defs": { "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "sourceTree": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "timestamp": { "type": "string", "format": "date-time" } }
}
