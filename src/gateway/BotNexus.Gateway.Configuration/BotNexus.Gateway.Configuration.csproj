<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BotNexus.Gateway.Configuration</RootNamespace>
    <Description>Configuration ownership - loading, typed access, canonical dotted-path resolution, merging, validation and secret handling for the BotNexus Gateway (#2765).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    The feature-flag inventory is GENERATED from feature-flags.json at the repository root (#2769),
    not hand-written here. Three things have to line up for that to work, and all three are below:
    the generator must be referenced as an Analyzer (not as an assembly), the JSON must be visible
    to it as an AdditionalFile, and the MSBuild properties it reads must be marked
    CompilerVisibleProperty - a property the compiler cannot see silently falls back to the
    generator's defaults, which looks like the setting being ignored.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\tools\BotNexus.SourceGenerators\BotNexus.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\..\..\feature-flags.json" />
  </ItemGroup>

  <PropertyGroup>
    <FeatureFlagSourceGenerator_Namespace>BotNexus.Gateway.Configuration</FeatureFlagSourceGenerator_Namespace>
    <FeatureFlagSourceGenerator_ClassName>FeatureFlags</FeatureFlagSourceGenerator_ClassName>
    <FeatureFlagSourceGenerator_AgeWarning>90</FeatureFlagSourceGenerator_AgeWarning>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="FeatureFlagSourceGenerator_Namespace" />
    <CompilerVisibleProperty Include="FeatureFlagSourceGenerator_ClassName" />
    <CompilerVisibleProperty Include="FeatureFlagSourceGenerator_AgeWarning" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\persistence\BotNexus.Persistence.Sqlite\BotNexus.Persistence.Sqlite.csproj" /><ProjectReference Include="..\..\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
    <ProjectReference Include="..\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\BotNexus.Gateway.Telemetry.Abstractions\BotNexus.Gateway.Telemetry.Abstractions.csproj" />
    <ProjectReference Include="..\..\agent\BotNexus.Agent.Providers.Core\BotNexus.Agent.Providers.Core.csproj" />
    <ProjectReference Include="..\..\agent\BotNexus.Agent.Providers.Copilot\BotNexus.Agent.Providers.Copilot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FeatureManagement" /><PackageReference Include="NJsonSchema" />
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BotNexus.Gateway" />
    <InternalsVisibleTo Include="BotNexus.Gateway.Tests" />
    <InternalsVisibleTo Include="BotNexus.Gateway.Configuration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates\*.md" />
  </ItemGroup>

</Project>
