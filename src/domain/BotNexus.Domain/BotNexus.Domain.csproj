<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Vogen is a compile-time SOURCE GENERATOR: it emits the value-object types at build time and
         nothing needs it at runtime. PrivateAssets="all" stops it flowing transitively to consumers.

         This is load-bearing, not tidiness (#2329). BlazorClient.Core references this project to share
         the canonical conversation wire enums, and it feeds a Microsoft.NET.Sdk.BlazorWebAssembly app,
         so anything flowing out of here is DOWNLOADED BY THE BROWSER. Without this pin,
         Vogen.SharedTypes.dll lands in the WASM output. -->
    <PackageReference Include="Vogen" PrivateAssets="all" />
  </ItemGroup>

</Project>
