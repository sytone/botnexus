{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://botnexus.dev/schemas/marketplace.schema.json",
  "title": "BotNexus plugin marketplace catalog",
  "description": "On-disk contract for a marketplace.json catalog. Single source of truth for marketplace catalog field names and requiredness.",
  "type": "object",
  "required": [
    "name",
    "owner",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique marketplace identifier in lowercase kebab-case.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "owner": {
      "type": "object",
      "description": "Who publishes and is accountable for this catalog.",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "description": {
      "type": "string",
      "description": "Human readable summary of the catalog."
    },
    "plugins": {
      "type": "array",
      "description": "Plugin entries offered by this marketplace.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "description": "Where the plugin content comes from (repository URL or catalog-relative path).",
            "minLength": 1
          },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
