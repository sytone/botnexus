<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BotNexus.Extensions.BrowserTools</RootNamespace>
    <Description>Guard layer for BotNexus agent-browser automation: SSRF validation, secret-prefix and credential-parameter rejection, post-navigation URL re-validation, and the untrusted-content envelope.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BotNexus.Extensions.BrowserTools.Tests" />
  </ItemGroup>
  <!-- #3029 AC2: this project declares NO PackageReference. WebTools declares none either, and a
       test parses both csproj files to hold that line. The filesystem seam this extension needs
       for testability is IBrowserFileSystem, defined in-project, rather than a NuGet abstraction:
       a four-method interface is cheaper than an extra assembly in the extension load context. -->
  <ItemGroup>
    <!-- #3030 AC2: the SSRF policy is CONSUMED from Gateway.Contracts, never respelled here.
         A second copy of the private-range/metadata rules is how one copy drifts and the
         other keeps passing its tests; BrowserToolsUrlGuard therefore has no address
         arithmetic of its own and an architecture fence pins that. -->
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Contracts\BotNexus.Gateway.Contracts.csproj" />
    <!-- Untrusted page text passes the same injection filter as any other inbound external
         text (#2813). Domain is a dependency-free leaf, so naming it adds no assembly. -->
    <ProjectReference Include="..\..\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
  </ItemGroup>

  <!-- Copy extension output + manifest to artifacts/extensions/ for dev-time discovery -->
  <Target Name="CopyExtensionToArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <ExtensionArtifactDir>$(MSBuildThisFileDirectory)..\..\..\artifacts\extensions\botnexus-browser\</ExtensionArtifactDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionArtifactDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)botnexus-extension.json" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
