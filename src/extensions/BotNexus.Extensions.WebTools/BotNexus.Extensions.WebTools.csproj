<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BotNexus.Extensions.WebTools</RootNamespace>
    <Description>Web search and fetch tools for BotNexus agents. Multi-provider search (Brave, Tavily, Bing) and URL content retrieval.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BotNexus.Extensions.WebTools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\agent\BotNexus.Agent.Core\BotNexus.Agent.Core.csproj" />
    <ProjectReference Include="..\..\agent\BotNexus.Agent.Providers.Core\BotNexus.Agent.Providers.Core.csproj" />
    <!-- #2813: web tool output is untrusted external content and must pass the SAME injection
         filter as any other untrusted inbound text. UntrustedContentSanitizer lives in the
         dependency-free BotNexus.Domain leaf (beside EscapedMarkupNormalizer) precisely so this
         extension can CONSUME it rather than grow a second spelling of "what a marker looks
         like". Domain is already in this project's transitive closure via Gateway.Abstractions,
         so naming it directly adds no assembly to the extension's load context. -->
    <ProjectReference Include="..\..\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Contracts\BotNexus.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\BotNexus.Extensions.Mcp\BotNexus.Extensions.Mcp.csproj" />
  </ItemGroup>

  <!-- Copy extension output + manifest to artifacts/extensions/ for dev-time discovery -->
  <Target Name="CopyExtensionToArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <ExtensionArtifactDir>$(MSBuildThisFileDirectory)..\..\..\artifacts\extensions\botnexus-web\</ExtensionArtifactDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionArtifactDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)botnexus-extension.json" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
