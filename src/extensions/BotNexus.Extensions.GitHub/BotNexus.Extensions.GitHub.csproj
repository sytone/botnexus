<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Extension assemblies load into an isolated AssemblyLoadContext, so their managed dependency
      closure must ship in the extension output directory. See ExtensionManagedDependencyClosure
      architecture fence and issue #2184.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>BotNexus.Extensions.GitHub</RootNamespace>
    <Description>Platform-owned GitHub App installation credential for BotNexus. Caches the token until expiry and never exposes it to an agent.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BotNexus.Extensions.GitHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- IServiceContributor lives here; GitHubServiceContributor registers through that seam (#2732). -->
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <!-- Copy extension output + manifest to artifacts/extensions/ for dev-time discovery -->
  <Target Name="CopyExtensionToArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <ExtensionArtifactDir>$(MSBuildThisFileDirectory)..\..\..\artifacts\extensions\botnexus-github\</ExtensionArtifactDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExtensionArtifactDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)botnexus-extension.json" DestinationFolder="$(ExtensionArtifactDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
