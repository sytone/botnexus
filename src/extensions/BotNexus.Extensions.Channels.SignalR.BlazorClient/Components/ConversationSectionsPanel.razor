@using BuiltInConversationSection = BotNexus.Gateway.Abstractions.Models.BuiltInConversationSection
@implements IDisposable
@inject ConversationSectionsState SectionsState
@inject IJSRuntime JS

@if (CreateOnly)
{
    <button type="button" class="section-add-btn" data-testid="section-add-btn" disabled="@(!CanEdit)"
            title="Create a custom section" @onclick="StartCreate">+ Section</button>
    @if (_creating)
    {
        <div class="section-create-row" data-testid="section-create-row">
            <label for="section-create-name">Section name</label>
            <input id="section-create-name" class="section-name-input" data-testid="section-create-input"
                   aria-label="Section name" aria-describedby="section-name-error" @ref="_nameInput"
                   disabled="@SectionsState.IsSaving" @bind="_draftName" @bind:event="oninput" @onkeydown="CreateKeyAsync" />
            <button type="button" data-testid="section-create-save" disabled="@(!CanEdit)" @onclick="ConfirmCreateAsync">Create</button>
            <button type="button" data-testid="section-create-cancel" @onclick="ResetDrafts">Cancel</button>
            @if (_validation is not null) { <span id="section-name-error" role="alert">@_validation</span> }
        </div>
    }
}
else
{
    @if (SectionsState.IsLoading)
    {
        <div role="status" data-testid="sections-loading">Loading sections…</div>
    }
    @if (SectionsState.LoadError is not null || !SectionsState.HasSnapshot && !SectionsState.IsLoading)
    {
        <div role="alert" data-testid="sections-unavailable">Sections unavailable. @SectionsState.LoadError</div>
    }
    @if (SectionsState.RequiresReconciliation)
    {
        <div role="alert" data-testid="sections-reconciliation">Section snapshots disagree. Safe groups are shown; refresh before editing.</div>
    }
    @if (SectionsState.IsSaving)
    {
        <div role="status" data-testid="sections-saving">Saving section changes…</div>
    }
    @if (SectionsState.GroupOrderUnsupported)
    {
        <div role="alert" data-testid="sections-unsupported">This server does not support peer section ordering. Refresh before continuing.</div>
    }
    @if (SectionsState.SavedButRefreshFailed)
    {
        <div role="alert" data-testid="sections-saved-refresh-failed">Saved, but refresh failed. Refresh to see the saved result; do not save again.</div>
    }
    @if (SectionsState.MutationError is { } mutationError)
    {
        <div role="alert" data-testid="sections-mutation-error">@mutationError</div>
    }
    <button type="button" data-testid="sections-refresh" class="sections-refresh"
            disabled="@(SectionsState.IsLoading || SectionsState.IsSaving)" @onclick="SectionsState.RetryAsync">Refresh sections</button>

    @foreach (var (group, index) in Groups.Select((group, index) => (group, index)))
    {
        var identity = group.Identity.SectionId ?? group.Identity.System?.ToString() ?? string.Empty;
        var key = GroupKey(group);
        var collapsed = group.Section?.IsCollapsed ?? (IsCollapsed?.Invoke(group.Identity.System) ?? false);
        <div @key="identity" class="conversation-group conversation-group-@key @(group.Section is null ? "" : "conversation-section")"
             data-testid="@(group.Section is null ? $"conversation-group-{key}" : "conversation-section")"
             data-group-id="@identity" data-section-id="@group.Section?.SectionId">
            <div class="peer-section-header">
                <button type="button" class="conversation-group-header conversation-group-header-toggle"
                        data-testid="@(group.Section is null ? $"{ToggleKey(group)}-group-toggle" : "section-collapse-toggle")"
                        @ref="_headers[identity]" aria-label="@($"{(collapsed ? "Expand" : "Collapse")} {group.Label}")"
                        aria-expanded="@(!collapsed ? "true" : "false")"
                        disabled="@(group.Section is not null && !CanEdit)" @onclick="() => ToggleAsync(group)">
                    <span class="group-chevron @(!collapsed ? "expanded" : "")" aria-hidden="true">&#x25B6;</span>
                    <span class="@(group.Section is null ? group.Identity.System == BuiltInConversationSection.Conversations ? "conversation-general-label" : "conversation-group-label" : "conversation-section-name")"
                          data-testid="@(group.Section is null ? null : "section-name")">@group.Label</span>
                    <span class="conversation-group-count" data-testid="@(group.Section is null ? $"{ToggleKey(group)}-group-count" : "section-count")">@group.Conversations.Count</span>
                </button>
                <ConversationSectionActionMenu Label="@group.Label" IsCustom="@(group.Section is not null)"
                    Scope="@($"{ScopeKey}:{_generation}")" Disabled="@(!CanEdit)" CanMoveUp="@(index > 0)" CanMoveDown="@(index < Groups.Count - 1)"
                    CaptureAction="CaptureMenuAction" IsScopeCurrent="CaptureScopeGuard()"
                    OnMoveUp="() => MoveAsync(group.Identity, -1)" OnMoveDown="() => MoveAsync(group.Identity, 1)"
                    OnRename="() => StartRename(group.Section)" OnDelete="() => DeleteAsync(group.Section)" />
            </div>
            @if (_editingId == group.Section?.SectionId && _editingId is not null)
            {
                <div class="section-create-row">
                    <label for="section-rename-name">Section name</label>
                    <input id="section-rename-name" aria-label="Section name" class="section-name-input" data-testid="section-rename-input"
                           @ref="_nameInput" @bind="_draftName" @bind:event="oninput" disabled="@SectionsState.IsSaving"
                           @onkeydown="args => RenameKeyAsync(args, group.Section)" />
                    <button type="button" data-testid="section-rename-save" disabled="@(!CanEdit)" @onclick="() => ConfirmRenameAsync(group.Section)">Save</button>
                    <button type="button" data-testid="section-rename-cancel" @onclick="ResetDrafts">Cancel</button>
                    @if (_validation is not null) { <span role="alert">@_validation</span> }
                </div>
            }
            @if (group.Identity.System == BuiltInConversationSection.Conversations)
            {
                @GeneralFilter
                @if (GeneralFilterEmpty && !collapsed)
                {
                    <div class="conversation-list-empty" data-testid="conversation-filter-empty">No conversations in this range.</div>
                }
            }
            @if (!collapsed)
            {
                <div class="conversation-section-body" data-testid="@(group.Section is null ? null : "conversation-section-body")">
                    @if (group.Conversations.Count == 0)
                    {
                        <div class="conversation-section-empty" data-testid="@(group.Section is null ? null : "conversation-section-empty")">No conversations@(group.Section is null ? "." : ". Assign from a conversation's menu.")</div>
                    }
                    @foreach (var row in group.Conversations)
                    {
                        @if (RowContent is not null) { @RowContent(row) }
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public string AgentId { get; set; } = string.Empty;
    [Parameter] public bool CreateOnly { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string DraftScope { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<ConversationSidebarGroup> Groups { get; set; } = [];
    [Parameter] public RenderFragment<ConversationState>? RowContent { get; set; }
    [Parameter] public RenderFragment? GeneralFilter { get; set; }
    [Parameter] public bool GeneralFilterEmpty { get; set; }
    [Parameter] public Func<BuiltInConversationSection?, bool>? IsCollapsed { get; set; }
    [Parameter] public EventCallback<BuiltInConversationSection?> OnToggleSystem { get; set; }
    [Parameter] public EventCallback<string> OnCreated { get; set; }
    [Parameter] public string? FocusSectionId { get; set; }

    private bool _creating, _focusInput, _subscribed, _disposed;
    private int _generation;
    private string? _scope, _editingId, _validation, _focusedSection;
    private string _draftName = string.Empty;
    private ElementReference _nameInput;
    private readonly Dictionary<string, ElementReference> _headers = new();
    private string ScopeKey => $"{AgentId}:{DraftScope}:{CreateOnly}:{ReadOnly}";
    private bool CanEdit => !_disposed && !ReadOnly && AgentId == SectionsState.AgentId && SectionsState.CanMutate;

    protected override void OnInitialized()
    {
        SectionsState.Changed += OnStateChanged;
        _subscribed = true;
    }

    protected override void OnParametersSet()
    {
        if (_scope != ScopeKey) { ResetDrafts(); _scope = ScopeKey; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var agent = AgentId;
        var generation = _generation;
        if (!Current(agent, generation)) return;
        if (_focusInput)
        {
            _focusInput = false;
            await _nameInput.FocusAsync();
        }
        if (!Current(agent, generation)) return;
        if (!CreateOnly && FocusSectionId is { } id && _focusedSection != id && _headers.TryGetValue(id, out var header))
        {
            _focusedSection = id;
            await header.FocusAsync();
        }
    }

    private void OnStateChanged()
    {
        if (_disposed) return;
        // Synchronous invalidation also catches A/B/A while a native confirmation is outstanding.
        if (AgentId != SectionsState.AgentId) ResetDrafts();
        _ = InvokeAsync(StateHasChanged);
    }

    public void ResetDrafts()
    {
        ++_generation;
        _creating = false;
        _editingId = null;
        _draftName = string.Empty;
        _validation = null;
        _focusInput = false;
    }

    private void StartCreate()
    {
        if (!CanEdit) return;
        ResetDrafts();
        _creating = true;
        _focusInput = true;
    }

    private bool ValidName()
    {
        if (_draftName.Trim().Length is > 0 and <= 100) { _validation = null; return true; }
        _validation = "Section name must contain 1 to 100 characters.";
        return false;
    }

    private bool Current(string agent, int generation) => !_disposed && AgentId == agent && SectionsState.AgentId == agent && generation == _generation;

    private Func<bool> CaptureScopeGuard()
    {
        var agent = AgentId;
        var generation = _generation;
        return () => CanEdit && Current(agent, generation);
    }

    private Func<Task> CaptureMenuAction(EventCallback action)
    {
        var agent = AgentId;
        var generation = _generation;
        var order = SectionsState.GroupOrder.ToArray();
        var allowed = CanEdit;
        return () => allowed && CanEdit && Current(agent, generation) && order.SequenceEqual(SectionsState.GroupOrder)
            ? action.InvokeAsync() : Task.CompletedTask;
    }

    private async Task ConfirmCreateAsync()
    {
        if (!_creating || !CanEdit || !ValidName()) return;
        var agent = AgentId;
        var generation = _generation;
        var before = SectionsState.Sections.Select(section => section.SectionId).ToHashSet(StringComparer.Ordinal);
        var saved = await SectionsState.CreateAsync(_draftName.Trim());
        if (!Current(agent, generation)) return;
        if (saved || SectionsState.RequiresRefresh) ResetDrafts();
        if (saved && SectionsState.Sections.FirstOrDefault(section => !before.Contains(section.SectionId)) is { } created)
            await OnCreated.InvokeAsync(created.SectionId);
    }

    private void StartRename(SectionDto? section)
    {
        if (!CanEdit || section is null) return;
        ResetDrafts();
        _editingId = section.SectionId;
        _draftName = section.Name;
        _focusInput = true;
    }

    private async Task ConfirmRenameAsync(SectionDto? section)
    {
        if (!CanEdit || section is null || _editingId != section.SectionId || !ValidName()) return;
        var agent = AgentId;
        var generation = _generation;
        var saved = await SectionsState.RenameAsync(section.SectionId, _draftName.Trim());
        if (Current(agent, generation) && (saved || SectionsState.RequiresRefresh)) ResetDrafts();
    }

    private Task CreateKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") { ResetDrafts(); return Task.CompletedTask; }
        return args.Key == "Enter" ? ConfirmCreateAsync() : Task.CompletedTask;
    }

    private Task RenameKeyAsync(KeyboardEventArgs args, SectionDto? section)
    {
        if (args.Key == "Escape") { ResetDrafts(); return Task.CompletedTask; }
        return args.Key == "Enter" ? ConfirmRenameAsync(section) : Task.CompletedTask;
    }

    private async Task DeleteAsync(SectionDto? section)
    {
        if (!CanEdit || section is null) return;
        var agent = AgentId;
        var generation = _generation;
        var id = section.SectionId;
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete section '{section.Name}'? Conversations return to their natural built-in homes, preserving pins and sources; conversations are not deleted.");
        if (confirmed && Current(agent, generation) && CanEdit) await SectionsState.DeleteAsync(id);
    }

    private async Task MoveAsync(SectionGroupOrderDto identity, int offset)
    {
        if (!CanEdit) return;
        // Resolve identity in the current canonical order, never saved visible/numeric indices.
        // CaptureMenuAction additionally rejects an order changed during menu close/focus.
        var from = SectionsState.GroupOrder.ToList().IndexOf(identity);
        if (from >= 0) await SectionsState.MoveGroupAsync(from, from + offset);
    }

    private Task ToggleAsync(ConversationSidebarGroup group) => _disposed ? Task.CompletedTask : group.Section is { } section
        ? CanEdit ? SectionsState.ToggleCollapseAsync(section) : Task.CompletedTask
        : OnToggleSystem.InvokeAsync(group.Identity.System);

    private static string GroupKey(ConversationSidebarGroup group) => group.Identity.System switch
    {
        BuiltInConversationSection.Webhooks => "automated",
        _ => group.Identity.System?.ToString().ToLowerInvariant() ?? "custom"
    };
    private static string ToggleKey(ConversationSidebarGroup group) => group.Identity.System switch
    {
        BuiltInConversationSection.Scheduled => "cron", BuiltInConversationSection.Webhooks => "webhook",
        _ => GroupKey(group)
    };

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        ResetDrafts();
        if (_subscribed) { SectionsState.Changed -= OnStateChanged; _subscribed = false; }
    }
}
