@using BotNexus.Extensions.Channels.SignalR.BlazorClient.Services
@inject IClientStateStore Store
@inject IGatewayRestClient Rest
@inject NavigationManager Nav
@implements IDisposable

<div class="activity-dashboard" data-testid="activity-dashboard">
    <div class="activity-dashboard-header">
        <h1 class="activity-dashboard-title">Activity</h1>
        <span class="activity-dashboard-subtitle">Active conversations across the platform</span>
    </div>

    @if (_summary is { } summary)
    {
        <div class="activity-summary-strip" data-testid="activity-summary-strip" role="group" aria-label="Activity summary">
            <button type="button"
                    class="activity-summary-stat activity-summary-stat--action @(HasActiveFilters ? "active" : "")"
                    data-testid="activity-summary-conversations"
                    aria-label="Clear activity filters"
                    title="Clear all filters"
                    @onclick="ResetFilters">
                <span class="activity-summary-value">@summary.ConversationCount</span>
                <span class="activity-summary-label">@(summary.ConversationCount == 1 ? "conversation" : "conversations")</span>
            </button>
            <button type="button"
                    class="activity-summary-stat activity-summary-stat--action @(_filter.AgentId is not null ? "active" : "")"
                    data-testid="activity-summary-agents"
                    aria-label="Jump to the agent filter"
                    title="Filter by a specific agent"
                    @onclick="FocusAgentPicker">
                <span class="activity-summary-value">@summary.AgentCount</span>
                <span class="activity-summary-label">@(summary.AgentCount == 1 ? "agent" : "agents")</span>
            </button>
            <button type="button"
                    class="activity-summary-stat activity-summary-stat--action @(_filter.IncludeCron ? "active" : "")"
                    data-testid="activity-summary-scheduled"
                    aria-pressed="@_filter.IncludeCron"
                    title="@(_filter.IncludeCron ? "Hide scheduled (cron) conversations" : "Show scheduled (cron) conversations")"
                    @onclick="ToggleCron">
                <span class="activity-summary-value">@summary.ScheduledCount</span>
                <span class="activity-summary-label">scheduled</span>
            </button>
            <button type="button"
                    class="activity-summary-stat activity-summary-stat--action activity-summary-stat--live @(_filter.Live == ActivityLiveFilter.Live ? "active" : "")"
                    data-testid="activity-summary-live"
                    aria-pressed="@(_filter.Live == ActivityLiveFilter.Live)"
                    title="@(_filter.Live == ActivityLiveFilter.Live ? "Show conversations in any state" : "Show only conversations running right now")"
                    @onclick="ToggleLive">
                <span class="activity-summary-value">@summary.LiveCount</span>
                <span class="activity-summary-label">live now</span>
            </button>
            <div class="activity-summary-stat activity-summary-stat--freshness" data-testid="activity-summary-freshness">
                <span class="activity-summary-value" title="@(summary.LatestActivity?.ToString("o"))">@FreshnessLabel(summary.LatestActivity)</span>
                <span class="activity-summary-label">latest activity</span>
            </div>
        </div>
    }

    <div class="activity-filter-bar" role="group" aria-label="Filter activity" data-testid="activity-filter-bar">
        <button type="button"
                class="activity-filter-btn @(_filter.IncludeCron ? "active" : "")"
                data-testid="activity-filter-cron"
                aria-pressed="@_filter.IncludeCron"
                title="Show scheduled (cron) conversations"
                @onclick="ToggleCron">@(_filter.IncludeCron ? "\u2611" : "\u2610") Cron</button>

        <select class="activity-filter-select" data-testid="activity-filter-agent"
                @ref="_agentSelect"
                aria-label="Filter by agent"
                value="@(_filter.AgentId ?? "")"
                @onchange="OnAgentFilterChanged">
            <option value="">All agents</option>
            @foreach (var (agentId, agent) in Store.Agents.OrderForDisplay())
            {
                <option value="@agentId">@AgentLabel(agentId)</option>
            }
        </select>

        <select class="activity-filter-select" data-testid="activity-filter-status"
                aria-label="Filter by status"
                value="@_filter.Status"
                @onchange="OnStatusFilterChanged">
            <option value="@ActivityStatusFilter.Active">Active</option>
            <option value="@ActivityStatusFilter.Archived">Archived</option>
            <option value="@ActivityStatusFilter.All">All statuses</option>
        </select>

        <select class="activity-filter-select" data-testid="activity-filter-recency"
                aria-label="Filter by recency"
                value="@_filter.Recency"
                @onchange="OnRecencyFilterChanged">
            <option value="@ActivityRecencyWindow.Any">Any time</option>
            <option value="@ActivityRecencyWindow.Today">Today</option>
            <option value="@ActivityRecencyWindow.Week">Last 7 days</option>
            <option value="@ActivityRecencyWindow.Month">Last 30 days</option>
        </select>
        <select class="activity-filter-select" data-testid="activity-filter-origin"
                aria-label="Filter by origin"
                value="@_filter.Origin"
                @onchange="OnOriginFilterChanged">
            <option value="@ActivityOriginFilter.All">Any origin</option>
            <option value="@ActivityOriginFilter.Human">Human</option>
            <option value="@ActivityOriginFilter.Scheduled">Scheduled</option>
            <option value="@ActivityOriginFilter.Webhook">Webhook</option>
            <option value="@ActivityOriginFilter.Agent">Agent-initiated</option>
            <option value="@ActivityOriginFilter.SubAgent">Sub-agent</option>
            <option value="@ActivityOriginFilter.AgentToAgent">Agent-to-agent</option>
        </select>
        <select class="activity-filter-select" data-testid="activity-filter-pinned"
                aria-label="Filter by pin state"
                value="@_filter.Pinned"
                @onchange="OnPinFilterChanged">
            <option value="@ActivityPinFilter.All">Any pin state</option>
            <option value="@ActivityPinFilter.Pinned">Pinned only</option>
            <option value="@ActivityPinFilter.Unpinned">Unpinned only</option>
        </select>
        <select class="activity-filter-select" data-testid="activity-filter-live"
                aria-label="Filter by live state"
                value="@_filter.Live"
                @onchange="OnLiveFilterChanged">
            <option value="@ActivityLiveFilter.All">Any live state</option>
            <option value="@ActivityLiveFilter.Live">Live now</option>
            <option value="@ActivityLiveFilter.Idle">Idle only</option>
        </select>
    </div>

    @if (_isLoading && _rows is null)
    {
        <div class="activity-loading" data-testid="activity-loading">Loading activity&#x2026;</div>
    }
    else if (_loadError)
    {
        <div class="activity-error" data-testid="activity-error">Could not load activity. Retrying&#x2026;</div>
    }
    else if (_rows is { Count: 0 })
    {
        <div class="activity-empty" data-testid="activity-empty">
            No active conversations match the current filters.
        </div>
    }
    else if (_rows is { } rows)
    {
        <div class="activity-table-scroll" data-testid="activity-table-scroll" tabindex="0" role="region" aria-label="Activity table">
        <table class="activity-table" data-testid="activity-table">
            <thead>
                <tr>
                    <th scope="col">Conversation</th>
                    <th scope="col">Agents</th>
                    <th scope="col">Status</th>
                    <th scope="col">Channels</th>
                    <th scope="col">Last activity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr class="activity-row @(row.IsCron ? "activity-row-cron" : "") @(row.IsPinned ? "activity-row-pinned" : "") @(row.IsLive ? "activity-row-live" : "")"
                        data-testid="activity-row"
                        data-conversation-id="@row.ConversationId"
                        tabindex="0"
                        role="link"
                        @onclick="() => NavigateToConversation(row)"
                        @onkeydown="e => OnRowKeyDown(e, row)">
                        <td class="activity-cell-title">
                            <span class="activity-conversation-title" title="@row.Title">@DisplayTitle(row)</span>
                            @if (row.IsLive)
                            {
                                @* #1888: the row's only present-tense signal. Rendered FIRST so the
                                   "is anything happening?" answer reads before the historical badges. *@
                                <span class="activity-badge activity-badge-live"
                                      data-testid="activity-live-badge"
                                      title="@LiveTooltip(row)"
                                      aria-label="Live">Live</span>
                            }
                            @if (row.IsPinned)
                            {
                                <span class="activity-badge activity-badge-pinned"
                                      data-testid="activity-pin-badge"
                                      title="@PinTooltip(row)"
                                      aria-label="Pinned">&#x1F4CC; Pinned</span>
                            }
                            @if (ActivityDashboardProjection.ReadOnlyLabel(row) is { } readOnlyLabel)
                            {
                                @* #2692: InspectableReadOnly rows are kept but marked, so the reader can
                                   tell an observer/audit row from one they own. Reuses .activity-badge. *@
                                <span class="activity-badge activity-badge-readonly"
                                      data-testid="activity-readonly-badge"
                                      title="Read-only: you can inspect this conversation but not participate in it."
                                      aria-label="Read-only">@readOnlyLabel</span>
                            }
                            @if (ActivityDashboardProjection.OriginLabel(row) is { } originLabel)
                            {
                                <span class="activity-badge activity-badge-@ActivityDashboardProjection.OriginModifier(row)"
                                      data-testid="activity-origin-badge"
                                      data-origin="@ActivityDashboardProjection.OriginModifier(row)"
                                      title="@OriginTooltip(row)">@originLabel</span>
                            }
                            @if (ActivityDashboardProjection.SourceLabel(row) is { } sourceLabel)
                            {
                                @* #3105: WHICH job or registration minted this row, as opposed to the
                                   origin badge's WHAT KIND. Rendered immediately after the origin badge
                                   it qualifies, and only ever when that badge is present. *@
                                <span class="activity-source-id"
                                      data-testid="activity-source-id"
                                      data-source-id="@row.SourceId"
                                      title="@OriginTooltip(row)">@sourceLabel</span>
                            }
                        </td>
                        <td class="activity-cell-agents">
                            @foreach (var agent in row.InvolvedAgents)
                            {
                                var roleLabel = ActivityDashboardProjection.RoleLabel(agent);
                                var roleModifier = ActivityDashboardProjection.RoleModifier(agent);
                                <span class="activity-agent-chip @(roleModifier is null ? null : $"activity-agent-chip--{roleModifier}")"
                                      data-testid="activity-agent-chip"
                                      data-role="@roleLabel"
                                      title="@AgentChipTooltip(agent)"
                                      aria-label="@AgentChipTooltip(agent)">@AgentLabel(agent.AgentId)@if (roleLabel is not null)
                                    {
                                        <span class="activity-agent-role">@roleLabel</span>
                                    }</span>
                            }
                        </td>
                        <td class="activity-cell-status">
                            <span class="activity-status activity-status-@row.Status.ToLowerInvariant()">@row.Status</span>
                        </td>
                        <td class="activity-cell-channels">@row.ChannelCount</td>
                        <td class="activity-cell-activity" title="@row.LastActivity.ToString("o")">
                            @FormatRelative(row.LastActivity)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    // Poll interval mirrors the existing portal conversation-list polling cadence; SignalR push is a
    // later evolution (see #1888). Kept as a field so a future enhancement can make it configurable.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(15);

    private ActivityDashboardFilter _filter = new();
    private ElementReference _agentSelect;
    private IReadOnlyList<ActivityRow>? _rows;
    private ActivitySummary? _summary;
    private bool _isLoading;
    private bool _loadError;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        Store.OnChanged += HandleStateChanged;
        await LoadAsync();
        StartPolling();
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var conversations = await Rest.GetAllConversationsAsync();
            _rows = ActivityDashboardProjection.Project(conversations, _filter, DateTimeOffset.UtcNow);
            _summary = ActivityDashboardProjection.Summarize(_rows);
            _loadError = false;
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(PollInterval, token);
                }
                catch (TaskCanceledException)
                {
                    return;
                }

                if (token.IsCancellationRequested)
                    return;

                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }, token);
    }

    private async Task ApplyFilterAsync(ActivityDashboardFilter filter)
    {
        _filter = filter;
        await LoadAsync();
        StateHasChanged();
    }

    private bool HasActiveFilters => _filter != new ActivityDashboardFilter();

    private Task ResetFilters() => ApplyFilterAsync(new ActivityDashboardFilter());

    private Task ToggleCron() => ApplyFilterAsync(_filter with { IncludeCron = !_filter.IncludeCron });

    /// <summary>
    /// Turns the live stat card into a filter action (#1888), mirroring the scheduled card: clicking
    /// the number narrows the table to exactly the rows it counted, and clicking again clears the
    /// facet. Toggles between <see cref="ActivityLiveFilter.Live"/> and
    /// <see cref="ActivityLiveFilter.All"/> only - the card counts live rows, so it must never land
    /// the user on <see cref="ActivityLiveFilter.Idle"/>, which is the select's job.
    /// </summary>
    private Task ToggleLive() => ApplyFilterAsync(_filter with
    {
        Live = _filter.Live == ActivityLiveFilter.Live ? ActivityLiveFilter.All : ActivityLiveFilter.Live
    });

    /// <summary>
    /// Turns the agents stat card into navigation: focuses the agent-filter dropdown so a click on the
    /// number takes the user straight to picking an agent, mirroring the interactive treatment the
    /// conversations and scheduled cards already have. Keeps the picker as the single source of truth for
    /// the agent facet rather than duplicating agent-selection state on the card.
    /// </summary>
    private async Task FocusAgentPicker()
    {
        try
        {
            await _agentSelect.FocusAsync();
        }
        catch
        {
            // Focus is a best-effort affordance; a missing element (e.g. during teardown) must not surface.
        }
    }

    private Task OnAgentFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        return ApplyFilterAsync(_filter with { AgentId = string.IsNullOrEmpty(value) ? null : value });
    }

    private Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityStatusFilter>(e.Value?.ToString(), out var status))
            return ApplyFilterAsync(_filter with { Status = status });
        return Task.CompletedTask;
    }

    private Task OnRecencyFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityRecencyWindow>(e.Value?.ToString(), out var window))
            return ApplyFilterAsync(_filter with { Recency = window });
        return Task.CompletedTask;
    }

    /// <summary>
    /// Applies the origin facet (#2385). Mirrors the status/recency handlers exactly - it swaps one
    /// facet on the existing immutable filter and re-projects, rather than introducing a second
    /// query path. An unparseable value is ignored so a stale DOM value cannot blank the table.
    /// </summary>
    private Task OnOriginFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityOriginFilter>(e.Value?.ToString(), out var origin))
            return ApplyFilterAsync(_filter with { Origin = origin });
        return Task.CompletedTask;
    }

    /// <summary>
    /// Applies the pin facet (#2619). Mirrors the origin/status/recency handlers exactly - it swaps
    /// one facet on the existing immutable filter and re-projects, rather than introducing a second
    /// query path. An unparseable value is ignored so a stale DOM value cannot blank the table.
    /// </summary>
    private Task OnPinFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityPinFilter>(e.Value?.ToString(), out var pinned))
            return ApplyFilterAsync(_filter with { Pinned = pinned });
        return Task.CompletedTask;
    }

    /// <summary>
    /// Applies the liveness facet (#1888). Mirrors the pin/origin/status/recency handlers exactly -
    /// it swaps one facet on the existing immutable filter and re-projects, rather than introducing
    /// a second query path. An unparseable value is ignored so a stale DOM value cannot blank the
    /// table.
    /// </summary>
    private Task OnLiveFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityLiveFilter>(e.Value?.ToString(), out var live))
            return ApplyFilterAsync(_filter with { Live = live });
        return Task.CompletedTask;
    }

    /// <summary>
    /// Hover detail behind the live badge: which session is running, so the badge stays a one-glance
    /// mark while the underlying server value remains inspectable without lengthening the row.
    /// Mirrors <see cref="PinTooltip"/>.
    /// </summary>
    private static string LiveTooltip(ActivityRow row) =>
        row.ActiveSessionId is { Length: > 0 } sessionId
            ? $"Session running: {sessionId}"
            : "Session running";

    /// <summary>
    /// Hover detail behind the pin badge: when the pin was stamped, so the badge stays a one-glance
    /// mark while the underlying server value remains inspectable without lengthening the row.
    /// </summary>
    private static string PinTooltip(ActivityRow row) =>
        row.PinnedAt is { } pinnedAt
            ? $"Pinned {pinnedAt:o}"
            : "Pinned";

    private void NavigateToConversation(ActivityRow row) =>
        Nav.NavigateTo(
            $"/chat/{Uri.EscapeDataString(row.OwningAgentId)}/{Uri.EscapeDataString(row.ConversationId)}");

    private void OnRowKeyDown(KeyboardEventArgs e, ActivityRow row)
    {
        if (e.Key is "Enter" or " ")
            NavigateToConversation(row);
    }

    /// <summary>
    /// The bounded, human-meaningful label rendered in the title cell (#2528). A conversation whose
    /// title is a raw routing/session token gets a derived label instead; every title is length
    /// capped so a pathological id can never grow the row. The <c>title</c> attribute on the same
    /// span keeps the full untruncated value available on hover, mirroring the existing
    /// last-activity pattern.
    /// </summary>
    private static string DisplayTitle(ActivityRow row) =>
        ConversationLabel.DisplayTitle(row.Title, row.ConversationId, row.OwningAgentId);

    /// <summary>Resolve an agent id to its display name via the store, falling back to a title-cased id.</summary>
    private string AgentLabel(string agentId)
    {
        var agent = Store.GetAgent(agentId);
        if (agent is { DisplayName.Length: > 0 })
            return agent.DisplayName;
        return agentId;
    }

    /// <summary>
    /// Hover/screen-reader detail for an agent chip (#2857). Names the agent and, when the gateway
    /// stamped one, the role it played - so the direction of an agent-to-agent or sub-agent exchange
    /// is available to assistive tech, not only to sighted readers of the small role suffix.
    /// </summary>
    private string AgentChipTooltip(ActivityAgentRef agent)
    {
        var label = AgentLabel(agent.AgentId);
        var role = ActivityDashboardProjection.RoleLabel(agent);
        return role is null ? label : $"{label} - {role}";
    }

    /// <summary>
    /// Full <c>(source, kind)</c> pair as hover detail behind the short badge, plus the untruncated
    /// originator id when the row is attributable (#3105). The badge answers the question at a
    /// glance; the tooltip keeps the underlying typed values inspectable without lengthening the row.
    /// The originator joins the <em>existing</em> tooltip rather than getting a second hover target,
    /// so a reader has one place to look for a row's provenance.
    /// </summary>
    private static string OriginTooltip(ActivityRow row)
    {
        var pair = $"Source: {row.Source} \u00b7 Kind: {row.Kind}";

        // Gated on SourceLabel, not on SourceId, so the tooltip can never attribute a row the badge
        // declined to attribute - one rule, evaluated once.
        return ActivityDashboardProjection.SourceLabel(row) is null
            ? pair
            : $"{pair} \u00b7 Originator: {row.SourceId}";
    }

    private static string FormatRelative(DateTimeOffset ts)
    {
        var age = DateTimeOffset.UtcNow - ts;
        if (age < TimeSpan.Zero)
            age = TimeSpan.Zero;
        return age.TotalSeconds < 60 ? "just now"
            : age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes} min ago"
            : age.TotalHours < 24 ? $"{(int)age.TotalHours}h ago"
            : $"{(int)age.TotalDays}d ago";
    }

    /// <summary>Relative label for the summary strip's freshness stat, with an em-dash when idle.</summary>
    private static string FreshnessLabel(DateTimeOffset? ts) =>
        ts is { } value ? FormatRelative(value) : "\u2014";

    public void Dispose()
    {
        Store.OnChanged -= HandleStateChanged;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
