@inject HttpClient Http
@inject IJSRuntime JS
@inject IClientStateStore Store
@inject IGatewayRestClient RestClient
@implements IDisposable
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes

@* #2795: every displayed value comes from the ONE AgentConfigSnapshot below, and the Copy button
   serialises that same snapshot. There is no second field list for the copy path. *@

@if (_showPanel)
{
    <div class="config-overlay" @onclick="Close" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="config-dialog" role="dialog" aria-modal="true" aria-labelledby="agent-config-title" @onclick:stopPropagation="true">
            <div class="config-header">
                <h3 id="agent-config-title" class="page-heading">
                    <Icon Name="configuration" Size="18" /><span>Agent Configuration</span>
                </h3>
                <button class="config-close-btn" @onclick="Close" aria-label="Close">
                    <Icon Name="close" Size="14" Class="bn-icon-inherit" />
                </button>
            </div>

            @if (_loading)
            {
                <div class="config-loading">
                    <div class="loading-spinner small"></div>
                    <span>Loading configuration…</span>
                </div>
            }
            else
            {
                <div class="config-body">
                    @if (_snapshot is not null)
                    {
                        @foreach (var field in _snapshot.Fields)
                        {
                            <div class="config-field" data-field="@field.Key">
                                <label>@field.Label</label>
                                @if (field.Key == AgentConfigSnapshotBuilder.ModelKey && _availableModels.Count > 0)
                                {
                                    <select class="config-select" @bind="_selectedModel">
                                        @foreach (var model in _availableModels)
                                        {
                                            <option value="@model">@model</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="config-field-with-badge">
                                        <span class="config-value @(IsMono(field.Key) ? "mono" : "")">@field.Display</span>
                                        @if (field.IsInherited)
                                        {
                                            <span class="world-default-badge" title="Inherited from agents.defaults">World default</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (_toolExtensions.Count > 0)
                    {
                        <section class="agent-extension-config" aria-labelledby="agent-extensions-title">
                            <h4 id="agent-extensions-title">Agent extensions</h4>
                            <p class="agent-extension-help">Grant installed tool extensions to this agent and configure their manifest-declared settings. Changes apply to new agent handles.</p>
                            @foreach (var extension in _toolExtensions)
                            {
                                <div class="agent-extension-card" data-extension="@extension.Id">
                                    <label class="agent-extension-grant">
                                        <input type="checkbox"
                                               checked="@IsExtensionGranted(extension.Id)"
                                               @onchange="e => SetExtensionGrant(extension, e.Value is true)" />
                                        <span>Grant @extension.Name to this agent</span>
                                    </label>
                                    <span class="agent-extension-state">Installed and loaded</span>
                                    @if (IsExtensionGranted(extension.Id))
                                    {
                                        @foreach (var field in extension.ConfigSchema ?? [])
                                        {
                                            <div class="config-field agent-extension-field" data-extension-field="@field.Id">
                                                <label for="@ExtensionFieldId(extension.Id, field.Id)">@ExtensionFieldLabel(field.Id)</label>
                                                @if (IsBooleanField(field))
                                                {
                                                    <input id="@ExtensionFieldId(extension.Id, field.Id)"
                                                           type="checkbox"
                                                           checked="@GetBooleanExtensionValue(extension.Id, field)"
                                                           @onchange="e => SetExtensionValue(extension.Id, field, e.Value is true)" />
                                                }
                                                else
                                                {
                                                    <input id="@ExtensionFieldId(extension.Id, field.Id)"
                                                           class="config-select"
                                                           type="@(field.Sensitive ? "password" : IsIntegerField(field) ? "number" : "text")"
                                                           value="@GetTextExtensionValue(extension.Id, field)"
                                                           required="@field.Required"
                                                           @onchange="e => SetExtensionValue(extension.Id, field, e.Value?.ToString())" />
                                                }
                                                @if (!string.IsNullOrWhiteSpace(field.Description))
                                                {
                                                    <small>@field.Description</small>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </section>
                    }

                    @if (_error is not null)
                    {
                        <div class="config-error">@_error</div>
                    }

                    @* Per-session tool overlay (#3271). Sits alongside the model/thinking/context
                       overrides because it is the same kind of per-conversation execution override,
                       and it is only meaningful once a conversation is selected. *@
                    @if (Agent?.ActiveConversationId is { } overlayConversationId)
                    {
                        <ConversationToolOverlayPanel ConversationId="@overlayConversationId"
                                                      AgentTools="@(_descriptor?.ToolIds ?? [])"
                                                      InitialToolOverrideJson="@_toolOverrideJson"
                                                      InitialModel="@_conversation?.ModelOverride"
                                                      InitialThinking="@_conversation?.ThinkingOverride"
                                                      InitialContextWindow="@_conversation?.ContextWindowOverride"
                                                      OnOverlayChanged="HandleOverlayChanged" />
                    }
                </div>

                <div class="config-actions">
                    <button class="config-copy-btn" @onclick="CopyConfig" title="Copy the full configuration as JSON">
                        @if (_copied)
                        {
                            <Icon Name="check" Size="14" /><text>Copied!</text>
                        }
                        else
                        {
                            <Icon Name="copy" Size="14" Class="bn-icon-inherit" /><text>Copy</text>
                        }
                    </button>
                    @if (_availableModels.Count > 0 && _selectedModel != _snapshot?.Field(AgentConfigSnapshotBuilder.ModelKey)?.Value)
                    {
                        <button class="config-save-btn" @onclick="SaveModel" disabled="@_saving">
                            @(_saving ? "Saving…" : "Save Model")
                        </button>
                    }
                    @if (_dirtyExtensions.Count > 0)
                    {
                        <button class="config-save-btn config-save-extensions-btn" @onclick="SaveExtensions" disabled="@_saving">
                            @(_saving ? "Saving…" : "Save Extensions")
                        </button>
                    }
                    <button class="cancel-btn" @onclick="Close">Close</button>
                </div>
            }
        </div>
    </div>
}

@code {

    protected override void OnInitialized()
    {
        Store.OnChanged += HandleStoreChanged;
    }

    private void HandleStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Store.OnChanged -= HandleStoreChanged;
    }

    [Parameter, EditorRequired]
    public string AgentId { get; set; } = default!;

    private AgentState? Agent => Store.GetAgent(AgentId);
    private bool _showPanel;
    private bool _loading;
    private bool _saving;
    private bool _copied;
    private string? _error;

    /// <summary>
    /// #2795 AC6: the single source of truth for both the rendered rows and the clipboard payload.
    /// Do not add a value to the markup that is not a field on this snapshot.
    /// </summary>
    private AgentConfigSnapshot? _snapshot;

    private AgentDescriptorDto? _descriptor;
    private List<string> _availableModels = [];
    private string _selectedModel = "";
    private Dictionary<string, bool> _inheritedFields = new(StringComparer.OrdinalIgnoreCase);
    private List<ExtensionDetailDto> _toolExtensions = [];
    private readonly Dictionary<string, JsonObject> _extensionValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _grantedExtensions = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _dirtyExtensions = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The loaded conversation row, source of the persisted tool overlay (#3271).</summary>
    private ConversationResponseDto? _conversation;
    private string? _toolOverrideJson;

    /// <summary>Re-reads the overlay from the server's response so the panel shows what persisted.</summary>
    private void HandleOverlayChanged(ConversationResponseDto? updated)
    {
        if (updated is null)
            return;
        _conversation = updated;
        _toolOverrideJson = updated.ToolOverrideJson;
        StateHasChanged();
    }

    /// <summary>Identifier-shaped fields get the monospace treatment (#2795 AC4).</summary>
    private static bool IsMono(string key) =>
        key is "agentId" or "conversationId" or "sessionId" or AgentConfigSnapshotBuilder.ModelKey;

    public async Task Open()
    {
        _showPanel = true;
        _loading = true;
        _error = null;
        _copied = false;
        StateHasChanged();

        try
        {
            var apiBase = RestClient.ApiBaseUrl;
            if (apiBase is null || Agent is null)
                return;

            try
            {
                // #2795 defect 1: this endpoint serialises AgentDescriptor (ModelId / ApiProvider /
                // ToolIds). AgentDescriptorDto mirrors those names; see AgentConfigContracts.cs for
                // why the shared type itself cannot be referenced from a WASM client.
                _descriptor = await Http.GetFromJsonAsync<AgentDescriptorDto>($"{apiBase}agents/{AgentId}");
                _selectedModel = _descriptor?.ModelId ?? "";
                LoadExtensionValues();
            }
            catch
            {
                _descriptor = null;
            }

            try
            {
                _toolExtensions = (await RestClient.GetExtensionDetailsAsync())
                    .Where(extension => extension.Enabled
                        && extension.ExtensionTypes?.Contains("tool", StringComparer.OrdinalIgnoreCase) == true)
                    .OrderBy(extension => extension.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
            catch
            {
                _toolExtensions = [];
            }

            try
            {
                var models = await Http.GetFromJsonAsync<List<string>>($"{apiBase}agents/{AgentId}/models");
                _availableModels = models ?? [];
            }
            catch
            {
                _availableModels = [];
            }

            await ComputeInheritanceBadgesAsync(apiBase);

            // #3271: the conversation row carries the persisted tool overlay, so the control can
            // render current state without the operator running /tools.
            try
            {
                _conversation = Agent.ActiveConversationId is { } cid
                    ? await RestClient.GetConversationAsync(cid)
                    : null;
                _toolOverrideJson = _conversation?.ToolOverrideJson;
            }
            catch
            {
                _conversation = null;
                _toolOverrideJson = null;
            }

            ContextInfoDto? context = null;
            string? contextUnavailable = null;
            var sessionId = Agent.ActiveConversationSessionId;
            if (sessionId is not null)
            {
                try
                {
                    // #2795 defect 2: tokens arrive NESTED as sections.systemPrompt.tokens.
                    context = await Http.GetFromJsonAsync<ContextInfoDto>($"{apiBase}agents/{AgentId}/sessions/{sessionId}/context");
                    if (context?.Sections?.SystemPrompt?.Tokens is null)
                        contextUnavailable = AgentConfigField.Unavailable;
                }
                catch
                {
                    contextUnavailable = "unavailable";
                }
            }
            else
            {
                contextUnavailable = AgentConfigSnapshotBuilder.NoActiveSession;
            }

            RebuildSnapshot(context, contextUnavailable);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load config: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private ContextInfoDto? _context;
    private string? _contextUnavailable;

    private void RebuildSnapshot(ContextInfoDto? context, string? contextUnavailable)
    {
        _context = context;
        _contextUnavailable = contextUnavailable;
        _snapshot = AgentConfigSnapshotBuilder.Build(
            AgentId,
            Agent?.DisplayName,
            Agent?.ActiveConversationId,
            Agent?.ActiveConversationSessionId,
            Agent?.ChannelType,
            _descriptor,
            context,
            contextUnavailable,
            _inheritedFields);
    }

    private async Task ComputeInheritanceBadgesAsync(string apiBase)
    {
        _inheritedFields.Clear();
        try
        {
            var effective = await Http.GetFromJsonAsync<EffectiveAgentConfigResponse>($"{apiBase}config/agents/{AgentId}/effective");
            if (effective?.Sources is null) return;
            foreach (var (field, source) in effective.Sources)
                _inheritedFields[field] = string.Equals(source, "inherited", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _inheritedFields.Clear();
        }
    }

    /// <summary>
    /// #2795 AC5/AC6: copies the snapshot the panel is rendering. Because the payload is projected
    /// from <see cref="_snapshot"/>, a field can never be present in one and absent from the other.
    /// </summary>
    private async Task CopyConfig()
    {
        if (_snapshot is null) return;
        try
        {
            await JS.InvokeAsync<bool>("BotNexus.copyToClipboard", _snapshot.ToClipboardJson());
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard access may be blocked in some environments.
        }
    }

    private void Close() => _showPanel = false;

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Close();
    }

    private void LoadExtensionValues()
    {
        _extensionValues.Clear();
        _grantedExtensions.Clear();
        _dirtyExtensions.Clear();
        if (_descriptor is null)
            return;

        foreach (var (extensionId, value) in _descriptor.ExtensionConfig)
        {
            if (JsonNode.Parse(value.GetRawText()) is not JsonObject config)
                continue;
            _grantedExtensions.Add(extensionId);
            _extensionValues[extensionId] = config;
        }
    }

    private bool IsExtensionGranted(string extensionId) => _grantedExtensions.Contains(extensionId);

    private void SetExtensionGrant(ExtensionDetailDto extension, bool granted)
    {
        if (granted)
        {
            _grantedExtensions.Add(extension.Id);
            if (!_extensionValues.ContainsKey(extension.Id))
                _extensionValues[extension.Id] = new JsonObject();
        }
        else
        {
            _grantedExtensions.Remove(extension.Id);
        }
        _dirtyExtensions.Add(extension.Id);
    }

    private static bool IsBooleanField(ExtensionConfigFieldDto field) =>
        field.Type is "bool" or "boolean";

    private static bool IsIntegerField(ExtensionConfigFieldDto field) =>
        field.Type is "integer" or "number";

    private static string ExtensionFieldLabel(string path) =>
        path[(path.LastIndexOf('.') + 1)..];

    private static string ExtensionFieldId(string extensionId, string path) =>
        $"extension-{extensionId}-{path.Replace('.', '-')}";

    private bool GetBooleanExtensionValue(string extensionId, ExtensionConfigFieldDto field)
    {
        var node = ResolveExtensionValue(extensionId, field.Id);
        if (node is JsonValue value && value.TryGetValue<bool>(out var result))
            return result;
        return bool.TryParse(field.Default, out var defaultValue) && defaultValue;
    }

    private string GetTextExtensionValue(string extensionId, ExtensionConfigFieldDto field)
    {
        var node = ResolveExtensionValue(extensionId, field.Id);
        if (node is JsonValue value)
        {
            if (value.TryGetValue<string>(out var text)) return text;
            if (value.TryGetValue<int>(out var number)) return number.ToString(CultureInfo.InvariantCulture);
            if (value.TryGetValue<long>(out var longNumber)) return longNumber.ToString(CultureInfo.InvariantCulture);
        }
        return field.Default ?? string.Empty;
    }

    private JsonNode? ResolveExtensionValue(string extensionId, string path)
    {
        if (!_extensionValues.TryGetValue(extensionId, out var root))
            return null;
        JsonNode? current = root;
        foreach (var segment in path.Split('.', StringSplitOptions.RemoveEmptyEntries))
        {
            if (current is not JsonObject obj || !obj.TryGetPropertyValue(segment, out current))
                return null;
        }
        return current;
    }

    private void SetExtensionValue(string extensionId, ExtensionConfigFieldDto field, object? rawValue)
    {
        if (!_extensionValues.TryGetValue(extensionId, out var root))
        {
            root = new JsonObject();
            _extensionValues[extensionId] = root;
        }

        var segments = field.Id.Split('.', StringSplitOptions.RemoveEmptyEntries);
        var current = root;
        for (var i = 0; i < segments.Length - 1; i++)
        {
            if (current[segments[i]] is not JsonObject child)
            {
                child = new JsonObject();
                current[segments[i]] = child;
            }
            current = child;
        }

        var leaf = segments[^1];
        if (IsBooleanField(field))
            current[leaf] = JsonValue.Create(rawValue is true);
        else if (IsIntegerField(field) && long.TryParse(rawValue?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var number))
            current[leaf] = JsonValue.Create(number);
        else if (string.IsNullOrEmpty(rawValue?.ToString()))
            current.Remove(leaf);
        else
            current[leaf] = JsonValue.Create(rawValue.ToString());
        _dirtyExtensions.Add(extensionId);
    }

    private async Task SaveExtensions()
    {
        if (RestClient.ApiBaseUrl is null || _dirtyExtensions.Count == 0)
            return;

        _saving = true;
        _error = null;
        try
        {
            foreach (var extensionId in _dirtyExtensions.ToArray())
            {
                var path = $"{RestClient.ApiBaseUrl}agents/{Uri.EscapeDataString(AgentId)}/extensions/{Uri.EscapeDataString(extensionId)}";
                HttpResponseMessage response;
                if (_grantedExtensions.Contains(extensionId))
                {
                    var config = _extensionValues.TryGetValue(extensionId, out var value)
                        ? value
                        : new JsonObject();
                    response = await Http.PutAsJsonAsync(path, config);
                }
                else
                {
                    response = await Http.DeleteAsync(path);
                }

                if (!response.IsSuccessStatusCode)
                {
                    _error = $"Extension save failed: {response.StatusCode}";
                    return;
                }
                _dirtyExtensions.Remove(extensionId);
            }
        }
        catch (Exception ex)
        {
            _error = $"Extension save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveModel()
    {
        if (string.IsNullOrEmpty(_selectedModel) || RestClient.ApiBaseUrl is null)
            return;

        _saving = true;
        _error = null;

        try
        {
            var payload = new { model = _selectedModel };
            var response = await Http.PutAsJsonAsync($"{RestClient.ApiBaseUrl}agents/{AgentId}", payload);
            if (response.IsSuccessStatusCode)
            {
                if (_descriptor is not null)
                {
                    _descriptor = _descriptor with { ModelId = _selectedModel };
                    RebuildSnapshot(_context, _contextUnavailable);
                }
            }
            else
            {
                _error = $"Save failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class EffectiveAgentConfigResponse
    {
        public string? AgentId { get; init; }
        public bool DefaultsApplied { get; init; }
        public Dictionary<string, string>? Sources { get; init; }
    }
}
