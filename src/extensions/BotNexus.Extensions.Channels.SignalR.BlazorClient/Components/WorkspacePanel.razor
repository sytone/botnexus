@inject IGatewayRestClient GatewayRestClient
@inject IJSRuntime JS
@implements IDisposable

<div id="@_containerId" class="workspace-panel @MobilePaneClass" data-testid="workspace-panel">
    <section class="workspace-tree-pane">
        @if (_isLoadingRoot && !_directoryResponses.ContainsKey(string.Empty))
        {
            <div class="workspace-state">Loading workspace…</div>
        }
        else if (!string.IsNullOrWhiteSpace(_rootError) && !_directoryResponses.ContainsKey(string.Empty))
        {
            <div class="workspace-state workspace-state-error">@_rootError</div>
        }
        else
        {
            <WorkspaceFileTree Entries="@GetDirectoryEntries(string.Empty)"
                               ExpandedPaths="_expandedDirectories"
                               SelectedFilePath="@_selectedFilePath"
                               OnDirectoryToggled="ToggleDirectoryAsync"
                               OnFileSelected="SelectFileAsync"
                               OnDeleteRequested="RequestDeleteAsync"
                               DirectoryEntriesProvider="GetDirectoryEntries"
                               DirectoryLoadingProvider="IsDirectoryLoading"
                               DirectoryErrorProvider="GetDirectoryError" />
        }
    </section>

    <div class="panel-splitter" role="separator" aria-orientation="vertical" aria-label="Resize workspace panels" title="Drag to resize"></div>

    <section class="workspace-viewer-pane">
        <WorkspaceFileViewer IsLoading="_isLoadingFile"
                             ErrorMessage="@_selectedFileError"
                             FileResponse="@_selectedFile"
                             ShowBackButton="@_showMobileViewer"
                             BackRequested="ShowTreeOnMobile"
                             IsEditing="_isEditing"
                             EditContent="@_editContent"
                             OnEditRequested="BeginEdit"
                             OnSaveRequested="SaveEditAsync"
                             OnDiscardRequested="DiscardEdit"
                             OnEditContentChanged="OnEditContentChanged" />
    </section>

    @if (_deleteConfirmPath is not null)
    {
        <div class="workspace-delete-confirm" role="dialog" aria-modal="true" aria-labelledby="workspace-delete-title">
            <div class="workspace-delete-confirm-box">
                <span id="workspace-delete-title" class="sr-only">Confirm deletion</span>
                @if (_deleteIsNonEmptyDir)
                {
                    <p class="workspace-delete-warning">
                        <Icon Name="warning" Size="15" /> <strong>@_deleteConfirmPath</strong> is a non-empty directory. All contents will be permanently deleted.
                    </p>
                }
                else
                {
                    <p>Delete <strong>@_deleteConfirmPath</strong>? This cannot be undone.</p>
                }
                <div class="workspace-delete-confirm-actions">
                    <button type="button" class="workspace-btn workspace-btn-danger" @onclick="ConfirmDeleteAsync">
                        @(_deleteIsNonEmptyDir ? "Delete All" : "Delete")
                    </button>
                    <button type="button" class="workspace-btn" @onclick="CancelDelete">Cancel</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_deleteError))
                {
                    <p class="workspace-state workspace-state-error">@_deleteError</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly Dictionary<string, WorkspaceResponseDto> _directoryResponses = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedDirectories = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _loadingDirectories = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _directoryErrors = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _cts = new();
    private bool _isLoadingRoot = true;
    private bool _isLoadingFile;
    private string? _rootError;
    private string? _selectedFilePath;
    private WorkspaceResponseDto? _selectedFile;
    private string? _selectedFileError;
    private bool _showMobileViewer;

    // Edit state
    private bool _isEditing;
    private string? _editContent;

    // Delete state
    private string? _deleteConfirmPath;
    private bool _deleteIsNonEmptyDir;
    private string? _deleteError;

    // Issue #345: turn-end refresh tracking
    private bool _wasStreaming;
    private bool _refreshRunning;
    private bool _refreshPending;
    private bool _disposed;
    private readonly HashSet<string> _staleDirectories = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, TaskCompletionSource<bool>> _directoryRequests = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Optional state store for turn-end auto-refresh (issue #345).</summary>
    [Parameter]
    public IClientStateStore? Store { get; set; }

    [Parameter, EditorRequired]
    public string AgentId { get; set; } = default!;

    private string _containerId => $"workspace-panel-{AgentId}";
    private string _storageKey => $"bn-workspace-tree-width-{AgentId}";

    private string MobilePaneClass => _showMobileViewer ? "mobile-viewer" : "mobile-tree";

    protected override async Task OnInitializedAsync()
    {
        if (Store is not null)
        {
            _wasStreaming = Store.GetAgent(AgentId)?.IsStreaming == true;
            Store.OnChanged += HandleStateChanged;
        }
        await RefreshWorkspaceAsync(initialLoad: true);
    }

    private void HandleStateChanged()
    {
        if (_disposed) return;
        var agent = Store?.GetAgent(AgentId);
        if (agent is null) return;

        // Capture the notification before dispatch; the store may contain the next
        // streaming edge by the time the renderer processes this callback.
        var isStreaming = agent.IsStreaming;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            var turnEnded = _wasStreaming && !isStreaming;
            _wasStreaming = isStreaming;
            if (turnEnded)
                await RefreshWorkspaceAsync();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_disposed)
        {
            await JS.InvokeVoidAsync("BotNexus.splitter.init", _containerId, _storageKey, 560, 200, 0.7, 0.5);
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        if (Store is not null)
            Store.OnChanged -= HandleStateChanged;
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task RefreshWorkspaceAsync(bool initialLoad = false)
    {
        if (_disposed) return;
        if (_refreshRunning)
        {
            _refreshPending = true;
            return;
        }

        _refreshRunning = true;
        try
        {
            do
            {
                _refreshPending = false;
                // Closed branches retain their last listing, but must refetch on reopen.
                foreach (var path in _directoryResponses.Keys.Concat(_directoryRequests.Keys)
                    .Distinct(StringComparer.OrdinalIgnoreCase).ToArray())
                {
                    // A request started before this turn ended cannot certify the
                    // post-turn listing, even when its directory is still open.
                    if (path.Length > 0 && (!IsVisibleDirectory(path) || _directoryRequests.ContainsKey(path)))
                        InvalidateDirectory(path);
                }

                _isLoadingRoot = true;
                _rootError = null;
                await LoadDirectoryAsync(string.Empty, isRoot: true);
                if (_disposed) return;
                _isLoadingRoot = false;
                StateHasChanged();

                if (!initialLoad)
                {
                    var refreshed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    while (!_disposed)
                    {
                        // Re-evaluate after every await: never restore expansion over
                        // clicks made while a directory response was pending.
                        var path = _expandedDirectories
                            .Where(path => !refreshed.Contains(path) && IsVisibleDirectory(path))
                            .OrderBy(path => path.Count(c => c == '/'))
                            .ThenBy(path => path, StringComparer.OrdinalIgnoreCase)
                            .FirstOrDefault();
                        if (path is null) break;
                        refreshed.Add(path);
                        await LoadDirectoryAsync(path, isRoot: false);
                        if (!_disposed) StateHasChanged();
                    }
                }
                initialLoad = false;
            } while (!_disposed && _refreshPending);
        }
        finally
        {
            if (!_disposed) _refreshRunning = false;
        }
    }

    private bool IsVisibleDirectory(string path) =>
        _expandedDirectories.Contains(path) && IsReachableDirectory(path, requireExpandedParents: true);

    private bool IsReachableDirectory(string path, bool requireExpandedParents = false)
    {
        if (path.Length == 0) return true;
        var parent = GetParentPath(path);
        return (parent.Length == 0 || ((!requireExpandedParents || _expandedDirectories.Contains(parent))
                && IsReachableDirectory(parent, requireExpandedParents)))
            && GetDirectoryEntries(parent).Any(entry =>
                string.Equals(entry.Type, "directory", StringComparison.OrdinalIgnoreCase)
                && string.Equals(BuildPath(parent, entry.Name), path, StringComparison.OrdinalIgnoreCase));
    }

    private void InvalidateDirectory(string path)
    {
        _staleDirectories.Add(path);
        // Ownership prevents late expansion/refresh responses from restoring a
        // collapsed/removed branch or overwriting a newer deletion reload.
        if (_directoryRequests.Remove(path, out var request))
            request.TrySetResult(false);
        _loadingDirectories.Remove(path);
    }

    private void RemoveDirectoryBranch(string path)
    {
        foreach (var cachedPath in _directoryResponses.Keys.Concat(_directoryRequests.Keys)
            .Concat(_expandedDirectories).Concat(_staleDirectories).Concat(_directoryErrors.Keys)
            .Where(candidate => string.Equals(candidate, path, StringComparison.OrdinalIgnoreCase)
                || candidate.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray())
        {
            InvalidateDirectory(cachedPath);
            _directoryResponses.Remove(cachedPath);
            _directoryErrors.Remove(cachedPath);
            _expandedDirectories.Remove(cachedPath);
            _staleDirectories.Remove(cachedPath);
        }
    }

    private async Task ToggleDirectoryAsync(string directoryPath)
    {
        if (_disposed) return;
        if (_expandedDirectories.Contains(directoryPath))
        {
            _expandedDirectories.Remove(directoryPath);
            foreach (var path in _directoryResponses.Keys.Concat(_directoryRequests.Keys)
                .Append(directoryPath).Distinct(StringComparer.OrdinalIgnoreCase).ToArray())
            {
                if (string.Equals(path, directoryPath, StringComparison.OrdinalIgnoreCase)
                    || path.StartsWith(directoryPath + "/", StringComparison.OrdinalIgnoreCase))
                    InvalidateDirectory(path);
            }
            return;
        }

        _expandedDirectories.Add(directoryPath);
        if (_directoryResponses.ContainsKey(directoryPath) && !_staleDirectories.Contains(directoryPath))
            return;

        await LoadDirectoryAsync(directoryPath, isRoot: false);
        // Descendants can remain expanded beneath a collapsed ancestor. Reload
        // their stale listings in order when that ancestor becomes visible again.
        var attempted = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        while (!_disposed && IsVisibleDirectory(directoryPath))
        {
            var child = _staleDirectories
                .Where(path => path.StartsWith(directoryPath + "/", StringComparison.OrdinalIgnoreCase)
                    && !attempted.Contains(path) && IsVisibleDirectory(path))
                .OrderBy(path => path.Count(c => c == '/')).FirstOrDefault();
            if (child is null) break;
            attempted.Add(child);
            await LoadDirectoryAsync(child, isRoot: false);
        }
    }

    private async Task SelectFileAsync(string filePath)
    {
        if (_disposed) return;
        var cancellationToken = _cts.Token;
        // Cancel edit if selecting a different file
        if (_isEditing && !string.Equals(_selectedFilePath, filePath, StringComparison.OrdinalIgnoreCase))
            DiscardEdit();

        _selectedFilePath = filePath;
        _selectedFile = null;
        _selectedFileError = null;
        _isLoadingFile = true;

        try
        {
            var response = await GatewayRestClient.GetWorkspaceAsync(AgentId, filePath, cancellationToken)
                .WaitAsync(cancellationToken);
            if (_disposed) return;
            if (response is null)
            {
                _selectedFileError = "Unable to load file content.";
                return;
            }

            if (!string.Equals(response.Type, "file", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(response.Type, "text", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(response.Type, "binary", StringComparison.OrdinalIgnoreCase))
            {
                _selectedFileError = "Selected item is not a file.";
                return;
            }

            _selectedFile = response;
            _showMobileViewer = true;
        }
        catch (OperationCanceledException)
        {
            // Navigation away/dispose path.
        }
        catch (Exception)
        {
            if (!_disposed) _selectedFileError = "Unable to load file content.";
        }
        finally
        {
            if (!_disposed) _isLoadingFile = false;
        }
    }

    private async Task LoadDirectoryAsync(string path, bool isRoot)
    {
        if (_disposed || !IsReachableDirectory(path)) return;
        var cancellationToken = _cts.Token;
        if (_directoryRequests.TryGetValue(path, out var existing))
        {
            try { await existing.Task.WaitAsync(cancellationToken); }
            catch (OperationCanceledException) { }
            return;
        }

        var request = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        _directoryRequests[path] = request;
        _loadingDirectories.Add(path);
        _directoryErrors.Remove(path);

        bool OwnsRequest() => !_disposed
            && _directoryRequests.TryGetValue(path, out var current) && ReferenceEquals(current, request);

        try
        {
            var requestPath = string.IsNullOrWhiteSpace(path) ? null : path;
            var response = await GatewayRestClient.GetWorkspaceAsync(AgentId, requestPath, cancellationToken)
                .WaitAsync(cancellationToken);
            if (!OwnsRequest() || !IsReachableDirectory(path)) return;
            if (response is null || !string.Equals(response.Type, "directory", StringComparison.OrdinalIgnoreCase))
            {
                SetDirectoryError(path, isRoot);
                return;
            }

            _directoryResponses[path] = response;
            _staleDirectories.Remove(path);
            foreach (var child in _directoryResponses.Keys.Concat(_directoryRequests.Keys)
                .Concat(_expandedDirectories).Where(child => child.Length > 0 && !IsReachableDirectory(child))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToArray())
                RemoveDirectoryBranch(child);
        }
        catch (OperationCanceledException)
        {
            // Navigation away/dispose path.
        }
        catch (Exception)
        {
            if (OwnsRequest()) SetDirectoryError(path, isRoot);
        }
        finally
        {
            if (OwnsRequest())
            {
                _directoryRequests.Remove(path);
                _loadingDirectories.Remove(path);
            }
            request.TrySetResult(true);
        }
    }

    private void SetDirectoryError(string path, bool isRoot)
    {
        const string message = "Unable to load workspace.";
        if (isRoot)
            _rootError = message;
        else
            _directoryErrors[path] = message;
    }

    private IReadOnlyList<WorkspaceEntryDto> GetDirectoryEntries(string path)
    {
        if (_directoryResponses.TryGetValue(path, out var response))
            return response.Entries ?? [];

        return [];
    }

    private bool IsDirectoryLoading(string path) =>
        !_directoryResponses.ContainsKey(path) && _loadingDirectories.Contains(path);

    private string? GetDirectoryError(string path) =>
        !_directoryResponses.ContainsKey(path) && _directoryErrors.TryGetValue(path, out var error) ? error : null;

    private void ShowTreeOnMobile() => _showMobileViewer = false;

    // ── Edit ──────────────────────────────────────────────────────────────────

    private void BeginEdit()
    {
        _isEditing = true;
        _editContent = _selectedFile?.Content ?? string.Empty;
    }

    private void OnEditContentChanged(string value) => _editContent = value;

    private void DiscardEdit()
    {
        _isEditing = false;
        _editContent = null;
    }

    private async Task SaveEditAsync(string content)
    {
        if (_disposed || _selectedFilePath is null || _selectedFile is null)
            return;
        var cancellationToken = _cts.Token;

        try
        {
            var success = await GatewayRestClient.WriteWorkspaceFileAsync(AgentId, _selectedFilePath, content, cancellationToken)
                .WaitAsync(cancellationToken);
            if (_disposed) return;
            if (!success)
            {
                _selectedFileError = "Failed to save file.";
                return;
            }

            _isEditing = false;
            _editContent = null;
            // Reload file to reflect saved state
            await SelectFileAsync(_selectedFilePath);
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!_disposed) _selectedFileError = "Failed to save file.";
        }
    }

    // ── Delete ────────────────────────────────────────────────────────────────

    private void RequestDeleteAsync(string path)
    {
        _deleteConfirmPath = path;
        _deleteError = null;
        // Determine if it's a non-empty directory by checking directory responses
        _deleteIsNonEmptyDir = IsNonEmptyDirectory(path);
    }

    private bool IsNonEmptyDirectory(string path)
    {
        // Check if path is a known directory with children
        if (_directoryResponses.TryGetValue(path, out var dir))
            return dir.Entries?.Count > 0;

        // Check if it appears as a directory entry in parent
        var parentPath = GetParentPath(path);
        var parentEntries = GetDirectoryEntries(parentPath);
        foreach (var entry in parentEntries)
        {
            var entryPath = BuildPath(parentPath, entry.Name);
            if (string.Equals(entryPath, path, StringComparison.OrdinalIgnoreCase)
                && string.Equals(entry.Type, "directory", StringComparison.OrdinalIgnoreCase))
            {
                // It's a directory — assume non-empty unless we know it has no children
                if (_directoryResponses.TryGetValue(path, out var loaded))
                    return loaded.Entries?.Count > 0;
                // Not yet loaded — be safe and show warning
                return true;
            }
        }

        return false;
    }

    private void CancelDelete()
    {
        _deleteConfirmPath = null;
        _deleteError = null;
        _deleteIsNonEmptyDir = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_disposed || _deleteConfirmPath is null)
            return;
        var cancellationToken = _cts.Token;

        var pathToDelete = _deleteConfirmPath;
        try
        {
            var success = await GatewayRestClient.DeleteWorkspaceItemAsync(
                AgentId, pathToDelete, force: _deleteIsNonEmptyDir, cancellationToken)
                .WaitAsync(cancellationToken);
            if (_disposed) return;
            if (!success)
            {
                _deleteError = "Delete failed. The server rejected the request.";
                return;
            }

            // Clear viewer if the deleted item was selected
            if (string.Equals(_selectedFilePath, pathToDelete, StringComparison.OrdinalIgnoreCase))
            {
                _selectedFile = null;
                _selectedFilePath = null;
                _selectedFileError = null;
                DiscardEdit();
            }

            // Remove from directory caches
            RemoveDirectoryBranch(pathToDelete);

            // Reload parent directory so the tree reflects the deletion
            var parentPath = GetParentPath(pathToDelete);
            InvalidateDirectory(parentPath);
            await LoadDirectoryAsync(parentPath, isRoot: string.IsNullOrEmpty(parentPath));

            if (!_disposed) CancelDelete();
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            if (!_disposed) _deleteError = "Delete failed unexpectedly.";
        }
    }

    private static string GetParentPath(string path)
    {
        var trimmed = path.TrimEnd('/');
        var lastSlash = trimmed.LastIndexOf('/');
        return lastSlash < 0 ? string.Empty : trimmed[..lastSlash];
    }

    private static string BuildPath(string parent, string name) =>
        string.IsNullOrWhiteSpace(parent) ? name : $"{parent.TrimEnd('/')}/{name}";
}
