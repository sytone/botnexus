@inject IClientStateStore Store
@inject NavigationManager Nav
@implements IDisposable

<div class="agent-panel" data-testid="agent-panel">
    @* #2441: the agent identity row moved into the portal top bar (see AgentIdentity.razor),
       reclaiming a full row for the conversation. The run-state badge is small enough to ride
       along on the tab strip, so the panel now starts directly with the tabs. *@
    <nav class="agent-tab-bar agent-panel-tab-strip" role="tablist" aria-label="Agent sections">
        @foreach (var tab in VisibleTabs)
        {
            <button class="agent-tab agent-panel-tab @(IsActiveTab(tab.Key) ? "active" : "")"
                    data-testid="agent-tab-@tab.Key.ToString().ToLowerInvariant()"
                    data-tab="@tab.Key.ToString().ToLowerInvariant()"
                    role="tab"
                    aria-selected="@IsActiveTab(tab.Key)"
                    aria-controls="@GetPanelId(tab.Key)"
                    title="@tab.Hint"
                    @onclick="() => SelectTab(tab.Key)">
                <span class="agent-tab-icon"><Icon Name="@tab.Icon" Size="@IconSize.Small" /></span>
                <span class="agent-tab-label">@tab.Label</span>
            </button>
        }
        <span class="agent-panel-status @StatusCssClass" role="status" aria-live="polite">@StatusLabel</span>
    </nav>

    <div class="agent-tab-content">
        <section id="@GetPanelId(AgentPanelTab.Conversation)"
                 data-testid="agent-panel-conversation"
                 class="agent-tab-pane @(IsActiveTab(AgentPanelTab.Conversation) ? "active" : "")"
                 role="tabpanel">
            <ChatPanel AgentId="@AgentId" ConversationId="@EffectiveConversationId" />
        </section>

        @if (!IsSubAgent)
        {
        <section id="@GetPanelId(AgentPanelTab.Workspace)"
                 class="agent-tab-pane @(IsActiveTab(AgentPanelTab.Workspace) ? "active" : "")"
                 role="tabpanel">
            <WorkspacePanel AgentId="@AgentId" Store="Store" />
        </section>
        }

        @if (!IsSubAgent)
        {
        <section id="@GetPanelId(AgentPanelTab.Reports)"
                 class="agent-tab-pane @(IsActiveTab(AgentPanelTab.Reports) ? "active" : "")"
                 role="tabpanel">
            <ReportsPanel AgentId="@AgentId" Store="Store" />
        </section>
        }

        <section id="@GetPanelId(AgentPanelTab.Canvas)"
                 data-testid="agent-panel-canvas"
                 class="agent-tab-pane @(IsActiveTab(AgentPanelTab.Canvas) ? "active" : "")"
                 role="tabpanel">
            <CanvasPanel AgentId="@AgentId" ConversationId="@EffectiveConversationId" />
        </section>

        <section id="@GetPanelId(AgentPanelTab.Todo)"
                 data-testid="agent-panel-todo"
                 class="agent-tab-pane @(IsActiveTab(AgentPanelTab.Todo) ? "active" : "")"
                 role="tabpanel">
            <TodoPanel AgentId="@AgentId" ConversationId="@EffectiveConversationId" />
        </section>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string AgentId { get; set; } = default!;

    /// <summary>
    /// #2976: the conversation named by the ROUTE, when the URL carries a conversation segment.
    /// The canvas pane must show the routed conversation's canvas, because a deep link is exactly
    /// the case where the agent's active conversation has since moved on and a silent wrong-canvas
    /// render is worse than no canvas. Null when the route is agent-only
    /// (<c>/agent/{AgentId}</c>), in which case the pre-#2976 active-conversation behaviour and the
    /// agent-level legacy fallback below it are preserved unchanged.
    /// </summary>
    [Parameter]
    public string? RoutedConversationId { get; set; }

    /// <summary>
    /// Resolves which conversation the per-conversation panes bind to. #3062 extends this from the
    /// canvas pane alone to the chat and todo panes, so a deep link can no longer render the routed
    /// conversation's canvas beside a different conversation's transcript and checklist.
    ///
    /// The routed id is honoured ONLY when it belongs to THIS agent. That guard is load-bearing, not
    /// defensive padding: Home.razor renders one AgentPanel per agent in Store.Agents, while the route
    /// names a single agent, and CanvasPanel resolves HTML via IClientStateStore.GetConversation which
    /// searches EVERY agent's conversation map. Passing the routed id down unconditionally would make
    /// every other agent's panel resolve and render the routed agent's canvas. Ownership is checked
    /// against this agent's own Conversations map, so a stale or hand-edited URL naming a foreign
    /// conversation falls back rather than leaking another agent's canvas.
    /// </summary>
    private string? EffectiveConversationId
    {
        get
        {
            var agent = Agent;
            if (RoutedConversationId is { Length: > 0 } routed &&
                agent?.Conversations.ContainsKey(routed) == true)
            {
                return routed;
            }

            return agent?.ActiveConversationId;
        }
    }

    private AgentPanelTab _activeTab = AgentPanelTab.Conversation;
    // Track whether the agent was a sub-agent last time we checked, so we can
    // re-apply tab suppression when agent data arrives after the URL tab was set.
    private bool? _lastIsSubAgent;

    private AgentState? Agent => Store.GetAgent(AgentId);
    private string StatusLabel => Agent?.IsConnected != true ? "Offline" : Agent?.IsStreaming == true ? "Running" : "Idle";
    private string StatusCssClass => Agent?.IsConnected != true ? "offline" : Agent?.IsStreaming == true ? "running" : "idle";

    private static readonly (AgentPanelTab Key, string Label, string Icon, string Hint)[] s_tabs =
    [
        (AgentPanelTab.Conversation, "Conversation", "conversation", "Chat with this agent"),
        (AgentPanelTab.Workspace, "Workspace", "workspace", "Files this agent can read and write"),
        (AgentPanelTab.Reports, "Reports", "reports", "Reports this agent has produced"),
        (AgentPanelTab.Canvas, "Canvas", "canvas", "Shared canvas for this conversation"),
        (AgentPanelTab.Todo, "Todo", "todo", "This agent's task list")
    ];

    private AgentState? CurrentAgent => Store.GetAgent(AgentId);
    // #2248: sub-agent classification keys on the IMMUTABLE IsObserverAgent kind, NOT the mutable
    // SessionType. A real user agent whose SessionType was stamped "agent-subagent" by an inbound
    // session event must NOT have its Workspace/Reports tabs suppressed — only genuine sub-agent
    // observer entries are.
    private bool IsSubAgent => CurrentAgent?.IsObserverAgent == true;
    private IEnumerable<(AgentPanelTab Key, string Label, string Icon, string Hint)> VisibleTabs =>
        IsSubAgent ? s_tabs.Where(t => t.Key != AgentPanelTab.Workspace && t.Key != AgentPanelTab.Reports) : s_tabs;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        Store.OnChanged += HandleStoreChanged;
        ApplyTabFromUri(Nav.Uri);
        _lastIsSubAgent = CurrentAgent is not null ? IsSubAgent : null;
    }

    protected override void OnParametersSet()
    {
        ApplyTabFromUri(Nav.Uri);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        Store.OnChanged -= HandleStoreChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var previous = _activeTab;
        ApplyTabFromUri(e.Location);
        if (previous != _activeTab)
            _ = InvokeAsync(StateHasChanged);
    }

    // Re-apply tab when agent data first arrives (or changes) so sub-agent
    // suppression is applied correctly even if agent was null at URL parse time.
    // Store.OnChanged is Action (not Func<Task>) so this must be void.
    private void HandleStoreChanged()
    {
        var currentIsSubAgent = CurrentAgent is not null ? IsSubAgent : (bool?)null;
        // #3084: this early-out lost its `return;` in a reformat, so the `if` bound to the
        // assignment below and control fell through on every store notification. The braces are
        // deliberate: an empty-bodied `if` is legal C# and neither the compiler nor review can see
        // the difference.
        if (currentIsSubAgent == _lastIsSubAgent)
        {
            return;
        }

        _lastIsSubAgent = currentIsSubAgent;

        // If agent data just arrived, re-apply tab from URL so the correct
        // tab is shown without waiting for a navigation event.
        var previous = _activeTab;
        ApplyTabFromUri(Nav.Uri);
        if (previous != _activeTab)
            _ = InvokeAsync(StateHasChanged);
    }

    private bool IsActiveTab(AgentPanelTab tab) => _activeTab == tab;

    private string GetPanelId(AgentPanelTab tab) => $"{AgentId}-{tab.ToString().ToLowerInvariant()}-panel";

    private void SelectTab(AgentPanelTab tab)
    {
        _activeTab = tab;
        var tabValue = tab == AgentPanelTab.Conversation
            ? null
            : tab.ToString().ToLowerInvariant();
        var target = Nav.GetUriWithQueryParameter("tab", tabValue);
        if (!string.Equals(target, Nav.Uri, StringComparison.Ordinal))
            Nav.NavigateTo(target, replace: true);
    }

    private void ApplyTabFromUri(string uri)
    {
        var tabValue = GetQueryValue(new Uri(uri).Query, "tab");
        if (string.IsNullOrWhiteSpace(tabValue))
        {
            _activeTab = AgentPanelTab.Conversation;
            return;
        }

        if (TryParseTab(tabValue, out var parsed))
        {
            // Only suppress Workspace/Reports for sub-agents when agent data is already
            // available. If the agent hasn't loaded yet, preserve the requested tab;
            // HandleStoreChanged will re-apply suppression once data arrives.
            if (CurrentAgent is not null && IsSubAgent &&
                (parsed == AgentPanelTab.Workspace || parsed == AgentPanelTab.Reports))
            {
                _activeTab = AgentPanelTab.Conversation;
            }
            else
            {
                _activeTab = parsed;
            }
        }
    }

    private static string? GetQueryValue(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query))
            return null;

        foreach (var segment in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = segment.Split('=', 2);
            if (parts.Length == 0)
                continue;

            var currentKey = Uri.UnescapeDataString(parts[0]);
            if (!string.Equals(currentKey, key, StringComparison.OrdinalIgnoreCase))
                continue;

            return parts.Length == 2 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
        }

        return null;
    }

    private static bool TryParseTab(string value, out AgentPanelTab tab)
    {
        tab = value.ToLowerInvariant() switch
        {
            "conversation" => AgentPanelTab.Conversation,
            "workspace" => AgentPanelTab.Workspace,
            "reports" => AgentPanelTab.Reports,
            "canvas" => AgentPanelTab.Canvas,
            "todo" => AgentPanelTab.Todo,
            _ => AgentPanelTab.Conversation
        };

        return value.Equals("conversation", StringComparison.OrdinalIgnoreCase)
               || value.Equals("workspace", StringComparison.OrdinalIgnoreCase)
               || value.Equals("reports", StringComparison.OrdinalIgnoreCase)
               || value.Equals("canvas", StringComparison.OrdinalIgnoreCase)
               || value.Equals("todo", StringComparison.OrdinalIgnoreCase);
    }

    private enum AgentPanelTab
    {
        Conversation,
        Workspace,
        Reports,
        Canvas,
        Todo
    }
}
