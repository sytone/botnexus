@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

@*
    Platform stats section (issue #1692). A small, self-contained read-only panel that polls the
    platform-wide stats endpoint and surfaces live in-flight work: active agent loops and active
    sub-agents, with peak / total-completed loop counters for context. Kept deliberately minimal so
    it can sit on the portal dashboard without pulling in extra services - it talks to /api/stats
    directly via HttpClient and refreshes on a light timer while mounted.
*@

<section class="platform-stats-panel" data-testid="platform-stats-panel">
    <h3 class="platform-stats-title">Platform</h3>

    @if (_loadError)
    {
        <div class="platform-stats-error" data-testid="platform-stats-error">Unable to load platform stats.</div>
    }
    else
    {
        <div class="platform-stats-grid">
            <div class="platform-stat" data-testid="stat-active-loops">
                <button type="button"
                        class="platform-stat-disclosure"
                        data-testid="active-loops-toggle"
                        aria-expanded="@(_loopsExpanded ? "true" : "false")"
                        aria-controls="active-loop-details"
                        @onclick="ToggleLoops">
                    <span class="platform-stat-value">@_stats.ActiveAgentLoops</span>
                    <span class="platform-stat-label">Active agent loops</span>
                    <span class="platform-stat-chevron" aria-hidden="true">@(_loopsExpanded ? "\u25be" : "\u25b8")</span>
                </button>
            </div>
            <div class="platform-stat" data-testid="stat-active-subagents">
                <span class="platform-stat-value">@_stats.ActiveSubAgents</span>
                <span class="platform-stat-label">Active sub-agents</span>
            </div>
            <div class="platform-stat" data-testid="stat-peak-loops">
                <span class="platform-stat-value">@_stats.PeakAgentLoops</span>
                <span class="platform-stat-label">Peak loops</span>
            </div>
            <div class="platform-stat" data-testid="stat-total-loops">
                <span class="platform-stat-value">@_stats.TotalCompletedLoops</span>
                <span class="platform-stat-label">Completed loops</span>
            </div>
        </div>
        @if (_loopsExpanded)
        {
            <div id="active-loop-details" class="platform-loop-details" data-testid="active-loop-details" role="region" aria-label="Active agent loop details">
                @if (!_loaded)
                {
                    <div class="platform-loop-loading" data-testid="active-loop-loading">Loading active loops...</div>
                }
                else if (_stats.ActiveLoopDetails.Count == 0)
                {
                    <div class="platform-loop-empty" data-testid="active-loop-empty">No agent loops are currently running.</div>
                }
                else
                {
                    <ul class="platform-loop-list">
                        @foreach (var loop in _stats.ActiveLoopDetails)
                        {
                            <li class="platform-loop-row" data-testid="active-loop-row">
                                @if (!string.IsNullOrWhiteSpace(loop.ConversationId) && !string.IsNullOrWhiteSpace(loop.AgentId))
                                {
                                    <button type="button"
                                            class="platform-loop-link"
                                            data-testid="active-loop-link"
                                            data-conversation-id="@loop.ConversationId"
                                            @onclick="() => NavigateToLoop(loop)">
                                        <span class="platform-loop-agent">@(loop.AgentId)</span>
                                        <span class="platform-loop-conversation">@loop.ConversationId</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="platform-loop-agent">@(string.IsNullOrWhiteSpace(loop.AgentId) ? "(unknown agent)" : loop.AgentId)</span>
                                    <span class="platform-loop-conversation">@(string.IsNullOrWhiteSpace(loop.ConversationId) ? "(no conversation)" : loop.ConversationId)</span>
                                }
                                <span class="platform-loop-age" data-testid="active-loop-age" title="@loop.StartedAtUtc.ToString("u")">@FormatAge(loop.StartedAtUtc)</span>
                            </li>
                        }
                    </ul>
                }
                @if (_refreshError)
                {
                    <div class="platform-loop-stale" data-testid="active-loop-refresh-error">Refresh failed - showing last known loops.</div>
                }
            </div>
        }
    }
</section>

@code {
    // Poll cadence for the live counts. Short enough to feel live, long enough to stay cheap.
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private PlatformStats _stats = new();
    private bool _loadError;
    private bool _refreshError;
    private bool _loaded;
    // Disclosure state is component-owned and never reset by a poll, so a refresh cannot collapse
    // the operator's chosen view (AC5).
    private bool _loopsExpanded;
    private Timer? _timer;

    private void ToggleLoops() => _loopsExpanded = !_loopsExpanded;

    private void NavigateToLoop(ActiveLoopDetail loop)
    {
        if (string.IsNullOrWhiteSpace(loop.AgentId) || string.IsNullOrWhiteSpace(loop.ConversationId))
            return;
        Nav.NavigateTo($"/chat/{Uri.EscapeDataString(loop.AgentId)}/{Uri.EscapeDataString(loop.ConversationId)}");
    }

    private static string FormatAge(DateTimeOffset startedAtUtc)
    {
        var age = DateTimeOffset.UtcNow - startedAtUtc;
        if (age < TimeSpan.Zero)
            age = TimeSpan.Zero;
        if (age.TotalMinutes < 1)
            return $"{(int)age.TotalSeconds}s";
        if (age.TotalHours < 1)
            return $"{(int)age.TotalMinutes}m {age.Seconds}s";
        return $"{(int)age.TotalHours}h {age.Minutes}m";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // Periodic refresh while the panel is mounted. The callback marshals back onto the renderer
        // via InvokeAsync; the CTS guards against a fetch outliving disposal.
        _timer = new Timer(_ => _ = RefreshAsync(), null, RefreshInterval, RefreshInterval);
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        try
        {
            var stats = await Http.GetFromJsonAsync<PlatformStats>("api/stats", _cts.Token);
            if (stats is not null)
            {
                _stats = stats;
                _loadError = false;
                _refreshError = false;
                _loaded = true;
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed / navigated away mid-request - nothing to surface.
        }
        catch (Exception)
        {
            // A first-load failure blanks the panel; a later failure keeps the last known rows on
            // screen and flags them as stale rather than throwing the operator's view away (AC5).
            if (_loaded)
                _refreshError = true;
            else
                _loadError = true;
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }

    /// <summary>
    /// Local view model mirroring the gateway's PlatformStatsDto. Defaults to zeros so the panel
    /// renders a stable idle state before the first fetch resolves.
    /// </summary>
    private sealed class PlatformStats
    {
        public int ActiveAgentLoops { get; set; }
        public int PeakAgentLoops { get; set; }
        public long TotalCompletedLoops { get; set; }
        public int ActiveSubAgents { get; set; }
        public List<ActiveLoopDetail> ActiveLoopDetails { get; set; } = [];
    }

    /// <summary>Per-loop operator detail mirroring the gateway's ActiveLoopDetailDto.</summary>
    private sealed class ActiveLoopDetail
    {
        public string LoopId { get; set; } = "";
        public string? AgentId { get; set; }
        public string? ConversationId { get; set; }
        public string? SessionId { get; set; }
        public DateTimeOffset StartedAtUtc { get; set; }
    }
}
