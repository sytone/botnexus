@inject IClientStateStore Store
@inject NavigationManager Nav
@inject IServiceProvider Services
@implements IDisposable

<div class="agent-dashboard">
    @if (!Store.Agents.Any())
    {
        <div class="agent-dashboard-empty">
            <p>No agents registered. Add agents to the gateway configuration to get started.</p>
        </div>
    }
    else
    {
        <div class="agent-card-grid">
            @foreach (var (agentId, agent) in OrderedAgents())
            {
                <div class="agent-card @(agent.IsStreaming ? "agent-card--active" : "")"
                     data-testid="agent-card"
                     data-agent-id="@agentId"
                     @onclick="() => NavigateToAgent(agent)">
                    @* The card's own click opens the agent, which is its primary action and stays
                       that way. The IDENTITY - avatar and name - opens the persona panel instead,
                       matching the top-bar chip exactly, so "click an agent's identity to edit who
                       it is" is one rule rather than two places that behave differently.
                       stopPropagation is what keeps the two from firing together. *@
                    <button type="button"
                            class="agent-card-header agent-card-persona-trigger"
                            data-testid="agent-card-persona-trigger"
                            data-agent-id="@agentId"
                            aria-haspopup="dialog"
                            aria-label="@($"Edit {agent.DisplayName}'s persona")"
                            title="Edit this agent's persona"
                            @onclick="() => OpenPersona(agent.AgentId)"
                            @onclick:stopPropagation="true">
                        @{ var activity = AgentActivityModel.For(agent.IsConnected, agent.IsStreaming, agent.ActiveToolCallCount, agent.IsReadOnly); }
                        <AgentAvatar AgentId="@agent.AgentId" DisplayName="@agent.DisplayName" Emoji="@agent.Emoji" Hue="@agent.AvatarHue" Activity="@activity" Class="agent-card-emoji avatar-lg" />
                        <span class="agent-card-identity">
                            <span class="agent-card-name">@agent.DisplayName</span>
                            @* The label stays. The dot is a colour and a shape, and colour alone is
                               not an accessible signal - it makes the state scannable, not readable. *@
                            <span class="agent-card-status status-@activity.CssModifier"
                                  data-testid="agent-card-status">@activity.Label</span>
                        </span>
                        <span class="agent-card-persona-chevron" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                <path d="M2.5 4L5 6.5L7.5 4" stroke="currentColor" stroke-width="1.4"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </button>
                    @if (agent.UnreadCount > 0)
                    {
                        <span class="agent-card-unread-badge">@agent.UnreadCount</span>
                    }
                    @* OUTSIDE the identity button, deliberately - the button carries an explicit
                       aria-label, and an aria-label REPLACES inner text for assistive technology,
                       so a role line nested inside it would render, look right, and never be
                       announced (the same trap the chip's activity label hit).

                       Responsibility ABOVE Description because they answer different questions and
                       the roster's question is the first one: Responsibility is one line naming
                       what this agent owns, Description is prose about it. Scanning a wall of
                       cards for "who handles billing" reads the role lines and nothing else. *@
                    @if (!string.IsNullOrWhiteSpace(agent.Responsibility))
                    {
                        <p class="agent-card-responsibility" data-testid="agent-card-responsibility">
                            @PortalText.SingleLine(agent.Responsibility)
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(agent.Description))
                    {
                        <p class="agent-card-description">@agent.Description</p>
                    }
                    @if (agent.CanDelegate)
                    {
                        <div class="agent-card-chips">
                            <span class="agent-card-chip agent-card-chip--delegate"
                                  data-testid="agent-card-delegate-chip"
                                  title="This agent is allowed to spawn sub-agents to work in parallel.">
                                <svg class="agent-card-chip-icon" viewBox="0 0 12 12" fill="none"
                                     stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M3 1v4a2 2 0 0 0 2 2h4M3 5v6" />
                                </svg>
                                Can delegate
                            </span>
                        </div>
                    }
                    <div class="agent-card-stats">
                        <span class="agent-card-stat">
                            @OpenConversationCount(agent) open
                        </span>
                        @if (LastActivity(agent) is { } lastActivity)
                        {
                            <span class="agent-card-stat agent-card-last-activity">@lastActivity</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Store.OnChanged += HandleStateChanged;
    }

    private void HandleStateChanged() =>
        _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Keeps immediately relevant agents easiest to find without making an idle roster unstable:
    /// streaming first, then latest known conversation activity, user agents before built-ins, and
    /// finally a deterministic identity tie-break. Observer entries are projections, not roster
    /// members, so they remain excluded regardless of mutable session telemetry.
    /// </summary>
    private IEnumerable<KeyValuePair<string, AgentState>> OrderedAgents() =>
        Store.Agents
            .Where(a => !a.Value.IsReadOnly)
            .OrderByDescending(a => a.Value.IsStreaming)
            .ThenByDescending(a => LatestActivity(a.Value))
            .ThenBy(a => a.Value.IsBuiltIn)
            .ThenBy(a => AgentLabel(a.Value), StringComparer.OrdinalIgnoreCase)
            .ThenBy(a => a.Key, StringComparer.OrdinalIgnoreCase);

    private static DateTimeOffset LatestActivity(AgentState agent) =>
        agent.Conversations.Values
            .Select(c => c.UpdatedAt)
            .DefaultIfEmpty(DateTimeOffset.MinValue)
            .Max();

    private static string AgentLabel(AgentState agent) =>
        string.IsNullOrWhiteSpace(agent.DisplayName) ? agent.AgentId : agent.DisplayName;


    private IAgentPersonaLauncher? _personaLauncher;

    /// <summary>
    /// Asks the persona panel to open. Resolved rather than injected so an existing fixture that
    /// renders this dashboard without registering the launcher keeps working - clicking the
    /// identity is then simply inert rather than a DI failure.
    /// </summary>
    private void OpenPersona(string agentId) =>
        (_personaLauncher ??= Services.GetService(typeof(IAgentPersonaLauncher)) as IAgentPersonaLauncher)
            ?.Request(agentId);

    private void NavigateToAgent(AgentState agent)
    {
        var mostRecent = agent.Conversations.Values
            .Where(c => c.Status == "Active")
            .OrderByDescending(c => c.UpdatedAt)
            .FirstOrDefault();

        if (mostRecent is not null)
            Nav.NavigateTo($"/chat/{Uri.EscapeDataString(agent.AgentId)}/{Uri.EscapeDataString(mostRecent.ConversationId)}");
        else
            Nav.NavigateTo($"/chat/{Uri.EscapeDataString(agent.AgentId)}");
    }

    private static int OpenConversationCount(AgentState agent) =>
        agent.Conversations.Values.Count(c => c.Status == "Active");

    private static string? LastActivity(AgentState agent)
    {
        var latest = agent.Conversations.Values
            .Where(c => c.UpdatedAt > DateTimeOffset.MinValue)
            .OrderByDescending(c => c.UpdatedAt)
            .Select(c => c.UpdatedAt)
            .Cast<DateTimeOffset?>()
            .FirstOrDefault();

        if (latest is null)
            return null;

        var age = DateTimeOffset.UtcNow - latest.Value;
        return age.TotalSeconds < 60 ? "just now"
            : age.TotalMinutes < 60 ? $"{(int)age.TotalMinutes} min ago"
            : age.TotalHours < 24 ? $"{(int)age.TotalHours}h ago"
            : $"{(int)age.TotalDays}d ago";
    }

    public void Dispose()
    {
        Store.OnChanged -= HandleStateChanged;
    }
}
