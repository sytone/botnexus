@using BotNexus.Extensions.Channels.SignalR.BlazorClient.Services
@inject IClientStateStore Store
@inject IGatewayRestClient Rest
@inject NavigationManager Nav
@implements IDisposable

@* #2898: the conversation cost subsection. Identity (label, origin badge, navigation) is read off
   the composed ActivityRow through the SAME helpers the main activity table calls, so a row's
   label and badge structurally cannot differ between the two surfaces (#2385 one-classifier rule). *@
<div class="activity-cost" data-testid="activity-cost">
    <div class="activity-dashboard-header">
        <h2 class="activity-dashboard-title">Conversation cost</h2>
        <span class="activity-dashboard-subtitle">Conversations ranked by accumulated spend</span>
    </div>

    <div class="activity-filter-bar" role="group" aria-label="Filter conversation cost" data-testid="activity-cost-filter-bar">
        <button type="button"
                class="activity-filter-btn @(_filter.IncludeCron ? "active" : "")"
                data-testid="activity-cost-filter-cron"
                aria-pressed="@_filter.IncludeCron"
                title="Show scheduled (cron) conversations"
                @onclick="ToggleCron">@(_filter.IncludeCron ? "\u2611" : "\u2610") Cron</button>

        <select class="activity-filter-select" data-testid="activity-cost-filter-agent"
                aria-label="Filter by agent"
                value="@(_filter.AgentId ?? "")"
                @onchange="OnAgentFilterChanged">
            <option value="">All agents</option>
            @foreach (var (agentId, agent) in Store.Agents.OrderForDisplay())
            {
                <option value="@agentId">@AgentLabel(agentId)</option>
            }
        </select>

        <select class="activity-filter-select" data-testid="activity-cost-filter-origin"
                aria-label="Filter by origin"
                value="@_filter.Origin"
                @onchange="OnOriginFilterChanged">
            <option value="@ActivityOriginFilter.All">Any origin</option>
            <option value="@ActivityOriginFilter.Human">Human</option>
            <option value="@ActivityOriginFilter.Scheduled">Scheduled</option>
            <option value="@ActivityOriginFilter.Webhook">Webhook</option>
            <option value="@ActivityOriginFilter.Agent">Agent-initiated</option>
            <option value="@ActivityOriginFilter.SubAgent">Sub-agent</option>
            <option value="@ActivityOriginFilter.AgentToAgent">Agent-to-agent</option>
        </select>

        <select class="activity-filter-select" data-testid="activity-cost-filter-recency"
                aria-label="Filter by recency"
                value="@_filter.Recency"
                @onchange="OnRecencyFilterChanged">
            <option value="@ActivityRecencyWindow.Any">Any time</option>
            <option value="@ActivityRecencyWindow.Today">Today</option>
            <option value="@ActivityRecencyWindow.Week">Last 7 days</option>
            <option value="@ActivityRecencyWindow.Month">Last 30 days</option>
        </select>
    </div>

    @if (_isLoading && _rows is null)
    {
        <div class="activity-loading" data-testid="activity-cost-loading">Loading conversation cost&#x2026;</div>
    }
    else if (_loadError)
    {
        <div class="activity-error" data-testid="activity-cost-error">Could not load conversation cost.</div>
    }
    else if (_rows is { Count: 0 })
    {
        <div class="activity-empty" data-testid="activity-cost-empty">
            No conversations match the current filters.
        </div>
    }
    else if (_rows is { } rows)
    {
        <div class="activity-table-scroll" data-testid="activity-cost-table-scroll" tabindex="0" role="region" aria-label="Conversation cost table">
        <table class="activity-table" data-testid="activity-cost-table">
            <thead>
                <tr>
                    <th scope="col">Agent</th>
                    <th scope="col">Conversation</th>
                    <th scope="col">Sessions</th>
                    <th scope="col">Messages</th>
                    <th scope="col">Compactions</th>
                    <th scope="col">Total cost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cost in rows)
                {
                    var row = cost.Row;
                    <tr class="activity-row @(row.IsCron ? "activity-row-cron" : "")"
                        data-testid="activity-cost-row"
                        data-conversation-id="@cost.ConversationId"
                        tabindex="0"
                        role="link"
                        @onclick="() => NavigateToConversation(cost)"
                        @onkeydown="e => OnRowKeyDown(e, cost)">
                        <td class="activity-cell-agents">
                            <span class="activity-agent-chip" data-testid="activity-cost-agent">@AgentLabel(row.OwningAgentId)</span>
                        </td>
                        <td class="activity-cell-title">
                            @* Same ConversationLabel call as the main table's DisplayTitle. *@
                            <span class="activity-conversation-title"
                                  data-testid="activity-cost-title"
                                  title="@row.Title">@DisplayTitle(row)</span>
                            @if (ActivityDashboardProjection.OriginLabel(row) is { } originLabel)
                            {
                                @* Same OriginLabel/OriginModifier helpers as the main table. *@
                                <span class="activity-badge activity-badge-@ActivityDashboardProjection.OriginModifier(row)"
                                      data-testid="activity-cost-origin-badge"
                                      data-origin="@ActivityDashboardProjection.OriginModifier(row)">@originLabel</span>
                            }
                        </td>
                        <td class="activity-cell-channels" data-testid="activity-cost-sessions">@cost.SessionCount</td>
                        <td class="activity-cell-channels" data-testid="activity-cost-messages">@cost.MessageCount</td>
                        <td class="activity-cell-channels @(cost.CompactionSummaryCount is null ? "activity-cost-unmeasured" : "")"
                            data-testid="activity-cost-compactions"
                            data-measured="@Measured(cost.CompactionSummaryCount is not null)">@ActivityCostProjection.FormatCount(cost.CompactionSummaryCount)</td>
                        <td class="activity-cell-channels @(cost.TotalTokens is null ? "activity-cost-unmeasured" : "")"
                            data-testid="activity-cost-total"
                            data-measured="@Measured(cost.TotalTokens is not null)">@ActivityCostProjection.FormatCount(cost.TotalTokens)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private ActivityDashboardFilter _filter = new();
    private IReadOnlyList<ActivityCostRow>? _rows;
    private bool _isLoading;
    private bool _loadError;

    /// <summary>
    /// Reference "now" for the inherited recency window. Injected so the component's ordering is
    /// deterministic under test, mirroring the projection's own injected clock.
    /// </summary>
    [Parameter] public DateTimeOffset? Now { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Store.OnChanged += HandleStateChanged;
        await LoadAsync();
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var conversations = await Rest.GetAllConversationsAsync();
            var costs = await Rest.GetConversationCostsAsync();
            _rows = ActivityCostProjection.Project(conversations, costs, _filter, Now ?? DateTimeOffset.UtcNow);
            _loadError = false;
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilterAsync(ActivityDashboardFilter filter)
    {
        _filter = filter;
        await LoadAsync();
        StateHasChanged();
    }

    private Task ToggleCron() => ApplyFilterAsync(_filter with { IncludeCron = !_filter.IncludeCron });

    private Task OnAgentFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        return ApplyFilterAsync(_filter with { AgentId = string.IsNullOrEmpty(value) ? null : value });
    }

    private Task OnOriginFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityOriginFilter>(e.Value?.ToString(), out var origin))
            return ApplyFilterAsync(_filter with { Origin = origin });
        return Task.CompletedTask;
    }

    private Task OnRecencyFilterChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ActivityRecencyWindow>(e.Value?.ToString(), out var window))
            return ApplyFilterAsync(_filter with { Recency = window });
        return Task.CompletedTask;
    }

    /// <summary>
    /// Navigates using the ROW'S OWN conversation id via the shared target builder (#2898 AC5) -
    /// never an index into the rendered list, so a re-sort cannot redirect a click.
    /// </summary>
    private void NavigateToConversation(ActivityCostRow row) =>
        Nav.NavigateTo(ActivityCostProjection.NavigationTarget(row));

    private void OnRowKeyDown(KeyboardEventArgs e, ActivityCostRow row)
    {
        if (e.Key is "Enter" or " ")
            NavigateToConversation(row);
    }

    /// <summary>
    /// Renders the measured/unmeasured marker as an explicit STRING rather than a bool.
    /// </summary>
    /// <remarks>
    /// Blazor OMITS an attribute whose value is <c>false</c>, so binding a bool here would emit
    /// <c>data-measured</c> only on measured cells and leave the unmeasured ones with no attribute
    /// at all - making "not measured" indistinguishable from "this markup predates the attribute".
    /// That is the very null/zero collapse #2898 AC3 exists to prevent, reappearing one layer down
    /// in the DOM. Emitting the word forces both states to be present and readable.
    /// </remarks>
    private static string Measured(bool measured) => measured ? "true" : "false";

    /// <summary>Identical call to the main activity table's title rendering - one label rule.</summary>
    private static string DisplayTitle(ActivityRow row) =>
        ConversationLabel.DisplayTitle(row.Title, row.ConversationId, row.OwningAgentId);

    /// <summary>Resolve an agent id to its display name via the store, falling back to the raw id.</summary>
    private string AgentLabel(string agentId)
    {
        var agent = Store.GetAgent(agentId);
        if (agent is { DisplayName.Length: > 0 })
            return agent.DisplayName;
        return agentId;
    }

    public void Dispose() => Store.OnChanged -= HandleStateChanged;
}
