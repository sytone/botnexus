    // Loads the user's configured tools from GET /api/tools for the Tools nav section (#2233).
    // The client never throws, returning an empty list on failure so the empty state renders.
    private async Task LoadToolsAsync()
    {
        _tools = (await ToolsApi.ListAsync())
            .OrderBy(t => t.Order)
            .ToList();
    }

    // Loads the effective nav order from GET /api/nav-order for the whole-sidebar ordering model
    // (#2236). On any failure the client returns an empty list, so we keep the built-in default
    // order rather than rendering a broken or empty nav.
    private async Task LoadNavOrderAsync()
    {
        var items = await NavOrderApi.ListAsync();
        if (items.Count > 0)
        {
            _navOrder = items
                .OrderBy(i => i.Order)
                .Select(i => i.Key)
                .ToList();

            // The NUMBERS are kept, not just the resulting sequence: a contributed entry declares
            // an order on the same scale, and slotting it between two built-ins is impossible from
            // a bare list of keys.
            _navOrderNumbers = items.ToDictionary(i => i.Key, i => i.Order, StringComparer.OrdinalIgnoreCase);
        }

        var contributions = await NavOrderApi.ListContributionsAsync();

        // A plugin can hide its own contributed entries. The gateway does not filter them, because
        // the nav endpoint reads loaded EXTENSIONS and knows nothing about which plugin installed
        // which - the ownership link lives on the plugin record, so the join happens here.
        _navContributions = FilterHidden(contributions, await HiddenExtensionIdsAsync());
    }

    /// <summary>
    /// Re-reads contributed nav entries and the hidden set, without touching the built-in order.
    /// </summary>
    private async Task LoadNavContributionsAsync()
    {
        var contributions = await NavOrderApi.ListContributionsAsync();
        _navContributions = FilterHidden(contributions, await HiddenExtensionIdsAsync());
    }

    // The gateway's nav endpoint reads loaded EXTENSIONS and knows nothing about which plugin
    // installed which, so the ownership join happens here.
    private async Task<HashSet<string>> HiddenExtensionIdsAsync()
    {
        if (_pluginsApi is null)
            return new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        return (await _pluginsApi.ListAsync())
            .Where(p => p.NavHidden && !string.IsNullOrWhiteSpace(p.DeployedExtensionId))
            .Select(p => p.DeployedExtensionId!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private static IReadOnlyList<NavContributionDto> FilterHidden(
        IReadOnlyList<NavContributionDto> contributions,
        HashSet<string> hidden) =>
        hidden.Count == 0
            ? contributions
            : contributions.Where(c => !hidden.Contains(c.ExtensionId)).ToList();

    /// <summary>
    /// The sidebar's render list: built-in sections merged with extension-contributed entries by
    /// effective order.
    /// </summary>
    /// <remarks>
    /// Built-ins fall back to their position scaled by ten when the server did not supply numbers,
    /// which matches the gap-of-ten scale the nav-order defaults use, so a contribution declaring
    /// 65 lands between Agents and Cron either way. A contribution tying with a built-in renders
    /// after it: a built-in the user can reorder should not be displaced by a third party.
    /// </remarks>
    private IReadOnlyList<NavRenderEntry> OrderedNavEntries()
    {
        var builtIns = OrderedNavKeys().ToList();
        if (_navContributions.Count == 0)
        {
            return builtIns.Select(k => new NavRenderEntry(k, null)).ToList();
        }

        var ranked = new List<(int Order, int Tie, NavRenderEntry Entry)>(builtIns.Count + _navContributions.Count);
        for (var i = 0; i < builtIns.Count; i++)
        {
            var order = _navOrderNumbers.TryGetValue(builtIns[i], out var known) ? known : (i + 1) * 10;
            ranked.Add((order, 0, new NavRenderEntry(builtIns[i], null)));
        }

        foreach (var contribution in _navContributions)
        {
            ranked.Add((contribution.Order, 1, new NavRenderEntry(contribution.Id, contribution)));
        }

        return ranked
            .OrderBy(r => r.Order)
            .ThenBy(r => r.Tie)
            .Select(r => r.Entry)
            .ToList();
    }

    /// <summary>One sidebar row: either a built-in section or a contributed entry.</summary>
    private sealed record NavRenderEntry(string Key, NavContributionDto? Contribution);

