    private static bool IsUserFacingConversation(ConversationState conversation)
    {
        // #2340: hiding runtime-internal bookkeeping threads reads the first-class, server-stamped,
        // write-once ConversationVisibility instead of probing the conversation id for an "internal:"
        // prefix. That probe was the LAST id-substring test in client rendering code and the sole
        // allowlisted exception to the origin-inference fence, which is now absolute.
        //
        // Visibility is a genuinely separate axis from origin - "who may see it" vs "why it exists"
        // - so it is its own field rather than an overload of Source. InspectableReadOnly rows are
        // deliberately still listed: they are visible-but-not-writable, and write gating is the
        // independent job of ConversationRenderProjection.
        //
        // #3218: the predicate itself now lives in PortalListOrdering so the sidebar list and the
        // cold-start route resolver in Home.razor share ONE definition of "user conversation" and
        // cannot drift into disagreeing about which conversations exist for the user. This is a CALL
        // of that single predicate, not a copy of it.
        return PortalListOrdering.IsUserFacingConversation(conversation);
    }

    // #2305 (epic #2300): grouping derives ONLY from the immutable server-supplied origin signal via
    // the typed projection, plus the authoritative cron-job -> conversation-id mapping returned by
    // the cron API. #3073: both clauses now live in the shared PortalConversationGrouping.IsScheduled
    // so the mobile picker classifies identically; this is a CALL of the single client-wide cron
    // predicate, not a copy of it.
    private bool IsCronConversation(ConversationState c) =>
        PortalConversationGrouping.IsScheduled(c, Store.ActiveSelectionSource, _cronConversationIds);

    // #2122: webhook membership reads the SAME typed projection as the cron check above. There is
    // one classifier (ConversationRenderProjection) and this is a read of it, not a copy of it.
    private bool IsWebhookConversation(ConversationState c) =>
        c.Project(Store.ActiveSelectionSource).Group == ConversationListGroup.Automated;

