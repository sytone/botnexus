    private sealed record SidebarAgentDto(
        string? AgentId = null,
        string DisplayName = "",
        string? Emoji = null);

    private async Task LoadSidebarAgentsAsync()
    {
        try
        {
            var url = Nav.BaseUri.TrimEnd('/') + "/api/agents";
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var items = await Http.GetFromJsonAsync<List<SidebarAgentDto>>(url, opts);
            _sidebarAgents = (items ?? [])
                .Select(a => new SidebarAgentItem(
                    a.AgentId ?? "",
                    PortalText.SingleLine(string.IsNullOrWhiteSpace(a.Emoji) ? a.DisplayName : $"{a.Emoji} {a.DisplayName}")))
                .ToList();
        }
        catch { _sidebarAgents = []; }
    }

    // Loads the user's configured tools from GET /api/tools for the Tools nav section (#2233).
    // The client never throws, returning an empty list on failure so the empty state renders.
    private async Task LoadToolsAsync()
    {
        _tools = (await ToolsApi.ListAsync())
            .OrderBy(t => t.Order)
            .ToList();
    }

    // Loads the effective nav order from GET /api/nav-order for the whole-sidebar ordering model
    // (#2236). On any failure the client returns an empty list, so we keep the built-in default
    // order rather than rendering a broken or empty nav.
    private async Task LoadNavOrderAsync()
    {
        var items = await NavOrderApi.ListAsync();
        if (items.Count > 0)
        {
            _navOrder = items
                .OrderBy(i => i.Order)
                .Select(i => i.Key)
                .ToList();
        }
    }

    // The management UI (#2235) mutates tools through the same ToolsApiClient the nav reads from,
    // so a save/delete raises Changed and the Tools nav section repaints immediately rather than
    // waiting for a full page reload.
    private void HandleToolsChanged() => _ = InvokeAsync(async () =>
    {
        await LoadToolsAsync();
        StateHasChanged();
    });

    private bool IsToolActive(string toolId)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return uri.Equals($"tools/{toolId}", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadCronConversationIdsAsync()
    {
        try
        {
            var (jobs, _) = await CronApi.ListAsync();
            _cronConversationIds = jobs
                .Where(j => !string.IsNullOrEmpty(j.ConversationId))
                .Select(j => j.ConversationId!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch { _cronConversationIds = new(StringComparer.OrdinalIgnoreCase); }
    }

    private static string? ResolveConversationTitle(AgentState agent, string conversationId)
        => agent.Conversations.TryGetValue(conversationId, out var conv) ? conv.Title : conversationId;

    // Sections changed (create/rename/reorder/delete/assign/remove): re-render so the sidebar reflects
    // the new custom grouping. The panel owns its own server-persisted state; the layout just repaints.
    private Task HandleSectionsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

