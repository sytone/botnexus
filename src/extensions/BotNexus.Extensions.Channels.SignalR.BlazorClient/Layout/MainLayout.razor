    /// <summary>
    /// Recent-activity filter applied to the normal (non-pinned, non-scheduled) conversation list.
    /// Lets the user narrow the drawer to conversations touched today or in the last week without
    /// hiding pinned or scheduled groups, which carry their own intent.
    /// </summary>
    private enum ConversationActivityFilter
    {
        None,
        Today,
        ThisWeek
    }

    /// <summary>
    /// True when the conversation's last activity falls inside the active filter window. <see cref="ConversationActivityFilter.None"/>
    /// always matches so the default view is unfiltered. "Today" uses the local calendar day; "This Week" uses a
    /// rolling 7-day window, both compared against <c>UpdatedAt</c>.
    /// </summary>
    private bool MatchesActivityFilter(ConversationState conversation) => _activityFilter switch
    {
        ConversationActivityFilter.Today => conversation.UpdatedAt.ToLocalTime().Date == DateTimeOffset.Now.Date,
        ConversationActivityFilter.ThisWeek => conversation.UpdatedAt >= DateTimeOffset.UtcNow.AddDays(-7),
        _ => true
    };

    private async Task SetActivityFilterAsync(ConversationActivityFilter filter)
    {
        if (_activityFilter == filter)
            return;
        _activityFilter = filter;
        await JS.InvokeVoidAsync("localStorage.setItem", ActivityFilterKey, filter.ToString());
    }



    private RenderFragment RenderConversationItem(AgentState agent, ConversationState conversation) => __builder =>
    {
        <div class="conversation-list-item" data-testid="conversation-list-item" data-conversation-id="@conversation.ConversationId">
            <a class="conversation-list-item-btn @(conversation.ConversationId == agent.ActiveConversationId ? "active" : "")"
               href="agent/@Uri.EscapeDataString(agent.AgentId)/conversation/@Uri.EscapeDataString(conversation.ConversationId)"
               @onclick="() => SelectConversationAsync(agent.AgentId, conversation.ConversationId)"
               @onclick:preventDefault="true">
                <span class="conversation-list-item-main">
                    <span class="conversation-list-item-title" title="@PortalText.SingleLine(conversation.Title)">@PortalText.SingleLine(conversation.Title)</span>

                    @if (conversation.IsDefault)
                    {
                        <span class="conversation-default-badge">Default</span>
                    }
                    @if (GetVirtualConversationBadge(conversation) is { } badge)
                    {
                        <span class="conversation-default-badge">@badge</span>
                    }
                </span>

                <span class="conversation-list-item-meta">
                    @if (conversation.UnreadCount > 0)
                    {
                        <span class="conversation-unread-dot"
                              aria-label="Unread messages"></span>
                    }

                    <span class="conversation-updated-at">
                        @FormatConversationTimestamp(conversation.UpdatedAt)
                    </span>
                </span>
            </a>
            @if (!conversation.IsDefault && !agent.IsReadOnly)
            {
                @* One strip rather than three independently positioned buttons. The old
                   per-button right: offsets were 21.6px apart and never revisited when the
                   buttons gained a 32px minimum hit target, so each overlapped its neighbour
                   and all three sat on the title. Flex + gap cannot drift out of step. *@
                <div class="conversation-row-actions">
                    <button class="conversation-pin-btn @(conversation.IsPinned ? "pinned" : "")" data-testid="conversation-pin-btn"
                            title="@(conversation.IsPinned ? "Unpin conversation" : "Pin conversation to top")"
                            aria-label="@(conversation.IsPinned ? "Unpin conversation" : "Pin conversation to top")"
                            aria-pressed="@(conversation.IsPinned ? "true" : "false")"
                            @onclick:stopPropagation="true"
                            @onclick="() => SetConversationPinnedAsync(agent.AgentId, conversation.ConversationId, !conversation.IsPinned)">
                        <Icon Name="pin" Size="16" />
                    </button>
                    <button class="conversation-archive-btn" data-testid="conversation-archive-btn"
                            title="@(IsUnattendedConversation(conversation) ? "Close conversation \u2014 reopens on next trigger" : "Archive conversation")"
                            @onclick:stopPropagation="true"
                            @onclick="() => ArchiveConversationAsync(agent.AgentId, conversation.ConversationId, conversation.Title, IsUnattendedConversation(conversation))">
                        @* An unattended conversation reopens on its next trigger, so closing it
                           pauses it rather than discarding it. *@
                        <Icon Name="@(IsUnattendedConversation(conversation) ? "pause" : "delete")"
                              Size="16" Class="bn-icon-inherit" />
                    </button>
                </div>
            }
        </div>
    };



    // The menu is a sibling of the actions strip, not a child of it: it positions against
