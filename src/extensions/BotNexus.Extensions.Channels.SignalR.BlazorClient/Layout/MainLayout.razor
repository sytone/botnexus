    /// <summary>
    /// Recent-activity filter applied to the normal (non-pinned, non-scheduled) conversation list.
    /// Lets the user narrow the drawer to conversations touched today or in the last week without
    /// hiding pinned or scheduled groups, which carry their own intent.
    /// </summary>
    private enum ConversationActivityFilter
    {
        None,
        Today,
        ThisWeek
    }

    /// <summary>
    /// True when the conversation's last activity falls inside the active filter window. <see cref="ConversationActivityFilter.None"/>
    /// always matches so the default view is unfiltered. "Today" uses the local calendar day; "This Week" uses a
    /// rolling 7-day window, both compared against <c>UpdatedAt</c>.
    /// </summary>
    private bool MatchesActivityFilter(ConversationState conversation) => _activityFilter switch
    {
        ConversationActivityFilter.Today => conversation.UpdatedAt.ToLocalTime().Date == DateTimeOffset.Now.Date,
        ConversationActivityFilter.ThisWeek => conversation.UpdatedAt >= DateTimeOffset.UtcNow.AddDays(-7),
        _ => true
    };

    private async Task SetActivityFilterAsync(ConversationActivityFilter filter)
    {
        if (_activityFilter == filter)
            return;
        _activityFilter = filter;
        await JS.InvokeVoidAsync("localStorage.setItem", ActivityFilterKey, filter.ToString());
    }

    private RenderFragment RenderConversationItem(AgentState agent, ConversationState conversation) => __builder =>
    {
        <div class="conversation-list-item" data-testid="conversation-list-item" data-conversation-id="@conversation.ConversationId">
            <a class="conversation-list-item-btn @(conversation.ConversationId == agent.ActiveConversationId ? "active" : "")"
               href="agent/@Uri.EscapeDataString(agent.AgentId)/conversation/@Uri.EscapeDataString(conversation.ConversationId)"
               @onclick="() => SelectConversationAsync(agent.AgentId, conversation.ConversationId)"
               @onclick:preventDefault="true">
                <span class="conversation-list-item-main">
                    <span class="conversation-list-item-title" title="@PortalText.SingleLine(conversation.Title)">@PortalText.SingleLine(conversation.Title)</span>

                    @if (conversation.IsDefault)
                    {
                        <span class="conversation-default-badge">Default</span>
                    }
                    @if (GetVirtualConversationBadge(conversation) is { } badge)
                    {
                        <span class="conversation-default-badge">@badge</span>
                    }
                </span>

                <span class="conversation-list-item-meta">
                    @if (conversation.UnreadCount > 0)
                    {
                        <span class="conversation-unread-dot"
                              aria-label="Unread messages"></span>
                    }

                    <span class="conversation-updated-at">
                        @FormatConversationTimestamp(conversation.UpdatedAt)
                    </span>
                </span>
            </a>
            @if (!conversation.IsDefault && !agent.IsReadOnly)
            {
                <button class="conversation-pin-btn @(conversation.IsPinned ? "pinned" : "")" data-testid="conversation-pin-btn"
                        title="@(conversation.IsPinned ? "Unpin conversation" : "Pin conversation to top")"
                        aria-label="@(conversation.IsPinned ? "Unpin conversation" : "Pin conversation to top")"
                        aria-pressed="@(conversation.IsPinned ? "true" : "false")"
                        @onclick:stopPropagation="true"
                        @onclick="() => SetConversationPinnedAsync(agent.AgentId, conversation.ConversationId, !conversation.IsPinned)">
                    &#x1F4CC;
                </button>
                <button class="conversation-archive-btn" data-testid="conversation-archive-btn"
                        title="@(IsUnattendedConversation(conversation) ? "Close conversation \u2014 reopens on next trigger" : "Archive conversation")"
                        @onclick:stopPropagation="true"
                        @onclick="() => ArchiveConversationAsync(agent.AgentId, conversation.ConversationId, conversation.Title, IsUnattendedConversation(conversation))">
                    @(IsUnattendedConversation(conversation) ? "\u2715" : "\uD83D\uDDD1\uFE0F")
                </button>
                @RenderSectionAssign(agent, conversation)
            }
        </div>
    };

    // #2324: the sections feature (#2124) shipped with no way to put a conversation *into* a section -
    // SectionsApiClient.AssignAsync had zero UI call sites. This is the interim inline affordance the
    // issue sanctions: a per-row folder button opening a small "move to section" menu. The richer
    // right-click context menu (#2326) and inline section rendering (#2325) are separate work; when
    // #2326 lands, this menu's Assign/Unassign handlers are the reusable seam it can call.
    private RenderFragment RenderSectionAssign(AgentState agent, ConversationState conversation) => __builder =>
    {
        var isOpen = string.Equals(_sectionMenuConversationId, conversation.ConversationId, StringComparison.Ordinal);
        <button class="conversation-section-btn" data-testid="conversation-section-btn"
                title="Move to section"
                aria-label="Move to section"
                aria-haspopup="menu"
                aria-expanded="@(isOpen ? "true" : "false")"
                @onclick:stopPropagation="true"
                @onclick="() => ToggleSectionMenu(conversation.ConversationId)">
            &#x1F4C1;
        </button>
        @if (isOpen)
        {
            var sections = _sectionsPanel?.Sections ?? [];
            var currentSectionId = GetAssignedSectionId(conversation.ConversationId);
            <div class="conversation-section-menu" data-testid="conversation-section-menu" role="menu">
                <button class="conversation-section-menu-item @(currentSectionId is null ? "active" : "")"
                        role="menuitem"
                        data-testid="conversation-section-menu-none"
                        @onclick:stopPropagation="true"
                        @onclick="() => UnassignConversationSectionAsync(agent.AgentId, conversation.ConversationId)">None</button>
                @foreach (var section in sections)
                {
                    <button class="conversation-section-menu-item @(string.Equals(currentSectionId, section.SectionId, StringComparison.Ordinal) ? "active" : "")"
                            role="menuitem"
                            data-testid="conversation-section-menu-item"
                            data-section-id="@section.SectionId"
                            @onclick:stopPropagation="true"
                            @onclick="() => AssignConversationSectionAsync(agent.AgentId, conversation.ConversationId, section.SectionId)">@section.Name</button>
                }
                @if (sections.Count == 0)
                {
                    <div class="conversation-section-menu-empty" data-testid="conversation-section-menu-empty">No sections yet.</div>
                }
            </div>
        }
    };

    private void ToggleSectionMenu(string conversationId) =>
        _sectionMenuConversationId = string.Equals(_sectionMenuConversationId, conversationId, StringComparison.Ordinal)
            ? null
            : conversationId;

    private string? GetAssignedSectionId(string conversationId) =>
        _sectionsPanel is not null && _sectionsPanel.Assignments.TryGetValue(conversationId, out var sectionId)
            ? sectionId
            : null;

    private async Task AssignConversationSectionAsync(string agentId, string conversationId, string sectionId)
    {
        _sectionMenuConversationId = null;
        if (await SectionsApi.AssignAsync(agentId, sectionId, conversationId) && _sectionsPanel is not null)
            await _sectionsPanel.ReloadAsync();
        StateHasChanged();
    }

    private async Task UnassignConversationSectionAsync(string agentId, string conversationId)
    {
        _sectionMenuConversationId = null;
        if (await SectionsApi.UnassignAsync(agentId, conversationId) && _sectionsPanel is not null)
            await _sectionsPanel.ReloadAsync();
        StateHasChanged();
    }

    // #2441: agent display names and emoji come from user-editable config and may contain embedded
    // control characters; normalise to a single line so the dropdown row cannot grow.
    private static string FormatAgentName(AgentState agent) =>
        string.IsNullOrWhiteSpace(agent.Emoji)
            ? PortalText.SingleLine(agent.DisplayName)
            : PortalText.SingleLine($"{agent.Emoji} {agent.DisplayName}");

    private static string? GetVirtualConversationBadge(ConversationState conversation)
    {
        // #2305: the badge is a PURE projection of the immutable (Kind, Source) origin. A normal
        // human/channel conversation carries no badge and there is no fallback path - the mutable
        // virtual-session flag/kind probe is deleted.
        return conversation.Project(SelectionSource.UserClick).Badge;
    }

    // #2305: "is this conversation unattended?" (drives close-vs-archive wording) is a projection of
    // the immutable origin, never of a mutable client flag.
    private static bool IsUnattendedConversation(ConversationState conversation) =>
        conversation.Project(SelectionSource.UserClick).IsUnattended;

