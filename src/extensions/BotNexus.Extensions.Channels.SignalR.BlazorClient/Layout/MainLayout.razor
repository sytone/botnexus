    };

    private static bool IsUserFacingConversation(ConversationState conversation)
    {
        // #2340: hiding runtime-internal bookkeeping threads now reads the first-class, server-
        // stamped, write-once ConversationVisibility instead of probing the conversation id for an
        // "internal:" prefix. That probe was the LAST id-substring test in client rendering code and
        // the sole allowlisted exception to the origin-inference fence, which is now absolute.
        //
        // Visibility is a genuinely separate axis from origin - "who may see it" vs "why it exists"
        // - so it is its own field rather than an overload of Source. InspectableReadOnly rows are
        // deliberately still listed: they are visible-but-not-writable, and write gating is the
        // independent job of ConversationRenderProjection.
        return conversation.Visibility != ConversationVisibility.InternalHidden;
    }

    // #2305 (epic #2300): grouping derives ONLY from the immutable server-supplied origin signal via
    // the typed projection, plus the authoritative cron-job -> conversation-id mapping returned by
    // the cron API. The transitional conversation-id prefix probe and the mutable virtual-session
    // flag are both deleted; no string sniffing of origin remains here.
    private bool IsCronConversation(ConversationState c) =>
        c.Project(Store.ActiveSelectionSource).Group == ConversationListGroup.Scheduled ||
        _cronConversationIds.Contains(c.ConversationId);

    private static bool IsPinnedConversation(ConversationState c) => c.IsPinned;

