    /// <summary>
    /// The shared switcher launcher, resolved optionally.
    /// </summary>
    /// <remarks>
    /// <c>GetService</c> rather than <c>@inject</c>, for the same reason <c>ConversationSwitcher</c>
    /// resolves <c>CronApiClient</c> that way: fifteen existing component-test fixtures render this
    /// layout and register only the services it needed before, and only ten of them share a common
    /// setup helper - so a constructor-level dependency would turn the other five into DI
    /// resolution failures with no single place to fix them. <c>Program.cs</c> registers the
    /// launcher, so the real portal always has it; a null here means a test host, and costs only
    /// the sidebar box and the shortcut, never the header caret.
    /// </remarks>
    private IConversationSwitcherLauncher? SwitcherLauncher =>
        _switcherLauncher ??= Services.GetService(typeof(IConversationSwitcherLauncher)) as IConversationSwitcherLauncher;

    private IConversationSwitcherLauncher? _switcherLauncher;

    private bool _isMacPlatform;
    private DotNetObjectReference<MainLayout>? _shortcutRef;
    private IJSObjectReference? _shortcutRegistration;

    /// <summary>
    /// Opens the conversation switcher from the Cmd/Ctrl-K shortcut. Invoked from
    /// <c>js/conversationSwitcher.js</c>.
    /// </summary>
    /// <remarks>
    /// This raises a request rather than opening anything itself: the switcher is rendered by
    /// <c>ChatPanel</c>, which this layout does not own. See <see cref="IConversationSwitcherLauncher"/>.
    /// </remarks>
    [JSInvokable]
    public void OpenFromShortcut() => SwitcherLauncher?.Request();

    private async Task RegisterSwitcherShortcutAsync()
    {
        // Nothing to open without a launcher, so do not attach a document listener either.
        if (SwitcherLauncher is null)
            return;

        try
        {
            _isMacPlatform = await JS.InvokeAsync<bool>(
                "eval",
                "/mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent)");
        }
        catch { _isMacPlatform = false; }

        try
        {
            _shortcutRef = DotNetObjectReference.Create(this);
            _shortcutRegistration = await JS.InvokeAsync<IJSObjectReference>(
                "botnexusConversationSwitcher.registerShortcut", _shortcutRef);
        }
        catch
        {
            // No script (a test host, or a boot that failed before the file loaded). The sidebar box
            // and the header caret still open the switcher; only the shortcut is missing.
            _shortcutRef?.Dispose();
            _shortcutRef = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        // The listener is on `document` and outlives this component, so it must be removed or every
        // re-created layout stacks another handler holding a disposed .NET reference.
        if (_shortcutRegistration is not null)
        {
            try { await _shortcutRegistration.InvokeVoidAsync("dispose"); }
            catch { /* circuit already gone - the listener dies with the page */ }

            try { await _shortcutRegistration.DisposeAsync(); }
            catch { /* as above */ }
        }

        _shortcutRef?.Dispose();

        // Same reasoning as the shortcut listener: the ResizeObserver outlives this component.
        if (_toolbarObserver is not null)
        {
            try { await _toolbarObserver.InvokeVoidAsync("dispose"); }
            catch { /* circuit already gone */ }

            try { await _toolbarObserver.DisposeAsync(); }
            catch { /* as above */ }
        }

        _toolbarRef_dotNet?.Dispose();
    }
