@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject HttpClient Http
@inject IClientStateStore Store
@inject IAgentInteractionService Interaction
@inject IPortalLoadService PortalLoad
@inject GatewayInfoService GatewayInfo
@inject ExtensionFeatureService ExtensionFeatures
@inject GatewayHubConnection Hub
@inject IUpdateStatusService UpdateStatus
@inject IJSRuntime JS
@inject IPortalPreferencesService Prefs
@inject CronApiClient CronApi
@inject ToolsApiClient ToolsApi
@inject NavOrderApiClient NavOrderApi
@inject IServiceProvider Services
@implements IDisposable
@implements IAsyncDisposable

<div class="app-shell" data-density="@DensityAttribute">
    @* Top bar with burger + logo *@
    <header class="app-banner">
        <div class="banner-header">
            @if (ShowsConversations)
            {
                <button class="burger-btn" @onclick="ToggleSidebar" aria-label="Toggle menu" data-testid="sidebar-toggle-btn">
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                    <span class="burger-line"></span>
                </button>
            }
            <a href="" class="banner-home-link" data-testid="banner-home-link" title="Home" @onclick="CloseSidebar">
                <span class="banner-logo">&#x1F916;</span>
                <span class="banner-title">BotNexus</span>
            </a>

            @* #2441: connection state is a dot right after the logo; the full state text lives in
               the tooltip. This replaced the dedicated sidebar row that cost ~30px of nav height. *@
            <ConnectionStatus Hub="@Hub" Dot="true" Reconnecting="@PortalLoad.IsReconnecting" />

            @* #2441: agent identity (emoji + name + description, id on hover) rides in the top bar
               rather than owning a row inside the agent panel. *@
            @if (Store.ActiveAgentId is { Length: > 0 } bannerAgentId)
            {
                <AgentIdentity AgentId="@bannerAgentId"
                               OnPersonaRequested="@(() => OpenPersonaAsync(bannerAgentId))" />
            }

            <button class="banner-usage-btn"
                    @ref="_usageBtnRef"
                    @onclick="OpenUsage"
                    title="Provider usage and rate limits"
                    aria-label="Provider usage and rate limits"
                    data-testid="banner-usage-btn">
                <span class="banner-usage-dot"></span>
                <span>Usage</span>
            </button>
            <NotificationCentre />
            <button class="banner-theme-btn"
                    @onclick="ToggleTheme"
                    title="@(IsLightTheme ? "Switch to dark theme" : "Switch to light theme")"
                    aria-label="@(IsLightTheme ? "Switch to dark theme" : "Switch to light theme")"
                    data-testid="banner-theme-btn">@(IsLightTheme ? "\u263E" : "\u2600")</button>
            <button class="banner-settings-btn" @onclick="OpenSettings" title="Portal settings" data-testid="banner-settings-btn"><Icon Name="configuration" Size="16" Class="bn-icon-inherit" /></button>
            @if (Prefs.Current.DebugModeEnabled)
            {
                <button class="banner-debug-btn" @onclick="OpenDebug" title="Debug inspector" data-testid="banner-debug-btn">&#x1F50D;</button>
            }
        </div>
    </header>

    @* Announcements bar - hidden when empty *@
    @if (_announcements.Count > 0)
    {
        <div class="announcement-bar has-announcements">
            @foreach (var ann in _announcements)
            {
                <div class="announcement-item @ann.Type">
                    <span class="announcement-content">@ann.Text</span>
                    <button class="announcement-dismiss" @onclick="() => DismissAnnouncement(ann.Id)"><Icon Name="close" Size="14" Class="bn-icon-inherit" /></button>
                </div>
            }
        </div>
    }

    @* Two-column body *@
    @* Primary navigation, in the user's configured order (#2236), with plugin contributions.
       Items that do not fit move into the overflow menu - measured, not guessed, because the
       entry count is not fixed: plugins contribute entries and the user reorders them. *@
    <nav class="app-toolbar" @ref="_toolbarRef" data-testid="app-toolbar">
        <div class="toolbar-items">
            @foreach (var item in VisibleToolbarEntries())
            {
                @RenderToolbarItem(item)
            }
        </div>

        @if (OverflowToolbarEntries().Any())
        {
            <div class="toolbar-overflow">
                <button class="toolbar-item toolbar-more-btn @(_overflowOpen ? "open" : "")"
                        data-testid="toolbar-more"
                        @onclick="ToggleOverflow"
                        aria-expanded="@(_overflowOpen ? "true" : "false")"
                        aria-haspopup="menu"
                        title="More">
                    <Icon Name="more" Size="16" />
                    <span class="toolbar-item-label">More</span>
                </button>

                @if (_overflowOpen)
                {
                    <div class="toolbar-overflow-backdrop" @onclick="CloseOverflow"></div>
                    <div class="toolbar-overflow-menu" data-testid="toolbar-overflow-menu" role="menu">
                        @foreach (var item in OverflowToolbarEntries())
                        {
                            @RenderToolbarItem(item, inOverflow: true)
                        }
                    </div>
                }
            </div>
        }

        @* Off-layout copy of the FULL set. The measurer reads its widths, so an item that is
           currently inside the overflow menu still has a measurable natural width - otherwise the
           bar could never work out that it would fit again on widening. *@
        <div class="toolbar-ghost" aria-hidden="true" data-testid="toolbar-ghost">
            @foreach (var item in ToolbarNavItems())
            {
                @RenderToolbarItem(item, ghost: true)
            }
        </div>
    </nav>

    @* Second row: the sub-navigation for the section you are in. These were inline sub-lists under
       their sidebar item and are CONTEXTUAL - they appear only while you are on that page - so they
       become a second toolbar row rather than dropdowns, which would have promised persistent menus
       the sidebar never had. *@
    @if (HasActiveSubNav())
    {
        <div class="app-subtoolbar" data-testid="app-subtoolbar">
            @RenderActiveSubNav()
        </div>
    }

    <div class="app-body" id="app-body">
        @* Mobile overlay - tap to close sidebar *@
        @if (_sidebarOpen)
        {
            <div class="sidebar-overlay" @onclick="CloseSidebar"></div>
        }

        @if (ShowsConversations)
        {
        <aside class="main-sidebar @(_sidebarOpen ? "sidebar-open" : "sidebar-closed")">
            @* Navigation moved to the toolbar under the banner; the sidebar is the conversation
               list now. The hamburger toggles THIS, which is why its label says conversations. *@
            <nav class="sidebar-nav">
                @RenderConversationsRegion()
            </nav>

            @* Build info at bottom *@
            <div class="sidebar-footer">
                @* Restart Gateway button removed -- no process supervisor present; button killed the gateway with no recovery (#794) *@
                @if (GatewayInfo.Info is not null)
                {
                    <div class="gateway-info">
                        <span class="gateway-started" title="@GatewayInfo.Info.StartedAt.ToString("o")">
                            &#x21BA; @FormatStarted(GatewayInfo.Info.StartedAt)
                        </span>
                    </div>
                }

                @if (UpdateStatus.Status?.IsUpdateAvailable == true)
                {
                    <div class="update-badge @(UpdateStatus.Status.IsUpdateInProgress ? "update-badge-in-progress" : "")"
                         @onclick="ShowUpdateConfirm"
                         title="Update to @UpdateStatus.Status.LatestCommitShort">
                        @if (UpdateStatus.Status.IsUpdateInProgress)
                        {
                            <span>&#x231B; Updating&#x2026;</span>
                        }
                        else
                        {
                            <span>&#x2191; @UpdateStatus.Status.LatestCommitShort available</span>
                        }
                    </div>
                }
            </div>
        </aside>
        }

        @* Update confirmation overlay *@
        @if (_showUpdateConfirm)
        {
            <div class="update-confirm-overlay" @onclick="CancelUpdate">
                <div class="update-confirm-dialog" @onclick:stopPropagation="true">
                    <p>Update BotNexus to <strong>@UpdateStatus.Status?.LatestCommitShort</strong>?</p>
                    <p class="text-muted">The gateway will restart. You will reconnect automatically.</p>
                    <div class="update-confirm-actions">
                        <button class="cancel-btn" @onclick="CancelUpdate">Cancel</button>
                        <button class="update-confirm-btn" @onclick="DoUpdate"
                                disabled="@(UpdateStatus.Status?.IsUpdateInProgress == true)">
                            Update
                        </button>
                    </div>
                </div>
            </div>
        }

        @* Main canvas - @Body renders here *@
        @* Reuses BotNexus.splitter, the same mechanism the workspace, reports and skills
           panels already use, rather than a second drag implementation. The JS resolves the left
           pane as this element's previousElementSibling, which is the sidebar. Desktop only: on
           mobile the sidebar is a fixed overlay, so there is no boundary to drag. *@
        @if (ShowsConversations)
        {
            <div class="panel-splitter sidebar-splitter" role="separator" aria-orientation="vertical"
                 aria-label="Resize sidebar" title="Drag to resize"></div>
        }
        <main class="main-canvas">
            <GlobalErrorBoundary>
            @Body
            </GlobalErrorBoundary>
        </main>
    </div>

</div>

@* Modal overlays - rendered outside app-shell to avoid flex/overflow containment *@
<PortalSettingsPanel @ref="_settingsPanel" />
<ProviderUsagePanel @ref="_usagePanel" />
<AgentPersonaPanel @ref="_personaPanel" />
@if (_showDebugPanel)
{
    <SessionDebugPanel SessionId="@GetActiveSessionId()" OnClose="CloseDebug" />
}

@code {

    private bool _cronGroupCollapsed = true;
    private HashSet<string> _cronConversationIds = new(StringComparer.OrdinalIgnoreCase);
    private const string CronCollapsedKey = "botnexus-cron-collapsed";

    // #2441: collapse state persists with the same localStorage key pattern
    // as the Scheduled group, and both default to collapsed so the nav starts tight.

    // #2122: Webhooks is its own section, and Pinned / Conversations became collapsible. All three
    // reuse the exact Scheduled-group persistence pattern (a "true"/"false" string under a
    // botnexus-*-collapsed localStorage key) rather than introducing a second mechanism.
    //
    // Defaults differ deliberately by intent: Webhooks is unattended machine traffic so it starts
    // collapsed like Scheduled, while Pinned and Conversations are the user's own attended lists
    // and start expanded - collapsing them is opt-in.
    private bool _webhookGroupCollapsed = true;
    private const string WebhookCollapsedKey = "botnexus-webhook-collapsed";
    private bool _pinnedGroupCollapsed;
    private const string PinnedCollapsedKey = "botnexus-pinned-collapsed";
    private bool _conversationsGroupCollapsed;
    private const string ConversationsCollapsedKey = "botnexus-conversations-collapsed";

    /// <summary>
    /// Density preset emitted as <c>data-density</c> on the app shell, driving the
    /// <c>--density-*</c> token set for the whole portal (#2441).
    /// </summary>
    private string DensityAttribute => PortalDensity.Normalize(Prefs.Current.Density);


    /// <summary>True when the light theme is active, driving the toggle's icon and label.</summary>
    private bool IsLightTheme => PortalTheme.Normalize(Prefs.Current.Theme) == PortalTheme.Light;

    /// <summary>Flips between the two themes and persists the choice.</summary>
    private Task ToggleTheme() => Prefs.SetThemeAsync(PortalTheme.Toggle(Prefs.Current.Theme));

    private ConversationActivityFilter _activityFilter = ConversationActivityFilter.None;
    private const string ActivityFilterKey = "botnexus-conversation-activity-filter";

    // Effective nav order (built-in defaults layered with server-side user overrides, #2236).
    // Populated from GET /api/nav-order; on any failure it falls back to the built-in defaults so
    // the nav always renders in a sensible, consistent order.
    private IReadOnlyList<string> _navOrder = NavOrderKeys.DefaultOrder;
    private IReadOnlyDictionary<string, int> _navOrderNumbers = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<NavContributionDto> _navContributions = [];

    // Resolved once rather than per load: the sidebar subscribes to it, and resolving a different
    // instance later would leave the subscription attached to an object nothing raises.
    private PluginsApiClient? _pluginsApi;

    private record Announcement(string Id, string Text, string Type = "info");
    private record SidebarAgentItem(string AgentId, string DisplayLabel);
    private List<Announcement> _announcements = [];
    private List<SidebarAgentItem> _sidebarAgents = [];
    private List<ToolDto> _tools = [];
    private PortalSettingsPanel? _settingsPanel;
    private ProviderUsagePanel? _usagePanel;
    private AgentPersonaPanel? _personaPanel;
    private ElementReference _usageBtnRef;
    private bool _showDebugPanel = false;
    private bool _sidebarOpen = false;
    private bool _isMobile = false;
    private const string SidebarKey = "botnexus-sidebar-open";

    /// <summary>
    /// Canonical set of built-in nav keys and their default rendering order. The layout renders the
    /// nav by iterating this order (as adjusted by server-side overrides), so every built-in item
    /// participates in one ordering model. Tools intentionally precedes Chat by default (#2236).
    /// </summary>
    private static class NavOrderKeys
    {
        public const string Home = "home";
        public const string Activity = "activity";
        public const string Tools = "tools";
        public const string Chat = "chat";
        public const string Configuration = "configuration";
        public const string Skills = "skills";
        public const string Agents = "agents";
        public const string Cron = "cron";
        public const string Plugins = "plugins";
        public const string Memory = "memory";
        public const string Guide = "guide";

        // Guide sits last: it is a reference, not a place work happens. Adding a key here is safe
        // for existing users - the resolver below walks this list and re-inserts anything missing
        // from a saved order next to its neighbours, so a new entry appears without a migration.
        public static readonly IReadOnlyList<string> DefaultOrder =
            [Home, Activity, Tools, Chat, Configuration, Skills, Agents, Memory, Cron, Plugins, Guide];
    }

    /// <summary>
    /// Returns the nav keys in the order they should render: the server-provided effective order,
    /// with any built-in key missing from the server response re-inserted at its default position
    /// so a newly-added built-in can never silently vanish from the nav, nor be dumped at the
    /// bottom. A stored order predating a new built-in is MERGED with the defaults, not replaced
    /// by them (#2535).
    /// </summary>
    private IEnumerable<string> OrderedNavKeys()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var result = new List<string>();
        foreach (var key in _navOrder)
        {
            if (NavOrderKeys.DefaultOrder.Contains(key, StringComparer.OrdinalIgnoreCase) && seen.Add(key))
                result.Add(key);
        }

        // Re-insert every built-in the server did not mention, positioned relative to its default
        // neighbours rather than appended. Walking DefaultOrder backwards means each missing key is
        // placed just before the nearest already-placed key that follows it by default.
        for (var i = NavOrderKeys.DefaultOrder.Count - 1; i >= 0; i--)
        {
            var key = NavOrderKeys.DefaultOrder[i];
            if (!seen.Add(key))
                continue;

            var insertAt = result.Count;
            for (var j = i + 1; j < NavOrderKeys.DefaultOrder.Count; j++)
            {
                var successor = NavOrderKeys.DefaultOrder[j];
                var idx = result.FindIndex(k => string.Equals(k, successor, StringComparison.OrdinalIgnoreCase));
                if (idx >= 0)
                {
                    insertAt = idx;
                    break;
                }
            }

            result.Insert(insertAt, key);
        }

        return result;
    }

    /// <summary>
    /// Maps a nav route to its canonical test id. Home's route is the empty string, which would
    /// otherwise produce the meaningless <c>nav-</c>, so it is mapped explicitly.
    /// </summary>
    private static string NavTestId(string route) =>
        string.IsNullOrEmpty(route) ? "nav-" + NavOrderKeys.Home : "nav-" + route;

    /// <summary>Maps a nav route to the key <see cref="NavClass"/> uses for active-state matching.</summary>
    private static string NavKeyForRoute(string route) =>
        string.IsNullOrEmpty(route) ? NavOrderKeys.Home : route;

    /// <summary>
    /// #3051: THE single emission point for every sidebar SUB-nav anchor, one level below
    /// <see cref="NavAnchor"/>.
    ///
    /// Same defect, same seam: three of the four sub-nav render sites carried no
    /// <c>data-testid</c> at all, and the fourth stamped the identical literal
    /// <c>tools-subnav-item</c> onto every tool row - an id that names the row KIND, not the row.
    /// A strict single-element locator against a repeated id either throws or silently takes the
    /// first match, which is the same silent-wrong-target failure #2973 fixed at the top level.
    /// Deriving the id from the route works because the route already carries the discriminator
    /// (<c>tools/{id}</c>, <c>agents/{id}</c>, <c>skills/explorer</c>, <c>agents/new</c>), so
    /// uniqueness is a property of the routing table rather than of author diligence.
    /// </summary>
    /// <param name="route">The anchor's href, relative to the base path.</param>
    /// <param name="label">The anchor's rendered content.</param>
    /// <param name="extraClass">Additional CSS classes appended after <c>sidebar-subnav-item</c>.</param>
    /// <param name="legacyTestId">
    /// Only for a sub-nav row whose historical id is a deliberate GROUP selector rather than a
    /// per-row identity. The tools rows are the sole case: <c>tools-subnav-item</c> selects "all
    /// tool rows" and has an in-repo consumer, so it is preserved on <c>data-testid</c> and the
    /// unique route-derived id is emitted alongside it on <c>data-testid-alias</c> - the same
    /// override convention #2973 established for <c>nav-cron-jobs</c>.
    /// </param>
    private RenderFragment SubNavAnchor(string route, RenderFragment label, string? extraClass = null, string? legacyTestId = null) => __builder =>
    {
        <a href="@route"
           class="sidebar-subnav-item @extraClass"
           data-testid="@(legacyTestId ?? SubNavTestId(route))"
           data-testid-alias="@(legacyTestId is null ? null : SubNavTestId(route))"
           @onclick="CloseSidebar">@label</a>
    };

    /// <summary>
    /// Maps a sub-nav route to its canonical test id. Every character that is not alphanumeric or a
    /// hyphen - the route separator included - collapses to a hyphen, so an id stays a valid, quotable
    /// CSS attribute-selector value even when a tool or agent id contains punctuation.
    /// </summary>
    private static string SubNavTestId(string route) =>
        "subnav-" + System.Text.RegularExpressions.Regex.Replace(route, "[^a-zA-Z0-9-]+", "-").Trim('-');

    /// <summary>
    /// One primary-navigation destination, resolved for the toolbar.
    /// </summary>
    /// <param name="Key">Nav-order key (built-ins) or the contribution id.</param>
    /// <param name="Route">Base-relative route the item navigates to.</param>
    /// <param name="Icon">Icon-set name.</param>
    /// <param name="Label">Visible label.</param>
    /// <param name="TestId">
    /// The data-testid this item carried in the sidebar. Preserved deliberately: moving navigation
    /// into a toolbar changes where the item is, not which item it is, so every existing nav test id
    /// keeps pointing at the same destination.
    /// </param>
    /// <param name="Contribution">
    /// Set for a plugin-contributed entry. Such an entry is NOT a plain href: a full-page
    /// contribution needs a forceLoad navigation and an embedded one routes to
    /// <c>extension/{id}</c>, so it keeps going through <see cref="NavigateToContribution"/>
    /// rather than being flattened into a link.
    /// </param>
    private sealed record ToolbarNavItem(
        string Key, string Route, string Icon, string Label, string? TestId = null,
        NavContributionDto? Contribution = null);

    /// <summary>
    /// The toolbar's items, in the user's configured order, built-ins and plugin contributions
    /// together. Feature gates are applied here exactly as the sidebar applied them, so a disabled
    /// extension stays absent rather than moving to the overflow menu.
    /// </summary>
    private IReadOnlyList<ToolbarNavItem> ToolbarNavItems()
    {
        var items = new List<ToolbarNavItem>();
        foreach (var entry in OrderedNavEntries())
        {
            if (entry.Contribution is { } contribution)
            {
                items.Add(new ToolbarNavItem(
                    contribution.Id,
                    $"extension/{contribution.Id}",
                    ResolveContributedIcon(contribution.Icon),
                    contribution.Label,
                    Contribution: contribution));
                continue;
            }

            var built = entry.Key.ToLowerInvariant() switch
            {
                NavOrderKeys.Home => new ToolbarNavItem(entry.Key, "", "home", "Home"),
                NavOrderKeys.Activity => new ToolbarNavItem(entry.Key, NavOrderKeys.Activity, "activity", "Activity"),
                NavOrderKeys.Tools => new ToolbarNavItem(entry.Key, NavOrderKeys.Tools, "tools", "Tools"),
                NavOrderKeys.Chat => new ToolbarNavItem(entry.Key, NavOrderKeys.Chat, "chat", "Chat"),
                NavOrderKeys.Configuration => new ToolbarNavItem(entry.Key, NavOrderKeys.Configuration, "configuration", "Configuration"),
                NavOrderKeys.Skills when ExtensionFeatures.SkillsEnabled
                    => new ToolbarNavItem(entry.Key, NavOrderKeys.Skills, "skills", "Skills"),
                NavOrderKeys.Agents => new ToolbarNavItem(entry.Key, NavOrderKeys.Agents, "agents", "Agents"),
                NavOrderKeys.Cron => new ToolbarNavItem(entry.Key, NavOrderKeys.Cron, "cron-jobs", "Cron Jobs", "nav-cron-jobs"),
                NavOrderKeys.Memory => new ToolbarNavItem(entry.Key, NavOrderKeys.Memory, "thinking", "Memory"),
                NavOrderKeys.Plugins => new ToolbarNavItem(entry.Key, NavOrderKeys.Plugins, "plugins", "Plugins"),
                NavOrderKeys.Guide => new ToolbarNavItem(entry.Key, NavOrderKeys.Guide, "guide", "Guide"),
                _ => null,
            };

            if (built is not null)
                items.Add(built);
        }

        return items;
    }

    /// <summary>Items rendered in the bar itself.</summary>
    private IEnumerable<ToolbarNavItem> VisibleToolbarEntries() =>
        _visibleNavCount is int n ? ToolbarNavItems().Take(n) : ToolbarNavItems();

    /// <summary>Items pushed into the overflow menu because they do not fit.</summary>
    private IEnumerable<ToolbarNavItem> OverflowToolbarEntries() =>
        _visibleNavCount is int n ? ToolbarNavItems().Skip(n) : [];

    /// <summary>
    /// How many items currently fit in the bar. Null until the measurer has reported, so the first
    /// paint shows every item rather than an arbitrary guess that would visibly reflow.
    /// </summary>
    private int? _visibleNavCount;

    private bool _overflowOpen;
    private ElementReference _toolbarRef;
    private DotNetObjectReference<MainLayout>? _toolbarRef_dotNet;
    private IJSObjectReference? _toolbarObserver;

    private void ToggleOverflow() => _overflowOpen = !_overflowOpen;

    private void CloseOverflow() => _overflowOpen = false;

    /// <summary>
    /// Called by the measurer with the number of items that fit. Invoked on every resize, so it
    /// re-renders only when the number actually changed - otherwise a drag of the window edge would
    /// queue a render per pixel.
    /// </summary>
    /// <param name="count">Items that fit in the bar.</param>
    [JSInvokable]
    public void SetVisibleNavCount(int count)
    {
        var clamped = Math.Clamp(count, 0, ToolbarNavItems().Count);
        if (_visibleNavCount == clamped)
            return;

        _visibleNavCount = clamped;
        // An item that just moved into the menu must not leave the menu open over a stale list.
        if (clamped >= ToolbarNavItems().Count)
            _overflowOpen = false;

        StateHasChanged();
    }

    private async Task RegisterToolbarMeasurerAsync()
    {
        try
        {
            _toolbarRef_dotNet = DotNetObjectReference.Create(this);
            _toolbarObserver = await JS.InvokeAsync<IJSObjectReference>(
                "botnexusNavToolbar.observe", _toolbarRef, _toolbarRef_dotNet);
        }
        catch
        {
            // No script (test host, or a boot that failed before the file loaded). Every item stays
            // in the bar - the CSS lets it wrap rather than clipping, so nothing becomes unreachable.
            _toolbarRef_dotNet?.Dispose();
            _toolbarRef_dotNet = null;
        }
    }

    /// <summary>
    /// A toolbar item. The ghost copy carries no href or test id: it exists only to be measured, and
    /// a second element sharing a nav test id would make every existing nav assertion ambiguous.
    /// </summary>
    private RenderFragment RenderToolbarItem(ToolbarNavItem item, bool inOverflow = false, bool ghost = false) => __builder =>
    {
        if (ghost)
        {
            <span class="toolbar-item" data-nav-key="@item.Key">
                <Icon Name="@item.Icon" Size="16" />
                <span class="toolbar-item-label">@item.Label</span>
            </span>
        }
        else if (item.Contribution is { } contribution)
        {
            @* Every attribute here is load-bearing and tested: the href is the real destination so
               the row is a link rather than a scripted div, preventDefault + NavigateToContribution
               keep full-page contributions on a forceLoad and embedded ones on the portal's own
               extension/{id} route, and the two data-nav-* attributes are how a plugin's entry is
               attributed and identified as embedded. *@
            <a href="@ContributionHref(contribution)"
               class="@(inOverflow ? "toolbar-overflow-item" : "toolbar-item") @NavClass(item.Key)"
               data-testid="@("nav-" + contribution.Id)"
               data-nav-contributed-by="@contribution.ExtensionId"
               data-nav-embedded="@((!contribution.FullPage).ToString().ToLowerInvariant())"
               data-nav-key="@item.Key"
               @onclick:preventDefault="true"
               @onclick="() => OnContributionClick(contribution)">
                <Icon Name="@item.Icon" Size="16" />
                <span class="toolbar-item-label">@item.Label</span>
            </a>
        }
        else
        {
            <a href="@item.Route"
               class="@(inOverflow ? "toolbar-overflow-item" : "toolbar-item") @NavClass(item.Key)"
               data-testid="@(item.TestId ?? NavTestId(item.Route))"
               data-testid-alias="@(item.TestId is null ? null : NavTestId(item.Route))"
               data-nav-key="@item.Key"
               @onclick="OnToolbarNavClick">
                <Icon Name="@item.Icon" Size="16" />
                <span class="toolbar-item-label">@item.Label</span>
            </a>
        }
    };

    /// <summary>
    /// True when the current page contributes a sub-navigation row.
    /// </summary>
    /// <remarks>
    /// Kept as its own predicate so the row's container is not rendered empty: an empty bordered
    /// strip under the toolbar reads as a broken layout rather than as "nothing here".
    /// </remarks>
    private bool HasActiveSubNav() =>
        (IsOnPage(NavOrderKeys.Tools) && _tools.Count > 0)
        || (IsOnPage("skills") && ExtensionFeatures.SkillsEnabled)
        || IsOnPage("agents");

    /// <summary>
    /// The sub-navigation for the active section. Gates and destinations are the sidebar's, moved
    /// rather than rewritten - Tools lists the user's configured tools, Skills offers Explorer, and
    /// Agents lists the agents plus Add Agent.
    /// </summary>
    private RenderFragment RenderActiveSubNav() => __builder =>
    {
        @if (IsOnPage(NavOrderKeys.Tools) && _tools.Count > 0)
        {
            @foreach (var tool in _tools)
            {
                @SubNavAnchor(
                    $"tools/{tool.Id}",
                    @<text>
                        @if (!string.IsNullOrWhiteSpace(tool.Icon))
                        {
                            <span class="tools-subnav-item-icon">@tool.Icon</span>
                        }
                        <span class="tools-subnav-item-label">@tool.Name</span>
                    </text>,
                    IsToolActive(tool.Id) ? "active" : null,
                    "tools-subnav-item")
            }
        }
        else if (IsOnPage("skills") && ExtensionFeatures.SkillsEnabled)
        {
            @SubNavAnchor("skills/explorer", @<text><Icon Name="workspace" Size="15" /><span>Explorer</span></text>)
        }
        else if (IsOnPage("agents"))
        {
            @foreach (var agent in _sidebarAgents)
            {
                @SubNavAnchor(
                    $"agents/{agent.AgentId}",
                    @<text>@agent.DisplayLabel</text>,
                    IsAgentActive(agent.AgentId) ? "active" : null)
            }
            @SubNavAnchor("agents/new", @<text>+ Add Agent</text>, "sidebar-subnav-add")
        }
    };

    private void OnToolbarNavClick()
    {
        _overflowOpen = false;
        if (_isMobile)
            _sidebarOpen = false;
    }

    private void OnContributionClick(NavContributionDto contribution)
    {
        _overflowOpen = false;
        NavigateToContribution(contribution);
    }

    // #2535: Home owns the root route (Landing.razor, page "/"). Before this it was reachable
    // only via the banner logo, which carries no active state and duplicates the Agents robot
    // glyph. The house glyph keeps it visually distinct from Agents.

    /// <summary>
    /// The agent picker, conversation search, conversation groups and user sections - the whole
    /// body of the sidebar now that navigation has moved to the toolbar.
    /// </summary>
    private RenderFragment RenderConversationsRegion() => __builder =>
    {
        <div class="sidebar-scroll-region">
        @* Agent dropdown + session list nested under Chat *@
        @if (Store.Agents.Values.Any(a => !a.IsReadOnly))
        {
            <div class="agent-dropdown-container">
                <select class="agent-dropdown-select" data-testid="agent-select"
                        value="@Store.ActiveAgentId"
                        @onchange="OnAgentSelected">
                    <option value="">- select agent -</option>
                    @foreach (var (agentId, agent) in Store.Agents.Where(kv => !kv.Value.IsReadOnly).OrderBy(kv => kv.Value.IsBuiltIn).ThenBy(kv => kv.Value.DisplayName))
                    {
                        <option value="@agentId">
                            @FormatAgentName(agent)
                            @if (agent.IsStreaming) { <text> &#x25CF;</text> }
                            @if (agent.UnreadCount > 0) { <text> (@agent.UnreadCount)</text> }
                        </option>
                    }
                </select>
            </div>

            @if (Store.ActiveAgentId is not null &&
                 Store.Agents.TryGetValue(Store.ActiveAgentId, out var activeAgent))
            {
                <div class="agent-conversation-list">
                    @* The findable entry point. The switcher itself lives in the chat header, anchored
                       to the title it switches away from, where a bare caret is easy to miss - which is
                       how a shipped search feature can read as absent. This puts a labelled box where
                       someone looking for conversations already is: above the conversation list. It is
                       a BUTTON styled as a search field, not an input: typing happens in the switcher's
                       own box, and two fields that both look like search would be a worse lie than one
                       that opens the other. *@
                    @if (SwitcherLauncher is not null)
                    {
                    <button class="conversation-search-launcher"
                            data-testid="sidebar-conversation-search"
                            @onclick="() => SwitcherLauncher.Request()"
                            title="Search conversations across all agents (@ShortcutHint)">
                        <Icon Name="search" Size="13" Class="bn-icon-inherit" />
                        <span class="conversation-search-launcher-label">Search conversations</span>
                        <kbd class="conversation-search-launcher-kbd">@ShortcutHint</kbd>
                    </button>
                    }

                    <div class="agent-conversation-list-header">
                        <span class="agent-conversation-list-title">Conversations</span>
                        @if (!activeAgent.IsReadOnly)
                        {
                            <button class="conversation-new-btn"
                                    data-testid="new-conversation-btn"
                                    data-agent-id="@activeAgent.AgentId"
                                    @onclick="() => CreateConversationAsync(activeAgent.AgentId)"
                                    title="Start a new conversation">
                                <span class="conversation-new-btn-icon">+</span>
                                <span class="conversation-new-btn-label">New</span>
                            </button>
                        }
                    </div>

                    <div class="conversation-list-scroll">
                        @if (activeAgent.IsLoadingConversations)
                        {
                            <div class="conversation-list-loading">Loading conversations&#x2026;</div>
                        }
                        else if (activeAgent.Conversations.Count == 0)
                        {
                            <div class="conversation-list-empty">No conversations yet.</div>
                        }
                        else
                        {
                            var allUserConversations = activeAgent.Conversations.Values
                                .Where(IsUserFacingConversation)
                                .OrderByDescending(c => c.IsDefault)
                                .ThenByDescending(c => c.UpdatedAt)
                                .ToList();
                            var pinnedConversations = allUserConversations.Where(IsPinnedConversation).ToList();
                            var cronConversations = allUserConversations.Where(IsCronConversation).ToList();
                            @* #2122: webhook-originated runs get their own section. Membership comes
                               from the SAME typed projection that already computes
                               ConversationListGroup.Automated - no second classifier, no heuristic.
                               Pinned still wins over source, and cron is subtracted first so a
                               conversation can never appear in two groups. *@
                            var webhookConversations = allUserConversations
                                .Where(c => !IsPinnedConversation(c) && !IsCronConversation(c) && IsWebhookConversation(c))
                                .ToList();
                            var normalConversations = allUserConversations
                                .Where(c => !IsPinnedConversation(c) && !IsCronConversation(c) && !IsWebhookConversation(c))
                                .Where(MatchesActivityFilter)
                                .ToList();

                            @if (pinnedConversations.Count > 0)
                            {
                                <div class="conversation-group conversation-group-pinned" data-testid="conversation-group-pinned">
                                    <button class="conversation-group-header conversation-group-header-toggle"
                                            data-testid="pinned-group-toggle"
                                            aria-expanded="@(!_pinnedGroupCollapsed ? "true" : "false")"
                                            title="@(_pinnedGroupCollapsed ? "Expand pinned" : "Collapse pinned")"
                                            @onclick="TogglePinnedGroup">
                                        <span class="group-chevron @(!_pinnedGroupCollapsed ? "expanded" : "")">&#x25B6;</span>
                                        <span class="conversation-group-label"><Icon Name="pin" Size="13" /> Pinned</span>
                                        <span class="conversation-group-count" data-testid="pinned-group-count">@pinnedConversations.Count</span>
                                    </button>
                                    @if (!_pinnedGroupCollapsed)
                                    {
                                        @foreach (var conversation in pinnedConversations)
                                        {
                                            @RenderConversationItem(activeAgent, conversation)
                                        }
                                    }
                                </div>
                            }

                            <div class="conversation-group conversation-group-conversations" data-testid="conversation-group-conversations">
                                @* #2122: the header intentionally does NOT use the .conversation-group-label
                                   class - #2441 replaced the redundant inner "Conversations" heading with the
                                   filter bar and a test guards that class's absence here. The collapse
                                   affordance is a real <button> so keyboard activation is native. *@
                                <button class="conversation-group-header conversation-group-header-toggle"
                                        data-testid="conversations-group-toggle"
                                        aria-expanded="@(!_conversationsGroupCollapsed ? "true" : "false")"
                                        title="@(_conversationsGroupCollapsed ? "Expand conversations" : "Collapse conversations")"
                                        @onclick="ToggleConversationsGroup">
                                    <span class="group-chevron @(!_conversationsGroupCollapsed ? "expanded" : "")">&#x25B6;</span>
                                    <span class="conversation-group-count" data-testid="conversations-group-count">@normalConversations.Count</span>
                                </button>
                                <div class="conversation-filter-bar" role="group" aria-label="Filter conversations by recent activity" data-testid="conversation-filter-bar">
                                    <button type="button"
                                            class="conversation-filter-btn @(_activityFilter == ConversationActivityFilter.None ? "active" : "")"
                                            data-testid="conversation-filter-none"
                                            aria-pressed="@(_activityFilter == ConversationActivityFilter.None)"
                                            title="Show all conversations"
                                            @onclick="() => SetActivityFilterAsync(ConversationActivityFilter.None)">None</button>
                                    <button type="button"
                                            class="conversation-filter-btn @(_activityFilter == ConversationActivityFilter.Today ? "active" : "")"
                                            data-testid="conversation-filter-today"
                                            aria-pressed="@(_activityFilter == ConversationActivityFilter.Today)"
                                            title="Conversations updated today"
                                            @onclick="() => SetActivityFilterAsync(ConversationActivityFilter.Today)">Today</button>
                                    <button type="button"
                                            class="conversation-filter-btn @(_activityFilter == ConversationActivityFilter.ThisWeek ? "active" : "")"
                                            data-testid="conversation-filter-week"
                                            aria-pressed="@(_activityFilter == ConversationActivityFilter.ThisWeek)"
                                            title="Conversations updated in the last 7 days"
                                            @onclick="() => SetActivityFilterAsync(ConversationActivityFilter.ThisWeek)">This Week</button>
                                </div>
                                @if (!_conversationsGroupCollapsed)
                                {
                                    @if (normalConversations.Count == 0 && _activityFilter != ConversationActivityFilter.None)
                                    {
                                        <div class="conversation-list-empty" data-testid="conversation-filter-empty">No conversations in this range.</div>
                                    }
                                    @foreach (var conversation in normalConversations)
                                    {
                                        @RenderConversationItem(activeAgent, conversation)
                                    }
                                }
                            </div>

                            @if (cronConversations.Count > 0)
                            {
                                <div class="conversation-group conversation-group-scheduled" data-testid="conversation-group-scheduled">
                                    <button class="conversation-group-header conversation-group-header-toggle" data-testid="cron-group-toggle" @onclick="ToggleCronGroup">
                                        <span class="group-chevron @(!_cronGroupCollapsed ? "expanded" : "")">&#x25B6;</span>
                                        <span class="conversation-group-label">&#x23F0; Scheduled</span>
                                        <span class="conversation-group-count" data-testid="cron-group-count">@cronConversations.Count</span>
                                    </button>
                                    @if (!_cronGroupCollapsed)
                                    {
                                        @foreach (var conversation in cronConversations)
                                        {
                                            @RenderConversationItem(activeAgent, conversation)
                                        }
                                    }
                                </div>
                            }

                            @* #2122: Automated (webhook) runs are their own 4th section rather than
                               being folded in with Scheduled. Same pattern as the Scheduled group:
                               real <button> header, own localStorage key, collapsed by default. *@
                            @if (webhookConversations.Count > 0)
                            {
                                <div class="conversation-group conversation-group-automated" data-testid="conversation-group-automated">
                                    <button class="conversation-group-header conversation-group-header-toggle"
                                            data-testid="webhook-group-toggle"
                                            aria-expanded="@(!_webhookGroupCollapsed ? "true" : "false")"
                                            title="@(_webhookGroupCollapsed ? "Expand webhooks" : "Collapse webhooks")"
                                            @onclick="ToggleWebhookGroup">
                                        <span class="group-chevron @(!_webhookGroupCollapsed ? "expanded" : "")">&#x25B6;</span>
                                        <span class="conversation-group-label">&#x1F517; Webhooks</span>
                                        <span class="conversation-group-count" data-testid="webhook-group-count">@webhookConversations.Count</span>
                                    </button>
                                    @if (!_webhookGroupCollapsed)
                                    {
                                        @foreach (var conversation in webhookConversations)
                                        {
                                            @RenderConversationItem(activeAgent, conversation)
                                        }
                                    }
                                </div>
                            }
                        }

                        @* Sub-agent sessions *@
                        @foreach (var sub in activeAgent.SubAgents.Values
                            .Where(s => s.Status is "Running" or "Completed"))
                        {
                            <div class="agent-session-item @(IsSubAgentActive(sub) ? "active" : "")"
                                  @onclick="() => ViewSubAgentAsync(sub)"
                                  style="cursor: pointer;"
                                  title="@($"{sub.Task} (read-only)")">
                                <span>@SubAgentIcon(sub.Status)</span>
                                <span>@(sub.Name ?? sub.SubAgentId[..Math.Min(8, sub.SubAgentId.Length)])</span>
                                <span class="conversation-default-badge">Read-only</span>
                                @if (sub.Archetype is not null)
                                {
                                    <span class="sub-agent-archetype">@sub.Archetype</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }

        </div>@* end sidebar-scroll-region *@
    };

    // #3346: the Plugins page (#2687) shipped routed at /plugins but with no sidebar entry, so it
    // was reachable only by typing the URL. This is deliberately one more entry in the existing
    // list - it goes through the same NavAnchor helper (so it gets the route-derived nav-plugins
    // testid for free) and the same NavOrderKeys/NavOrderDefaults ordering model, with no
    // special-casing, so user order overrides apply to it exactly as to any other built-in.

    // The in-app guide. Goes through the same NavAnchor helper as every other entry, so it inherits
    // the route-derived testid, the active-state matching and any user ordering override.

    protected override void OnInitialized()
    {
        Store.OnChanged += HandleStateChanged;
        Nav.LocationChanged += OnLocationChanged;
        ToolsApi.Changed += HandleToolsChanged;

        // Optional, for the same reason it is resolved rather than injected: the sidebar must
        // render where the plugins client is absent.
        _pluginsApi = Services.GetService(typeof(PluginsApiClient)) as PluginsApiClient;
        if (_pluginsApi is not null)
            _pluginsApi.Changed += HandlePluginsChanged;
        PortalLoad.OnReadyChanged += HandleReadyChanged;
        // #2624: the terminal-close re-dial loop raises this so the indicator can show
        // "Reconnecting" during a gateway restart instead of a terminal "Disconnected".
        PortalLoad.OnConnectionStateChanged += HandleStateChanged;
        UpdateStatus.StatusChanged += HandleStateChanged;
        ExtensionFeatures.OnChanged += HandleStateChanged;
        Hub.OnAgentsChanged += HandleSidebarAgentsChanged;
        Prefs.OnChanged += HandleStateChanged;
        // rather than a panel @ref, so the layout must re-render on its changes itself. Without
        // this the menu renders whatever was loaded at first paint and silently goes stale - the
        // component ref it replaced got re-render coupling for free by being in the render tree.
    }

    // Tools and nav order load independently of the JS-driven first-render pipeline so the nav
    // populates deterministically as soon as the gateway responds (#2233, #2236). Never throws.
    protected override async Task OnInitializedAsync()
    {
        await EnsurePortalInitializedAsync();
        await LoadToolsAsync();
        await LoadNavOrderAsync();
    }

    /// <summary>
    /// Initialises the portal for every route, from the shell.
    /// </summary>
    /// <remarks>
    /// <para>
    /// This used to be the responsibility of individual pages, and only three of them accepted it:
    /// Landing, Home and Activity. Every other route - /skills, /agents, /tools, /cron, /plugins,
    /// /configuration - reached by direct navigation, a bookmark or a refresh therefore ran against
    /// a <c>GatewayRestClient</c> that had never been handed its base URL, because
    /// <c>Configure()</c> is called from inside <c>InitializeAsync</c>.
    /// </para>
    /// <para>
    /// The failure was silent and misattributed. Every REST call from those routes threw from
    /// <c>EnsureConfigured</c>, each page caught it and rendered its own generic message, and the
    /// Skills page reported "Unable to load skills directory" - blaming a folder that was perfectly
    /// healthy for a startup ordering problem. Initialising here removes the whole class rather than
    /// adding a fourth page to the list, which is how it grew to three.
    /// </para>
    /// <para>
    /// The existing per-page calls are left in place: they are guarded on IsReady/IsLoading and
    /// become no-ops, and removing them is a separate cleanup with no behavioural gain.
    /// </para>
    /// </remarks>
    private async Task EnsurePortalInitializedAsync()
    {
        if (PortalLoad.IsReady || PortalLoad.IsLoading)
            return;

        try
        {
            var hubUrl = new Uri(new Uri(Nav.BaseUri), "/hub/gateway").ToString();
            PortalLoad.ClientKind = "desktop";
            await PortalLoad.InitializeAsync(hubUrl);
        }
        catch (Exception ex)
        {
            // Matches the pages this replaces: a portal that cannot reach the gateway must still
            // render a shell the user can navigate, not a blank screen.
            Console.Error.WriteLine($"Portal initialization failed: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", SidebarKey);
            _sidebarOpen = stored == "true";
            var cronStored = await JS.InvokeAsync<string?>("localStorage.getItem", CronCollapsedKey);
            _cronGroupCollapsed = cronStored != "false";
            // Absent key -> collapsed, matching the Scheduled group's first-run behaviour.
            var webhookStored = await JS.InvokeAsync<string?>("localStorage.getItem", WebhookCollapsedKey);
            _webhookGroupCollapsed = webhookStored != "false";
            // Absent key -> expanded: these are the user's attended lists, so collapsing is opt-in.
            var pinnedStored = await JS.InvokeAsync<string?>("localStorage.getItem", PinnedCollapsedKey);
            _pinnedGroupCollapsed = pinnedStored == "true";
            var conversationsStored = await JS.InvokeAsync<string?>("localStorage.getItem", ConversationsCollapsedKey);
            _conversationsGroupCollapsed = conversationsStored == "true";

            await RegisterSwitcherShortcutAsync();
            await RegisterToolbarMeasurerAsync();
            var filterStored = await JS.InvokeAsync<string?>("localStorage.getItem", ActivityFilterKey);
            if (Enum.TryParse<ConversationActivityFilter>(filterStored, out var storedFilter))
                _activityFilter = storedFilter;
            _isMobile = await JS.InvokeAsync<bool>("chatScroll.isMobileView");
            await Prefs.LoadAsync();
            // Re-apply after load: the pre-paint script in index.html already set the attribute
            // from the same stored value, but that script is the only thing that ran before this
            // point, and re-applying keeps a single owner of the DOM state once Blazor is live.
            await JS.InvokeVoidAsync("portalPrefs.applyTheme", PortalTheme.Normalize(Prefs.Current.Theme));

            // Sidebar resize. min 180px keeps the conversation titles readable rather than letting
            // the pane be dragged to a useless sliver; max 40% stops it swallowing the canvas.
            // Width persists in its own localStorage key, independent of the open/closed toggle,
            // so collapsing and reopening restores the width the user chose.
            try
            {
                await JS.InvokeVoidAsync("BotNexus.splitter.init", "app-body", "bn-sidebar-width", 240, 180, 0.4);
            }
            catch
            {
                // A splitter that fails to initialise leaves a fixed-width sidebar, which is what
                // the portal had before. Never worth failing first render over.
            }
            // Re-render immediately after mobile detection so layout responds without waiting for gateway load.
            StateHasChanged();

            // Load gateway info once portal is ready
            if (PortalLoad.IsReady)
                await LoadGatewayInfoAsync();

            if (Store.ActiveAgentId is { Length: > 0 } activeAgentId)
                await Interaction.RefreshConversationsAsync(activeAgentId);

            await LoadSidebarAgentsAsync();
            await LoadCronConversationIdsAsync();
            StateHasChanged();
        }
    }

    private bool _gatewayInfoLoaded;
    private bool _showUpdateConfirm;
    private bool _updatePollingStarted;

    private void HandleReadyChanged()
    {
        if (PortalLoad.IsReady && !_gatewayInfoLoaded)
        {
            _ = InvokeAsync(async () =>
            {
                await LoadGatewayInfoAsync();
                StateHasChanged();
            });
        }

        if (PortalLoad.IsReady && !_updatePollingStarted)
        {
            _updatePollingStarted = true;
            _ = Task.Run(async () =>
            {
                await UpdateStatus.CheckNowAsync();
                // Poll every 5 minutes
                while (true)
                {
                    await Task.Delay(TimeSpan.FromMinutes(5));
                    await UpdateStatus.CheckNowAsync();
                }
            });
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadGatewayInfoAsync()
    {
        _gatewayInfoLoaded = true;
        await GatewayInfo.LoadAsync();
        await ExtensionFeatures.LoadAsync();
    }

    private void HandleStateChanged() => InvokeAsync(() =>
    {
        ResolvePendingSelection();
        StateHasChanged();
    });

    // #2246: inbound events never mutate the active view themselves. When one invalidates the current
    // selection (active agent removed, or its active conversation 404'd) the store raises
    // PendingSelectionInvalid; the UI is the single place that resolves a replacement, re-establishing
    // the one-writer contract by routing the fallback through SelectView as a route-navigation switch.
    private void ResolvePendingSelection()
    {
        if (!Store.PendingSelectionInvalid)
            return;

        if (Store.Agents.Keys.FirstOrDefault() is { } fallback)
            Store.SelectView(fallback, string.Empty, SelectionSource.RouteNavigation);
    }

    private async Task ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
        await JS.InvokeVoidAsync("localStorage.setItem", SidebarKey, _sidebarOpen ? "true" : "false");
    }

    private void CloseSidebar()
    {
        if (_isMobile)
            _sidebarOpen = false;
    }


    /// <summary>
    /// Whether this route is one where a list of conversations is part of the task.
    /// </summary>
    /// <remarks>
    /// The sidebar is the conversation list and nothing else since navigation moved to the toolbar,
    /// yet it was rendered on every route - 240px of chat furniture on Activity, Agents,
    /// Configuration, Skills and Plugins, which is a quarter of the window on a table that is
    /// already horizontally dense.
    /// <para>
    /// An ALLOW-list, not a deny-list. A deny-list silently regains the old behaviour every time
    /// someone adds a page: the default should be "this page does not get chat furniture", and a
    /// page that genuinely wants the conversation list can say so here.
    /// </para>
    /// </remarks>
    private bool ShowsConversations => IsConversationRoute(Nav.ToBaseRelativePath(Nav.Uri));

    /// <summary>Pure route test, so it can be exercised without a NavigationManager.</summary>
    /// <param name="relativePath">The base-relative path, with or without a trailing slash.</param>
    /// <returns>True when the conversation sidebar belongs on this route.</returns>
    internal static bool IsConversationRoute(string? relativePath)
    {
        var path = (relativePath ?? string.Empty).TrimEnd('/');

        // The query string is not part of the route decision: /activity?agent=x is still Activity.
        var queryStart = path.IndexOf('?', StringComparison.Ordinal);
        if (queryStart >= 0)
            path = path[..queryStart];

        // Root is the landing page, where picking up a conversation IS the task.
        if (path.Length == 0)
            return true;

        return path.Equals("chat", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("chat/", StringComparison.OrdinalIgnoreCase)
            || path.Equals("agent", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("agent/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var relative = Nav.ToBaseRelativePath(e.Location).TrimEnd('/');
        if (relative == "" || relative.Equals("chat", StringComparison.OrdinalIgnoreCase))
        {
            _ = InvokeAsync(async () =>
            {
                await Interaction.RefreshAgentsAsync();
                StateHasChanged();
            });

            return;
        }

        // Every OTHER navigation still needs a render: whether the sidebar belongs on the page is
        // now a function of the route, and without this it would keep whatever shape the previous
        // page left it in.
        _ = InvokeAsync(StateHasChanged);
    }

    private string NavClass(string page)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');

        // #2535: Home owns the root route. A plain equality against the page key would never match
        // because the root relative path is the empty string, not "home"; and a prefix match on ""
        // would mark every route active. So match the empty root path and the explicit /home alias
        // ONLY.
        if (string.Equals(page, "home", StringComparison.OrdinalIgnoreCase))
        {
            return uri.Length == 0 || uri.Equals("home", StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }

        // #2037: the Home page now owns the root landing route, so Activity is highlighted only on
        // its own /activity route (it used to also claim "" when it was the root page).
        if (string.Equals(page, "activity", StringComparison.OrdinalIgnoreCase))
        {
            return uri.Equals("activity", StringComparison.OrdinalIgnoreCase) ? "active" : "";
        }

        // The Chat section covers the legacy /chat[/...] routes and the canonical route-owned
        // /agent/{agent}/conversation/{conversation} shape (#2247).
        if (string.Equals(page, "chat", StringComparison.OrdinalIgnoreCase))
        {
            return uri.Equals("chat", StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith("chat/", StringComparison.OrdinalIgnoreCase) ||
                uri.StartsWith("agent/", StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";
        }

        return string.Equals(uri, page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private bool IsOnPage(string page)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return uri.Equals(page, StringComparison.OrdinalIgnoreCase)
            || uri.StartsWith(page + "/", StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnAgentSelected(ChangeEventArgs e)
    {
        var agentId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(agentId))
        {
            await Interaction.RefreshConversationsAsync(agentId);
            Store.SelectView(agentId, string.Empty, SelectionSource.UserClick);
            if (Store.GetAgent(agentId) is { } agent)
            {
                if (agent.UnreadCount > 0)
                    agent.UnreadCount = 0;

                // SeedConversations auto-selects a default conversation, but its
                // history is only loaded for the very first agent during portal init.
                // Trigger history loading now so the user sees messages immediately.
                if (agent.ActiveConversationId is not null)
                    await Interaction.SelectConversationAsync(agentId, agent.ActiveConversationId);
            }

            NavigateToChat(agentId, Store.GetAgent(agentId)?.ActiveConversationId);
            Store.NotifyChanged();

            if (_isMobile)
                _sidebarOpen = false;
        }
    }

