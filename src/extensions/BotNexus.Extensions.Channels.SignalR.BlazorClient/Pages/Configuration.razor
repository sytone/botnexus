@page "/configuration"
@page "/configuration/{Section}"
@inject PlatformConfigService ConfigService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>BotNexus - Configuration</PageTitle>

<div class="platform-config-page">
    <header class="platform-config-toolbar">
        <h2>Platform Configuration</h2>
        <a class="help-link" href="guide/configuration" title="Configuration reference" aria-label="Configuration reference" data-testid="help-link-configuration">?</a>
        <div class="platform-config-actions">
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <span class="platform-config-status @_statusClass">@_statusMessage</span>
            }
            <button class="toolbar-btn" @onclick="Validate" disabled="@_loading">Validate</button>
            <button class="toolbar-btn" @onclick="LoadConfig" disabled="@_loading">Reload</button>
            <button class="toolbar-btn primary" @onclick="SaveAll" disabled="@(!_dirty || _saving)">
                @(_saving ? "Saving..." : "Save Changes")
            </button>
        </div>
    </header>

    @if (_loading)
    {
        <div class="config-loading">
            <div class="loading-spinner small"></div>
            <span>Loading configuration...</span>
        </div>
    }
    else if (_config is null || _schema is null)
    {
        <div class="empty-state">Failed to load configuration.</div>
    }
    else
    {
        <div class="config-page config-page-sectioned">
            @* Left sidebar of top-level config sections (#1892). Selecting a section deep-links to
               /configuration/{section} and feeds only that subtree to SchemaForm, replacing the old
               single massive scroll. Sections come from the root schema properties (label from
               x-ui-label, ordered by x-ui-order) minus non-editable metadata/agents. *@
            <nav class="config-sidebar" aria-label="Configuration sections">
                @foreach (var (key, label) in Sections)
                {
                    <button type="button"
                            class="config-sidebar-item @(string.Equals(key, ActiveSection, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                            data-section="@key"
                            @onclick="() => SelectSection(key)">
                        @label
                    </button>
                }
            </nav>
            <div class="config-panel-canvas">
                @if (string.Equals(ActiveSection, ExtensionRepositoriesSectionKey, StringComparison.OrdinalIgnoreCase))
                {
                    <ExtensionRepositoriesSection />
                }
                else if (string.Equals(ActiveSection, SecretsSectionKey, StringComparison.OrdinalIgnoreCase))
                {
                    <section class="secrets-config-section" data-testid="secrets-config-section">
                        <header>
                            <h3>Secrets</h3>
                            <p class="text-muted">Values are write-only. Overwriting a key requires its complete new value.</p>
                        </header>

                        @if (!string.IsNullOrWhiteSpace(_secretsError))
                        {
                            <div class="validation-item error" role="alert" data-testid="secrets-error">@_secretsError</div>
                        }

                        <div class="secrets-add-form">
                            <label for="secret-key">Key</label>
                            <input id="secret-key" data-testid="secret-key" autocomplete="off" @bind="_secretKey" />
                            <label for="secret-value">Complete value</label>
                            <input id="secret-value" data-testid="secret-value" type="password" autocomplete="new-password" @bind="_secretValue" />
                            <button type="button"
                                    class="toolbar-btn primary"
                                    data-testid="secret-save"
                                    disabled="@(_secretMutationPending || string.IsNullOrWhiteSpace(_secretKey))"
                                    @onclick="SaveSecret">
                                @(_secretMutationPending ? "Saving..." : "Add or overwrite")
                            </button>
                        </div>

                        @if (_secretsLoading)
                        {
                            <div class="config-loading"><span>Loading secrets...</span></div>
                        }
                        else if (_secrets is { Count: 0 })
                        {
                            <div class="empty-state">No file-backed secrets are configured.</div>
                        }
                        else if (_secrets is not null)
                        {
                            <table class="secrets-table">
                                <thead>
                                    <tr><th>Key</th><th>Created</th><th>Modified</th><th>Size</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var secret in _secrets)
                                    {
                                        <tr>
                                            <td>@secret.Key</td>
                                            <td>@secret.CreatedUtc.ToLocalTime().ToString("g")</td>
                                            <td>@secret.ModifiedUtc.ToLocalTime().ToString("g")</td>
                                            <td>@secret.SizeBytes bytes</td>
                                            <td>
                                                <button type="button"
                                                        class="toolbar-btn"
                                                        aria-label="Delete @secret.Key"
                                                        disabled="@_secretMutationPending"
                                                        @onclick="() => DeleteSecret(secret.Key)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>
                }
                else
                {
                    @* The selected schema section is rendered by the generic SchemaForm. Secrets
                       intentionally bypass it so they can never enter the config save payload. *@
                    <SchemaForm Schema="_schema" Value="_config" SectionKey="@ActiveSection" ValueChanged="OnConfigChanged" PathChanged="OnPathChanged" />
                }
            </div>
        </div>
    }

    @if (_validationResult is not null)
    {
        <div class="validation-overlay" @onclick="@(() => _validationResult = null)">
            <div class="validation-dialog" @onclick:stopPropagation="true">
                <h3>@(_validationResult.IsValid ? "Configuration Valid" : "Validation Errors")</h3>
                @if (_validationResult.ConfigPath is not null)
                {
                    <p class="text-muted">Path: @_validationResult.ConfigPath</p>
                }
                @if (_validationResult.Errors.Count > 0)
                {
                    <div class="validation-list errors">
                        @foreach (var err in _validationResult.Errors)
                        {
                            <div class="validation-item error">@err</div>
                        }
                    </div>
                }
                @if (_validationResult.Warnings.Count > 0)
                {
                    <div class="validation-list warnings">
                        @foreach (var warn in _validationResult.Warnings)
                        {
                            <div class="validation-item warning">@warn</div>
                        }
                    </div>
                }
                @if (_validationResult.IsValid && _validationResult.Warnings.Count == 0)
                {
                    <p>No errors or warnings found.</p>
                }
                <div class="validation-actions">
                    <button class="toolbar-btn" @onclick="@(() => _validationResult = null)">Close</button>
                </div>
            </div>
        </div>
    }
</div>
