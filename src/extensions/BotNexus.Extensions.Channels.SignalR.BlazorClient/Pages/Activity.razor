@page "/activity"
@page "/activity/{Section}"
@inject IPortalLoadService PortalLoad
@inject NavigationManager Nav

<PageTitle>Activity - BotNexus</PageTitle>

@if (!PortalLoad.IsReady)
{
    <div class="portal-loading">
        @if (PortalLoad.LoadError is not null)
        {
            <div class="portal-load-error">&#x26A0; @PortalLoad.LoadError</div>
        }
        else
        {
            <div class="portal-load-spinner">Connecting&#x2026;</div>
        }
    </div>
}
else
{
    @* Sub-navigation shell (#2897). Hrefs are derived from each section's KEY, never from its
       display index, so reordering the registry never rewrites a bookmarked URL. Subsection
       CONTENT is deliberately out of scope here: the parameterless /activity route still renders
       exactly the dashboard it rendered before this change. *@
    <nav class="activity-subnav" data-testid="activity-subnav" aria-label="Activity sections">
        @foreach (var entry in KnownSections)
        {
            <a class="activity-subnav-item @(string.Equals(entry.Key, ActiveSection, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               data-testid="activity-subnav-item"
               data-section="@entry.Key"
               href="@SectionHref(entry.Key)">@entry.Label</a>
        }
    </nav>

    @if (UnknownSectionMessage is not null)
    {
        @* Non-fatal: an unknown or removed section name falls back to the default view rather than
           an error page or a blank panel (#2897 AC2). *@
        <div class="activity-subnav-notice" data-testid="activity-subnav-unknown" role="status">@UnknownSectionMessage</div>
    }

    @if (string.Equals(ActiveSection, "costs", StringComparison.OrdinalIgnoreCase))
    {
        @* #2898: the first real Activity subsection. The overview dashboard is deliberately NOT
           rendered alongside it - a subsection replaces the default view rather than appending to
           it, which is what makes /activity/costs a destination rather than a scroll target. *@
        <ActivityCostView />
    }
    else
    {
        <ActivityDashboard />
    }
}
