@page "/skills"
@page "/skills/{Section}"

<PageTitle>BotNexus &mdash; Skills</PageTitle>

<div class="page-app">
    <header class="platform-config-toolbar">
        <h1 class="page-heading"><Icon Name="skills" Size="@IconSize.Large" /><span>Skills</span></h1>
        <a class="help-link" href="guide/skills" title="About skills" aria-label="About skills" data-testid="help-link-skills">?</a>
    </header>

    <div class="config-page">
        <div class="config-panel-canvas skills-panel-canvas">
            @switch (Section?.ToLowerInvariant() ?? "explorer")
            {
                case "explorer":
                    <SkillsExplorerPanel />
                    break;
                default:
                    <SkillsExplorerPanel />
                    break;
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Section { get; set; }
}
