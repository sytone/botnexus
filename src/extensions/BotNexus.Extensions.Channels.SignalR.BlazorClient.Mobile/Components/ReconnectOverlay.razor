@using BotNexus.Extensions.Channels.SignalR.BlazorClient.Mobile.Services
@using BotNexus.Extensions.Channels.SignalR.BlazorClient.Services
@implements IDisposable
@inject IPortalLoadService PortalLoad

@* #1839: the auto-retrying reconnect overlay is the user-facing experience for a transient
   background/foreground drop on the mobile client -- it replaces the raw #blazor-error-ui banner.
   It only appears once a connection that was previously live has dropped (not during the initial
   connect handshake), shows a friendly "Reconnecting..." state, auto-retries on an exponential
   backoff (MobileReconnectBackoff), and dismisses automatically the moment the hub is live again.
   The retry path delegates to PortalLoad.ResumeAsync so it inherits PBI1's (#1838) liveness probe
   + rebuild rather than trusting a possibly-zombie iOS socket. errorReporting.js diagnostics stay
   intact; this only changes the *user-visible* surface, not the genuine-failure reporting. *@
@if (_visible)
{
    <div class="reconnect-overlay" data-testid="reconnect-overlay" role="alertdialog" aria-live="polite" aria-label="Reconnecting to BotNexus">
        <div class="reconnect-overlay-card">
            <div class="reconnect-overlay-spinner" aria-hidden="true"></div>
            <div class="reconnect-overlay-title">Reconnecting&#x2026;</div>
            <div class="reconnect-overlay-detail">
                Lost connection to BotNexus. We&#x2019;ll keep trying automatically.
            </div>
            <button class="reconnect-overlay-btn"
                    data-testid="reconnect-retry-btn"
                    @onclick="RetryNowAsync"
                    disabled="@_retrying">
                @(_retrying ? "Retrying\u2026" : "Retry now")
            </button>
        </div>
    </div>
}

@code {
    // #2625: the retry cadence lives in MobileReconnectLoop, not in this component. Two things
    // changed. First, the loop keeps retrying until PortalLoad.IsSignalRConnected is genuinely true
    // -- the old code treated "ResumeAsync did not throw" as progress and relied on a re-entrant
    // timer chain that a swallowed exception could silently break. Second, the attempt counter is
    // never reset mid-outage, including on a "Retry now" tap, so the 30s ceiling cannot be held
    // inert at the base interval by repeated taps (#2564 shape).
    private bool _visible;
    private bool _retrying;
    // Only surface the overlay for a *re*connect: a connection must have been live at least once
    // before a drop is treated as reconnectable. This prevents flashing the overlay during the
    // initial connect handshake, which is "connecting", not "reconnecting".
    private bool _everConnected;
    private MobileReconnectLoop? _loop;

    /// <summary>
    /// Delay seam forwarded to the retry loop. Tests set it before first render so they can assert
    /// the requested backoff durations without sleeping; null uses the real clock.
    /// </summary>
    [Parameter]
    public Func<TimeSpan, CancellationToken, Task>? DelayOverride { get; set; }

    /// <summary>Exposed for tests to assert schedule and attempt-counter behaviour.</summary>
    public MobileReconnectLoop Loop => _loop!;

    protected override void OnInitialized()
    {
        _loop = new MobileReconnectLoop(
            resumeAsync: ResumeOnceAsync,
            isConnected: () => PortalLoad.IsSignalRConnected,
            delayAsync: DelayOverride);
        _loop.OnRetryStateChanged += HandleConnectionStateChanged;

        PortalLoad.OnConnectionStateChanged += HandleConnectionStateChanged;
        SyncState();
    }

    private void HandleConnectionStateChanged() =>
        _ = InvokeAsync(() =>
        {
            SyncState();
            StateHasChanged();
        });

    // Reconcile visibility + the auto-retry loop with the current connection state.
    private void SyncState()
    {
        if (PortalLoad.IsSignalRConnected)
        {
            _everConnected = true;
            if (_visible)
            {
                // Live again -- self-dismiss and stop the loop, which resets the backoff for any
                // future drop.
                _visible = false;
                _ = _loop!.StopAsync();
            }
            return;
        }

        // Disconnected. Only show the reconnect overlay if we had an established connection that
        // dropped; the very first connect is handled by the page's own loading state.
        if (_everConnected && !_visible)
        {
            _visible = true;
            _loop!.Start();
        }
    }

    /// <summary>
    /// One auto-retry tick, retained so the existing component-level tests keep exercising the same
    /// entry point. Delegates to the loop's manual-retry path, which performs a resume and reports
    /// whether the connection was genuinely restored.
    /// </summary>
    public async Task RetryTickAsync()
    {
        if (PortalLoad.IsSignalRConnected)
        {
            SyncState();
            return;
        }

        await _loop!.RetryNowAsync();
    }

    // Manual "Retry now" tap: same liveness-verified path, out of band with the backoff. It does
    // NOT reset the attempt counter -- see MobileReconnectLoop.RetryNowAsync.
    private async Task RetryNowAsync() => await _loop!.RetryNowAsync();

    private async Task ResumeOnceAsync(CancellationToken cancellationToken)
    {
        _retrying = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            // #1838: probe-then-rebuild; never a bare RefreshAsync that trusts a zombie socket.
            // Exceptions propagate to the loop, which treats them as a failed attempt and backs off
            // rather than ending recovery.
            await PortalLoad.ResumeAsync(cancellationToken);
        }
        finally
        {
            _retrying = false;
            await InvokeAsync(() =>
            {
                SyncState();
                StateHasChanged();
            });
        }
    }

    public void Dispose()
    {
        PortalLoad.OnConnectionStateChanged -= HandleConnectionStateChanged;
        if (_loop is not null)
        {
            _loop.OnRetryStateChanged -= HandleConnectionStateChanged;
            _ = _loop.DisposeAsync();
        }
    }
}
