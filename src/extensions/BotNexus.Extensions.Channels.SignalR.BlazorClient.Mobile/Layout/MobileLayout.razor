@using BotNexus.Extensions.Channels.SignalR.BlazorClient.Mobile.Components
@inherits LayoutComponentBase
@inject IPortalPreferencesService Preferences
@implements IDisposable

<div data-density="@Density">
    <GlobalErrorBoundary>
        @Body
    </GlobalErrorBoundary>
    @* #1839: friendly auto-retrying reconnect overlay, rendered app-wide so a transient
       background/foreground drop shows "Reconnecting..." instead of the raw #blazor-error-ui bar. *@
    <ReconnectOverlay />
</div>

@code {
    private string Density => PortalDensity.Normalize(Preferences.Current.Density);

    protected override async Task OnInitializedAsync()
    {
        Preferences.OnChanged += HandlePreferencesChanged;
        await Preferences.LoadAsync();
    }

    private void HandlePreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Preferences.OnChanged -= HandlePreferencesChanged;
}
