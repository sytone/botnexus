@page "/settings"
@inject PlatformConfigService ConfigService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>BotNexus - Settings</PageTitle>

@*
    Mobile platform-settings page (config-parity PBI 6/6 of #1579, issue #1615 -- the payoff PBI).
    Editable platform settings use the SAME shared SchemaForm as desktop Configuration, fed by
    GET /api/config/schema and filtered with desktop's non-persisted section set. Agent management
    stays outside this form. Saves use revision-checked PATCH /api/config with only edited paths.
*@
<div class="mobile-settings-page">
    <div class="settings-top-bar">
        <button class="settings-back-btn" @onclick="GoBack" aria-label="Back to chat" data-testid="settings-back-btn"><Icon Name="back" Size="14" Class="bn-icon-inherit" /></button>
        <h2 class="settings-title">Settings</h2>
        <div class="settings-actions">
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <span class="settings-status @_statusClass">@_statusMessage</span>
            }
            <button class="toolbar-btn" @onclick="LoadConfig" disabled="@_loading" data-testid="settings-reload-btn">Reload</button>
            <button class="toolbar-btn primary" @onclick="SaveAll" disabled="@(!_dirty || _saving)" data-testid="settings-save-btn">
                @(_saving ? "Saving..." : "Save")
            </button>
        </div>
    </div>

    <div class="settings-body">
        <p data-testid="settings-agent-notice">
            Agent settings and defaults are not edited here.
            <a href="/agents" data-enhance-nav="false">Open agent management in the desktop portal</a>.
        </p>
        @if (_loading)
        {
            <div class="settings-loading" data-testid="settings-loading">
                <span>Loading configuration&#x2026;</span>
            </div>
        }
        else if (_config is null || _schema is null)
        {
            <div class="settings-empty" data-testid="settings-load-error">Failed to load configuration.</div>
        }
        else
        {
            @* Generic schema-driven renderer shared with desktop -- no mobile-specific field code. *@
            <SchemaForm Schema="_schema" Value="_config" ValueChanged="OnConfigChanged" PathChanged="OnPathChanged" />
        }
    </div>
</div>
