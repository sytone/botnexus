<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>BotNexus.Extensions.Channels.Matrix</RootNamespace>
    <!--
      Extension assemblies load into an isolated AssemblyLoadContext, so their managed NuGet
      dependency closure must ship in the extension output directory. Library projects do not copy
      transitive managed dependencies by default, so the ALC cannot resolve Microsoft.Data.Sqlite
      (pulled in for the #3595 since-token store) and fails with FileNotFoundException at load time.
      Same class of defect as the ServiceBus adapter (#2001) and the Skills extension (#2184).
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BotNexus.Extensions.Channels.Matrix.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="botnexus-extension.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Contracts\BotNexus.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Channels\BotNexus.Gateway.Channels.csproj" />
    <!--
      #3595: the since-token store must live under the VERIFIED BotNexus home, not a home path this
      extension derives for itself. BotNexusHome is the single canonical resolver (#2836 AC4), so the
      reference exists to consume it rather than to re-implement it.
    -->
    <ProjectReference Include="..\..\gateway\BotNexus.Gateway.Configuration\BotNexus.Gateway.Configuration.csproj" />
    <ProjectReference Include="..\..\persistence\BotNexus.Persistence.Sqlite\BotNexus.Persistence.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
