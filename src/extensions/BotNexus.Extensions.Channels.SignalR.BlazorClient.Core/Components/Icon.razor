@*
    One inline SVG from the generated icon set (assets/icons/svg -> IconLibrary.g.cs).

    The whole element is emitted as a single MarkupString rather than an <svg> root with a
    MarkupString body: raw markup inserted *inside* an existing SVG parent is parsed in the
    HTML namespace and renders as nothing. Starting from <svg> lets the parser switch
    namespaces the way it does for any inline SVG in a document.

    Colour is not set here. Each icon carries a bn-icon-<name> class whose tone lives in a
    generated CSS rule, so a hover, disabled or selected state can override it normally.
*@
@if (_markup is not null)
{
    @((MarkupString)_markup)
}

@code {
    /// <summary>Icon name as it appears in assets/icons/svg, e.g. "home". Case-insensitive.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = default!;

    /// <summary>Edge length in px. The set is drawn on a 24px grid for 16/20/24/32.</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>Extra classes, e.g. "bn-icon-flat" to drop a gradient for a flat tone.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Accessible name. Leave null when the icon sits beside its own label -- the default is
    /// aria-hidden, so a decorative icon is not announced twice.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    private string? _markup;

    // The generator makes each icon's gradient id unique across the SET, which is what stops
    // two different icons resolving against each other. It cannot help when the SAME icon
    // renders more than once - three canvas icons on one screen meant three elements carrying
    // id="bn-canvas-g". That renders correctly, since the definitions are identical, but
    // duplicate ids are invalid and trip validators and accessibility tooling. A per-instance
    // suffix makes the document-level guarantee as strong as the set-level one.
    private static int s_instances;
    private readonly int _instance = Interlocked.Increment(ref s_instances);

    protected override void OnParametersSet() => _markup = Build();

    private string? Build()
    {
        if (string.IsNullOrWhiteSpace(Name) || !IconLibrary.Icons.TryGetValue(Name, out var def))
            return null;

        var slug = Name.Trim().ToLowerInvariant();

        // Only gradient icons declare an id at all, so this is a no-op for most of the set.
        var body = def.Body;
        var stroke = def.Stroke;
        if (body.Contains("id=\"bn-", StringComparison.Ordinal))
        {
            var suffix = "-i" + _instance.ToString(System.Globalization.CultureInfo.InvariantCulture);
            body = body.Replace($"id=\"bn-{slug}-g\"", $"id=\"bn-{slug}-g{suffix}\"", StringComparison.Ordinal)
                       .Replace($"url(#bn-{slug}-g)", $"url(#bn-{slug}-g{suffix})", StringComparison.Ordinal);
            stroke = stroke.Replace($"url(#bn-{slug}-g)", $"url(#bn-{slug}-g{suffix})", StringComparison.Ordinal);
        }
        var css = string.IsNullOrWhiteSpace(Class) ? "" : " " + Encode(Class);
        var labelling = string.IsNullOrWhiteSpace(Title)
            ? """aria-hidden="true" focusable="false" """
            : $"""role="img" aria-label="{Encode(Title)}" """;

        return $"""
            <svg class="bn-icon bn-icon-{Encode(slug)}{css}" width="{Size}" height="{Size}"
                 viewBox="0 0 24 24" fill="none" stroke="{stroke}" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" {labelling}>{body}</svg>
            """;
    }

    private static string Encode(string value) => System.Net.WebUtility.HtmlEncode(value);
}
