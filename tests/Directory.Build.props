<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!-- BOTNEXUS_HOME isolation is configured in Directory.Build.targets, which is imported late
         enough that BaseIntermediateOutputPath exists. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)NullableBoolShouldlyExtensions.cs" Link="NullableBoolShouldlyExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)BotNexus.Testing/TestAwait.cs" Link="Shared/TestAwait.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)BotNexus.Testing/ManualTimeProvider.cs" Link="Shared/ManualTimeProvider.cs" />
    <Using Include="BotNexus.Testing" />
  </ItemGroup>
</Project>
