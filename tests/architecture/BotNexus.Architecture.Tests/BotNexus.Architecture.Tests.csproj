<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="NetArchTest.Rules" />
    <!-- #2616: the agent-execution fence enumerates call sites from IL, not from file names. -->
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="Vogen" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- #3099: the primitive-ID parameter fence reads its shrink-only baseline from the output dir. -->
    <None Include="PrimitiveIdParameterBaseline.baseline" CopyToOutputDirectory="PreserveNewest" />
    <!-- The #2888 config-path resolution fence reads its baseline at runtime from the output dir. -->
    <None Include="ConfigPathResolutionBaseline.baseline" CopyToOutputDirectory="PreserveNewest" />
    <!-- Finite waits are frozen so new timing-based synchronization cannot enter the test suite. -->
    <None Include="TestDelayFlakeBaseline.baseline" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway\BotNexus.Gateway.csproj" />
    <!-- #2616: controllers and triggers are execution call sites, so their assembly must be scanned. -->
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Api\BotNexus.Gateway.Api.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Contracts\BotNexus.Gateway.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Abstractions\BotNexus.Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Channels\BotNexus.Gateway.Channels.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Sessions\BotNexus.Gateway.Sessions.csproj" />
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Conversations\BotNexus.Gateway.Conversations.csproj" />
    <!--
      #2685: the plugin agent privilege fence is a structural property of
      PluginAgentDescriptorFence's classification of AgentDescriptor's member set, so the fence
      test must read that classification off the real type. Reflecting it out of a loose DLL in
      the output directory would go vacuously green the day the file moved.
    -->
    <ProjectReference Include="..\..\..\src\extensions\BotNexus.Extensions.Plugins\BotNexus.Extensions.Plugins.csproj" />
    <ProjectReference Include="..\..\scenarios\BotNexus.Scenarios.Harness\BotNexus.Scenarios.Harness.csproj" />
    <ProjectReference Include="..\..\scenarios\BotNexus.Scenarios.Tests\BotNexus.Scenarios.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\BotNexus.Testing\SqlitePoolCleanup.cs" Link="Shared\SqlitePoolCleanup.cs" />
    <Using Include="BotNexus.Testing" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>