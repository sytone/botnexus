<Project>
  <!--
    When SkipTests=true, strip all build inputs so test projects produce
    empty assemblies almost instantly.
    Usage: dotnet build dirs.proj /p:SkipTests=true
  -->
  <PropertyGroup Condition="'$(SkipTests)' == 'true'">
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>Library</OutputType>
    <!-- Suppress 'no source files' warning from empty test assemblies -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(SkipTests)' == 'true'">
    <Compile Remove="@(Compile)" />
    <Content Remove="@(Content)" />
    <EmbeddedResource Remove="@(EmbeddedResource)" />
    <None Remove="@(None)" />
    <RazorComponent Remove="@(RazorComponent)" />
    <PackageReference Remove="@(PackageReference)" />
    <ProjectReference Remove="@(ProjectReference)" />
    <Using Remove="@(Using)" />
  </ItemGroup>

  <!-- Every test project runs with BOTNEXUS_HOME pointed away from the real user directory.

       This used to be a checked-in test.runsettings holding the literal
       "%TEMP%\botnexus-test-isolated". .runsettings values are not expanded, and neither %TEMP%
       nor the backslash means anything on Linux or macOS, so instead of an isolated home those
       platforms got a directory of that exact name created inside the test's own bin/. It
       survived across runs while the world id moved on, and the world-identity guard then
       refused to open the stale store - turning every integration test in the project red with
       a 500 naming a path nobody had ever intended to exist.

       Generated per project instead, with the temp path resolved by MSBuild. Per project rather
       than shared, because the suite runs projects concurrently and one shared home would have
       them clearing each other's state out from under one another.

       This lives in .targets rather than .props because BaseIntermediateOutputPath is not
       defined yet when Directory.Build.props is imported - putting it there wrote the generated
       file into the project root instead of obj/. -->
  <PropertyGroup>
    <BotNexusTestHome>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'botnexus-test-isolated', '$(MSBuildProjectName)'))</BotNexusTestHome>
    <GeneratedRunSettingsPath>$(BaseIntermediateOutputPath)botnexus.runsettings</GeneratedRunSettingsPath>
    <RunSettingsFilePath>$(GeneratedRunSettingsPath)</RunSettingsFilePath>
  </PropertyGroup>

  <Target Name="GenerateBotNexusRunSettings" BeforeTargets="Build;VSTest">
    <!-- Keep every line free of semicolons: MSBuild splits an Include on them, which silently
         turned one comment line into two and produced malformed XML. No XML declaration is
         emitted - MSBuild drops an item whose Include opens with <?, and VSTest does not
         need one. -->
    <ItemGroup>
      <BotNexusRunSettingsLine Include="&lt;!-- Generated by tests/Directory.Build.targets - do not edit and do not check in --&gt;" />
      <BotNexusRunSettingsLine Include="&lt;RunSettings&gt;&lt;RunConfiguration&gt;&lt;EnvironmentVariables&gt;" />
      <BotNexusRunSettingsLine Include="&lt;BOTNEXUS_HOME&gt;$(BotNexusTestHome)&lt;/BOTNEXUS_HOME&gt;" />
      <BotNexusRunSettingsLine Include="&lt;BOTNEXUS_COMMIT_SHA&gt;aaaa0000aaaa0000aaaa0000aaaa0000aaaa0000&lt;/BOTNEXUS_COMMIT_SHA&gt;" />
      <BotNexusRunSettingsLine Include="&lt;/EnvironmentVariables&gt;&lt;/RunConfiguration&gt;&lt;/RunSettings&gt;" />
    </ItemGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(GeneratedRunSettingsPath)"
                      Lines="@(BotNexusRunSettingsLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- A run starts from an empty home. The stale-state failure above was only possible because
       the previous run's stores were still lying there. -->
  <Target Name="ClearBotNexusTestHome" BeforeTargets="VSTest">
    <RemoveDir Directories="$(BotNexusTestHome)" ContinueOnError="true" />
  </Target>
</Project>
