<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Vogen is pinned PrivateAssets="all" in BotNexus.Domain so the generator cannot leak into
         the Blazor WASM payload (#2329). This project asserts on Vogen types directly, so it
         declares its own reference rather than relying on transitive flow. -->
    <PackageReference Include="Vogen" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\gateway\BotNexus.Gateway.Webhooks\BotNexus.Gateway.Webhooks.csproj" />
    <ProjectReference Include="..\..\..\src\domain\BotNexus.Domain\BotNexus.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\BotNexus.Testing\SqlitePoolCleanup.cs" Link="Shared\SqlitePoolCleanup.cs" />
    <Using Include="BotNexus.Testing" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>